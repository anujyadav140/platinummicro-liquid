{%- comment -%}
  PM — Blog post card. Used by the blog index grid and the article "Related" rail.
  Params: article (required)
  The post's FIRST tag renders as the category eyebrow (admin-controlled via tags).
{%- endcomment -%}
{%- assign _ex = article.excerpt_or_content | strip_html | strip -%}
<article class="pm-blog-card">
  <a href="{{ article.url }}" class="pm-blog-card__media" aria-label="{{ article.title | escape }}">
    {%- if article.image -%}
      <img
        src="{{ article.image | image_url: width: 640 }}"
        srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 640 }} 640w, {{ article.image | image_url: width: 960 }} 960w"
        sizes="(min-width: 900px) 380px, 100vw"
        alt="{{ article.image.alt | default: article.title | escape }}"
        loading="lazy" width="640" height="360">
    {%- else -%}
      <span class="pm-blog-card__ph" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
      </span>
    {%- endif -%}
    {%- if _ex != blank -%}
      <span class="pm-blog-card__peek" aria-hidden="true">
        <span class="pm-blog-card__peek-text">{{ _ex | truncatewords: 28 }}</span>
        <span class="pm-blog-card__peek-cta">Read article &rarr;</span>
      </span>
    {%- endif -%}
  </a>
  <div class="pm-blog-card__body">
    {%- if article.tags.size > 0 -%}
      <span class="pm-blog-card__eyebrow">{{ article.tags.first }}</span>
    {%- endif -%}
    <a href="{{ article.url }}" class="pm-blog-card__title">{{ article.title }}</a>
    <div class="pm-blog-card__meta">
      {{ article.published_at | date: '%b %-d, %Y' }}{% if article.author != blank %} &middot; {{ article.author }}{% endif %}
    </div>
  </div>
</article>
