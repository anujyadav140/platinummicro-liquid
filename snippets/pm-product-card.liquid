{%- comment -%}
  PM — Product card (v2).
  Mirrors the Hydrogen PLP card 1:1:
    • Square image area with a soft tinted background
    • Brand line (vendor) as a tan all-caps eyebrow
    • Product title clamped to 2 lines
    • SKU line in mono
    • Price + terracotta "+ Add" button (POSTs /cart/add.js → triggers cart drawer)
    • "Compare" checkbox underneath
  Params:
    product (required)
{%- endcomment -%}

{%- assign _v = product.selected_or_first_available_variant -%}
{%- assign _img = product.featured_image -%}

<article class="pm-pcard" data-product-id="{{ product.id }}">
  <a href="{{ product.url }}" class="pm-pcard__img" aria-label="{{ product.title }}">
    {%- if _img -%}
      <img
        src="{{ _img | image_url: width: 480 }}"
        srcset="{{ _img | image_url: width: 240 }} 240w, {{ _img | image_url: width: 480 }} 480w, {{ _img | image_url: width: 720 }} 720w"
        sizes="(min-width: 1024px) 300px, (min-width: 640px) 33vw, 50vw"
        alt="{{ _img.alt | default: product.title | escape }}"
        loading="lazy"
        width="480"
        height="480"
      >
    {%- else -%}
      <div class="pm-pcard__img-placeholder" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
      </div>
    {%- endif -%}
    {%- comment -%}
      Sold-out corner ribbon removed — OOS is now communicated via the
      Add-to-Quote button (terracotta, active) on the footer of the card.
    {%- endcomment -%}
    {%- if product.compare_at_price > product.price and product.available -%}
      <span class="pm-pcard__flag pm-pcard__flag--sale">Sale</span>
    {%- endif -%}
  </a>

  <div class="pm-pcard__body">
    {%- if product.vendor != blank -%}
      <div class="pm-pcard__brand">{{ product.vendor | upcase }}</div>
    {%- endif -%}

    <a href="{{ product.url }}" class="pm-pcard__title">{{ product.title }}</a>

    {%- if _v.sku != blank -%}
      <div class="pm-pcard__sku">SKU {{ _v.sku }}</div>
    {%- endif -%}

    <div class="pm-pcard__foot">
      <div class="pm-pcard__price">
        {%- if product.compare_at_price > product.price -%}
          <span class="pm-pcard__price-strike">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
        <span class="pm-pcard__price-now">
          {%- if product.price_varies -%}From {% endif -%}
          {{ product.price | money }}
        </span>
      </div>

      {%- if product.available -%}
        <button
          type="button"
          class="pm-pcard__add"
          data-pm-add
          data-variant-id="{{ _v.id }}"
          aria-label="Add {{ product.title | escape }} to cart"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          <span>Add</span>
        </button>
      {%- else -%}
        {%- comment -%}
          Out-of-stock products route into the local quote store (pm-quote.js)
          rather than Shopify's /cart/add.js. The cart drawer merges quote
          items into its render with a QUOTE pill so the line is visually
          distinct from regular stocked items.
        {%- endcomment -%}
        <button
          type="button"
          class="pm-pcard__add pm-pcard__add--quote"
          data-pm-quote-add
          data-quote-sku="{{ _v.sku | escape }}"
          data-quote-variant-id="{{ _v.id }}"
          data-quote-product-id="{{ product.id }}"
          data-quote-name="{{ product.title | escape }}"
          data-quote-brand="{{ product.vendor | escape }}"
          data-quote-image="{% if _img %}{{ _img | image_url: width: 200 }}{% endif %}"
          data-quote-price="{{ product.price | money }}"
          data-quote-price-cents="{{ product.price }}"
          data-quote-href="{{ product.url }}"
          aria-label="Add {{ product.title | escape }} to quote"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <span>Add to Quote</span>
        </button>
      {%- endif -%}
    </div>

    <label class="pm-pcard__compare">
      <input type="checkbox" data-pm-compare data-product-handle="{{ product.handle }}">
      <span>Compare</span>
    </label>
  </div>
</article>
