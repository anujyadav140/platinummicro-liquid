{%- comment -%}
  PM — Product card (v2).
  Mirrors the Hydrogen PLP card 1:1:
    • Square image area with a soft tinted background
    • Brand line (vendor) as a tan all-caps eyebrow
    • Product title clamped to 2 lines
    • SKU line in mono
    • Price + terracotta "+ Add" button (POSTs /cart/add.js → triggers cart drawer)
    • "Compare" checkbox underneath
  Params:
    product (required)
{%- endcomment -%}

{%- assign _v = product.selected_or_first_available_variant -%}
{%- assign _img = product.featured_image -%}

<article class="pm-pcard" data-product-id="{{ product.id }}">
  <a href="{{ product.url }}" class="pm-pcard__img" aria-label="{{ product.title }}">
    {%- if _img -%}
      <img
        src="{{ _img | image_url: width: 480 }}"
        srcset="{{ _img | image_url: width: 240 }} 240w, {{ _img | image_url: width: 480 }} 480w, {{ _img | image_url: width: 720 }} 720w"
        sizes="(min-width: 1024px) 300px, (min-width: 640px) 33vw, 50vw"
        alt="{{ _img.alt | default: product.title | escape }}"
        {% if eager %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
        width="480"
        height="480"
      >
    {%- else -%}
      <div class="pm-pcard__img-placeholder" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
      </div>
    {%- endif -%}
    {%- comment -%}
      Sold-out corner ribbon removed — OOS is now communicated via the
      Add-to-Quote button (terracotta, active) on the footer of the card.
    {%- endcomment -%}
    {%- if _v.compare_at_price > _v.price and product.available -%}
      <span class="pm-pcard__flag pm-pcard__flag--sale">Sale</span>
    {%- endif -%}
  </a>

  <div class="pm-pcard__body">
    {%- if product.vendor != blank -%}
      <div class="pm-pcard__brand">{{ product.vendor | upcase }}</div>
    {%- endif -%}

    <a href="{{ product.url }}" class="pm-pcard__title">{{ product.title }}</a>

    {%- if _v.sku != blank -%}
      <div class="pm-pcard__sku">SKU {{ _v.sku }}</div>
    {%- endif -%}

    {%- comment -%} In stock = tracked, positive qty (snippet pm-instock) — NOT product.available (which counts untracked / continue-selling items as in-stock). {%- endcomment -%}
    {%- capture _isc -%}{%- render 'pm-instock', product: product -%}{%- endcapture -%}
    {%- assign _in_stock = false -%}{%- if _isc contains 'true' -%}{%- assign _in_stock = true -%}{%- endif -%}
    <div class="pm-pcard__foot">
      <div class="pm-pcard__price">
        {%- if _v.price == 0 or _in_stock == false -%}
          {%- comment -%} Quote-only / price-on-request: show "Pricing by quote" instead
              of a misleading $0.00. Mirrors the PDP treatment; the card footer already
              renders "Add to Quote" for these. {%- endcomment -%}
          <span class="pm-pcard__price-now pm-pcard__price-quote">Pricing by quote</span>
        {%- else -%}
          {%- if _v.compare_at_price > _v.price -%}
            <span class="pm-pcard__price-strike">{{ _v.compare_at_price | money }}</span>
          {%- endif -%}
          <span class="pm-pcard__price-now">
            {%- if product.price_varies -%}From {% endif -%}
            {{ _v.price | money }}
          </span>
        {%- endif -%}
      </div>

      {%- if _in_stock -%}
        {%- comment -%} TC-084: expose the inventory cap for ANY tracked variant with a
            positive count — DENY + CONTINUE alike (matches the PDP gate; CONTINUE is the
            inventory-desync workaround) — so pm-add-to-cart.js can disable "+ Add" once
            the cart already holds every available unit. {%- endcomment -%}
        {%- assign _maxq = '' -%}
        {%- if _v.inventory_management == 'shopify' and _v.inventory_quantity and _v.inventory_quantity > 0 -%}{%- assign _maxq = _v.inventory_quantity -%}{%- endif -%}
        <button
          type="button"
          class="pm-pcard__add"
          data-pm-add
          data-variant-id="{{ _v.id }}"
          {% if _maxq != '' %}data-max-qty="{{ _maxq }}"{% endif %}
          aria-label="Add {{ product.title | escape }} to cart"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
          <span>Add</span>
        </button>
      {%- else -%}
        {%- comment -%}
          Out-of-stock products use Quotify's request-a-quote button (the
          Quotify app embed binds to [data-quotify]) instead of Shopify's
          /cart/add.js. Keeps the PM card-button styling.
        {%- endcomment -%}
        <button
          type="button"
          class="pm-pcard__add pm-pcard__add--quote quotify-request-quote-btn"
          data-quotify
          data-product-id="{{ product.id }}"
          data-variant="{{ _v.id }}"
          data-product="{{ product | json | escape }}"
          aria-label="Request a quote for {{ product.title | escape }}"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <span>Request Quote</span>
        </button>
      {%- endif -%}
    </div>

    <label class="pm-pcard__compare">
      <input type="checkbox" data-pm-compare data-product-handle="{{ product.handle }}">
      <span>Compare</span>
    </label>
  </div>
</article>
