{%- comment -%}
  PM Form Field snippet — accessible, class-driven form input.
  Usage:
    {%- render 'pm-form-field',
        label:        'Email address',
        name:         'customer[email]',
        type:         'email',
        required:     true,
        placeholder:  'you@company.com',
        autocomplete: 'email',
        value:        '',
        error:        form.errors.messages['email'],
        hint:         ''
    -%}
  Styling: .pm-field-* classes in pm-auth-misc.css.
  ARIA:
    - label[for] ↔ input[id]
    - aria-required when required
    - aria-invalid when error
    - aria-describedby linking the input to its hint OR error message
      so screen readers announce it on focus.
{%- endcomment -%}

{%- assign _type        = type        | default: 'text' -%}
{%- assign _required    = required    | default: false -%}
{%- assign _placeholder = placeholder | default: '' -%}
{%- assign _value       = value       | default: '' -%}
{%- assign _error       = error       | default: '' -%}
{%- assign _hint        = hint        | default: '' -%}
{%- assign _fieldId     = 'pm-field-' | append: name | replace: '[', '-' | replace: ']', '' -%}
{%- assign _hintId      = _fieldId | append: '-hint' -%}
{%- assign _errId       = _fieldId | append: '-err' -%}
{%- assign _describedBy = '' -%}
{%- if _error != '' -%}{%- assign _describedBy = _errId -%}
{%- elsif _hint != '' -%}{%- assign _describedBy = _hintId -%}
{%- endif -%}

<div class="pm-field">
  <div class="pm-field__head">
    <label for="{{ _fieldId }}" class="pm-field__label">{{ label }}</label>
    {%- if _required and _error == '' -%}
      <span class="pm-field__required" aria-hidden="true">Required</span>
    {%- endif -%}
  </div>

  {%- if _type == 'textarea' -%}
    <textarea
      id="{{ _fieldId }}"
      name="{{ name }}"
      rows="3"
      class="pm-field__textarea"
      placeholder="{{ _placeholder | escape }}"
      {%- if _required %} required aria-required="true"{%- endif %}
      {%- if autocomplete != blank %} autocomplete="{{ autocomplete }}"{%- endif %}
      {%- if _error != '' %} aria-invalid="true"{%- endif %}
      {%- if _describedBy != '' %} aria-describedby="{{ _describedBy }}"{%- endif %}
    >{{ _value }}</textarea>
  {%- else -%}
    <input
      id="{{ _fieldId }}"
      name="{{ name }}"
      type="{{ _type }}"
      class="pm-field__input"
      value="{{ _value | escape }}"
      placeholder="{{ _placeholder | escape }}"
      {%- if _required %} required aria-required="true"{%- endif %}
      {%- if autocomplete != blank %} autocomplete="{{ autocomplete }}"{%- endif %}
      {%- if _error != '' %} aria-invalid="true"{%- endif %}
      {%- if _describedBy != '' %} aria-describedby="{{ _describedBy }}"{%- endif %}
    >
  {%- endif -%}

  {%- if _error != '' -%}
    <p id="{{ _errId }}" class="pm-field__error">{{ _error | escape }}</p>
  {%- elsif _hint != '' -%}
    <p id="{{ _hintId }}" class="pm-field__hint">{{ _hint }}</p>
  {%- endif -%}
</div>
