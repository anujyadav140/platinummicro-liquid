{%- comment -%}
  PM — Facets sidebar
  Always renders Brand / Price / Availability / Promotions groups so the
  PLP doesn't look empty when the merchant hasn't enabled storefront
  filters in Shopify admin yet.

  Priority for each group:
    1. Shopify storefront filter (results.filters)  — full counts, AJAX-ready
    2. Local fallback derived from collection.all_vendors + the products
       on the current page                          — partial counts, still usable
    3. Static checkboxes for Availability/Promotions

  Filtering URL params follow Shopify's standard scheme
  (`filter.p.vendor`, `filter.v.price.gte`, etc.) so when the merchant
  does enable filters in admin, everything Just Works.

  Params:
    results — collection or search object
{%- endcomment -%}

{%- assign _results = results -%}
{%- assign _is_search = false -%}
{%- if _results.terms != blank -%}{%- assign _is_search = true -%}{%- endif -%}

{%- comment -%} ── Resolve filters from Shopify or derive ──────────────────── {%- endcomment -%}
{%- assign _f_brand   = nil -%}
{%- assign _f_price   = nil -%}
{%- assign _f_avail   = nil -%}
{%- assign _f_promo   = nil -%}
{%- for f in _results.filters -%}
  {%- assign _pn = f.param_name | downcase -%}
  {%- if _pn contains 'vendor'        -%}{%- assign _f_brand = f -%}{%- endif -%}
  {%- if f.type == 'price_range'      -%}{%- assign _f_price = f -%}{%- endif -%}
  {%- if _pn contains 'availability'  -%}{%- assign _f_avail = f -%}{%- endif -%}
  {%- if _pn contains 'tag'           -%}{%- assign _f_promo = f -%}{%- endif -%}
{%- endfor -%}

{%- comment -%} ── Derive brand list if no Shopify filter ──────────────────── {%- endcomment -%}
{%- assign _brand_list = '' -%}
{%- if _f_brand == nil -%}
  {%- if _is_search -%}
    {%- assign _vendors_raw = '' -%}
    {%- for item in _results.results -%}
      {%- if item.object_type == 'product' and item.vendor != blank -%}
        {%- assign _vendors_raw = _vendors_raw | append: '|' | append: item.vendor -%}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- assign _vendors_raw = _results.all_vendors | join: '|' -%}
  {%- endif -%}
  {%- assign _brand_list = _vendors_raw -%}
{%- endif -%}

{%- comment -%} ── Derive price range from products on this page ───────────── {%- endcomment -%}
{%- assign _min_price = 0 -%}
{%- assign _max_price = 0 -%}
{%- if _f_price -%}
  {%- assign _max_price = _f_price.range_max | divided_by: 100.0 | ceil -%}
{%- else -%}
  {%- if _is_search -%}
    {%- for item in _results.results -%}
      {%- if item.object_type == 'product' -%}
        {%- assign _p = item.price | divided_by: 100.0 | ceil -%}
        {%- if _p > _max_price -%}{%- assign _max_price = _p -%}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {%- for p in _results.products -%}
      {%- assign _pp = p.price_max | divided_by: 100.0 | ceil -%}
      {%- if _pp > _max_price -%}{%- assign _max_price = _pp -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if _max_price < 100 -%}{%- assign _max_price = 100 -%}{%- endif -%}
{%- endif -%}

{%- comment -%} Current selections (from URL params) {%- endcomment -%}
{%- assign _curr_min = 0 -%}
{%- assign _curr_max = _max_price -%}
{%- if _f_price -%}
  {%- if _f_price.min_value.value != blank -%}{%- assign _curr_min = _f_price.min_value.value | divided_by: 100.0 -%}{%- endif -%}
  {%- if _f_price.max_value.value != blank -%}{%- assign _curr_max = _f_price.max_value.value | divided_by: 100.0 -%}{%- endif -%}
{%- endif -%}

{%- comment -%} Active count for mobile badge {%- endcomment -%}
{%- assign _active_count = 0 -%}
{%- for filter in _results.filters -%}
  {%- assign _active_count = _active_count | plus: filter.active_values.size -%}
{%- endfor -%}

{%- comment -%}
  ── Active-filter chips (TC-021) ──────────────────────────────────────
  Build a flat list of "name~~value~~label" triples for every applied
  filter so we can render removable chips + a "Clear all" control. Two
  sources, mutually exclusive per filter to avoid duplicates:
    1. Shopify storefront filters → use active_values (nice labels).
       Price ranges are special-cased into one min–max chip.
    2. Fallback params (filter not enabled in admin) → parse the raw
       query string. Mirrors the fallback checkboxes rendered below.
  removeFilter()/clearAll() in pm-facets.js rebuild the URL from
  name+value, so we don't need Shopify's url_to_remove here.
{%- endcomment -%}
{%- assign _chips = '' -%}
{%- comment -%} Raw query string (after ?) for fallback param sniffing. {%- endcomment -%}
{%- assign _query = request.url | split: '?' | last -%}

{%- comment -%} (1) Shopify list filters (vendor/availability/tag when admin-enabled) {%- endcomment -%}
{%- for f in _results.filters -%}
  {%- if f.type == 'price_range' -%}
    {%- assign _has_price_active = false -%}
    {%- if f.min_value.value != blank or f.max_value.value != blank -%}{%- assign _has_price_active = true -%}{%- endif -%}
    {%- if _has_price_active -%}
      {%- assign _pmin = 0 -%}
      {%- assign _pmax = f.range_max | divided_by: 100.0 | ceil -%}
      {%- if f.min_value.value != blank -%}{%- assign _pmin = f.min_value.value | divided_by: 100.0 | round -%}{%- endif -%}
      {%- if f.max_value.value != blank -%}{%- assign _pmax = f.max_value.value | divided_by: 100.0 | round -%}{%- endif -%}
      {%- assign _plabel = 'Price: $' | append: _pmin | append: '–$' | append: _pmax -%}
      {%- comment -%} __price__ sentinel → removeFilter() in pm-facets.js
          drops BOTH filter.v.price.gte and .lte in one click. {%- endcomment -%}
      {%- assign _chips = _chips | append: '|||__price__~~' | append: f.min_value.param_name | append: '~~' | append: _plabel -%}
    {%- endif -%}
  {%- else -%}
    {%- for v in f.active_values -%}
      {%- assign _chips = _chips | append: '|||' | append: v.param_name | append: '~~' | append: v.value | append: '~~' | append: v.label -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} (2) Fallback params for filters NOT exposed as Shopify objects {%- endcomment -%}
{%- if _f_brand == nil and _brand_list != blank and _query contains 'vendor=' -%}
  {%- assign _fb_brands = _brand_list | split: '|' | uniq -%}
  {%- for b in _fb_brands -%}
    {%- if b != blank -%}
      {%- comment -%} Match the encoded brand against the URL's vendor params.
          Look for "vendor=<enc>" so e.g. "Intel" doesn't false-match inside
          another value. (JS still owns authoritative checkbox/grid state.) {%- endcomment -%}
      {%- assign _b_enc = b | url_encode -%}
      {%- assign _needle = 'vendor=' | append: _b_enc -%}
      {%- if _query contains _needle -%}
        {%- assign _chips = _chips | append: '|||filter.p.vendor~~' | append: b | append: '~~' | append: b -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- if _f_avail == nil -%}
  {%- if _query contains 'availability=1' -%}{%- assign _chips = _chips | append: '|||filter.v.availability~~1~~In stock' -%}{%- endif -%}
  {%- if _query contains 'availability=0' -%}{%- assign _chips = _chips | append: '|||filter.v.availability~~0~~Out of stock' -%}{%- endif -%}
{%- endif -%}
{%- if _f_promo == nil -%}
  {%- if _query contains 'tag=on-sale' -%}{%- assign _chips = _chips | append: '|||filter.p.tag~~on-sale~~On sale' -%}{%- endif -%}
  {%- if _query contains 'tag=featured' -%}{%- assign _chips = _chips | append: '|||filter.p.tag~~featured~~Featured' -%}{%- endif -%}
{%- endif -%}
{%- if _f_price == nil -%}
  {%- if _query contains 'price.gte' or _query contains 'price.lte' -%}
    {%- comment -%} Generic label — exact gte/lte values aren't reliably
        parseable from the raw query string in Liquid; the chip still
        removes BOTH price params via the __price__ sentinel. {%- endcomment -%}
    {%- assign _chips = _chips | append: '|||__price__~~filter.v.price.gte~~Price' -%}
  {%- endif -%}
{%- endif -%}

{%- assign _chip_list = _chips | remove_first: '|||' | split: '|||' -%}
{%- if _chips != blank -%}{%- assign _has_active = true -%}{%- else -%}{%- assign _has_active = false -%}{%- endif -%}

<form
  id="pm-facets-form"
  class="pm-facets"
  data-pm-facets
  action="{{ _results.url | default: request.path }}"
  method="get"
  novalidate
  {%- comment -%} TC-017/020: when the vendor filter isn't admin-enabled,
      Shopify won't filter by filter.p.vendor, so flag the form and let
      pm-plp.js narrow the grid client-side. {%- endcomment -%}
  {% if _f_brand == nil %}data-pm-vendor-clientside="true"{% endif %}
>
  {%- if _is_search and _results.terms != blank -%}
    <input type="hidden" name="q" value="{{ _results.terms | escape }}">
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
  {%- endif -%}

  {%- comment -%} ── ACTIVE FILTER CHIPS + CLEAR ALL (TC-021) ─────────────── {%- endcomment -%}
  {%- if _has_active -%}
    <div class="pm-facets__active" data-pm-active-filters>
      <div class="pm-facets__active-head">
        <span class="pm-facets__active-title">Filters</span>
        <button type="button" class="pm-facets__clear" data-pm-clear-all>Clear all</button>
      </div>
      <ul class="pm-facets__chips">
        {%- for _chip in _chip_list -%}
          {%- assign _parts = _chip | split: '~~' -%}
          {%- assign _cname  = _parts[0] -%}
          {%- assign _cval   = _parts[1] -%}
          {%- assign _clabel = _parts[2] -%}
          {%- comment -%} Price sentinel: removing it must drop BOTH gte+lte. We pass a special name the JS expands. {%- endcomment -%}
          {%- if _cname == '__price__' -%}
            <li>
              <button type="button" class="pm-facets__chip" data-pm-filter-remove data-filter-name="filter.v.price" data-filter-value="">
                <span class="pm-facets__chip-label">{{ _clabel }}</span>
                <svg class="pm-facets__chip-x" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </button>
            </li>
          {%- else -%}
            <li>
              <button type="button" class="pm-facets__chip" data-pm-filter-remove data-filter-name="{{ _cname }}" data-filter-value="{{ _cval | escape }}">
                <span class="pm-facets__chip-label">{{ _clabel }}</span>
                <svg class="pm-facets__chip-x" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </button>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- comment -%} ── BRAND ───────────────────────────────────────────────── {%- endcomment -%}
  <details class="pm-facet" data-pm-facet open>
    <summary class="pm-facet__summary">
      <span>Brand</span>
      <svg class="pm-facet__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <div class="pm-facet__body">
      {%- if _f_brand -%}
        <ul class="pm-facet__values">
          {%- for value in _f_brand.values -%}
            {%- assign _dis = false -%}
            {%- if value.count == 0 and value.active == false -%}{%- assign _dis = true -%}{%- endif -%}
            <li>
              <label class="pm-facet__opt {% if _dis %}is-disabled{% endif %}">
                <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                       {% if value.active %}checked{% endif %} {% if _dis %}disabled{% endif %}>
                <span class="pm-facet__opt-label">{{ value.label }}</span>
                <span class="pm-facet__opt-count">{{ value.count }}</span>
              </label>
            </li>
          {%- endfor -%}
        </ul>
      {%- elsif _brand_list != blank -%}
        {%- assign _brands = _brand_list | split: '|' | uniq | sort_natural -%}
        <ul class="pm-facet__values">
          {%- for brand in _brands -%}
            {%- if brand != blank -%}
              {%- assign _bcount = 0 -%}
              {%- if _is_search -%}
                {%- for item in _results.results -%}
                  {%- if item.object_type == 'product' and item.vendor == brand -%}
                    {%- assign _bcount = _bcount | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- else -%}
                {%- for p in _results.products -%}
                  {%- if p.vendor == brand -%}{%- assign _bcount = _bcount | plus: 1 -%}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              {%- comment -%}
                TC-017/020: This is the FALLBACK vendor facet (storefront
                vendor filter not enabled in admin), so Shopify ignores
                `filter.p.vendor` server-side. We still emit the standard
                param so it lands in the URL, mark the input with
                data-pm-vendor + data-pm-vendor-value, and let
                pm-plp.js narrow the grid client-side and re-assert the
                checked state from the URL after every AJAX swap. The
                server-side `_checked` below is a best-effort initial
                paint; JS is authoritative.
              {%- endcomment -%}
              {%- assign _vendor_param = 'filter.p.vendor' -%}
              {%- assign _brand_enc = brand | url_encode -%}
              {%- assign _checked = false -%}
              {%- if request.url contains _brand_enc -%}{%- assign _checked = true -%}{%- endif -%}
              <li>
                <label class="pm-facet__opt">
                  <input type="checkbox" name="{{ _vendor_param }}" value="{{ brand | escape }}"
                         data-pm-vendor data-pm-vendor-value="{{ brand | escape }}" {% if _checked %}checked{% endif %}>
                  <span class="pm-facet__opt-label">{{ brand }}</span>
                  {%- if _bcount > 0 -%}<span class="pm-facet__opt-count">{{ _bcount }}</span>{%- endif -%}
                </label>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="pm-facet__empty">No brands yet.</p>
      {%- endif -%}
    </div>
  </details>

  {%- comment -%} ── PRICE ───────────────────────────────────────────────── {%- endcomment -%}
  <details class="pm-facet" data-pm-facet open>
    <summary class="pm-facet__summary">
      <span>Price</span>
      <svg class="pm-facet__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <div class="pm-facet__body">
      <div class="pm-facet__price">
        <div class="pm-facet__price-inputs">
          <label class="pm-facet__price-field">
            <span class="pm-facet__price-prefix">$</span>
            <input
              type="number"
              name="filter.v.price.gte"
              value="{{ _curr_min | round }}"
              min="0"
              max="{{ _max_price }}"
              placeholder="0"
              aria-label="Min price"
              data-pm-price-min
            >
          </label>
          <span class="pm-facet__price-sep">—</span>
          <label class="pm-facet__price-field">
            <span class="pm-facet__price-prefix">$</span>
            <input
              type="number"
              name="filter.v.price.lte"
              value="{{ _curr_max | round }}"
              min="0"
              max="{{ _max_price }}"
              placeholder="{{ _max_price }}"
              aria-label="Max price"
              data-pm-price-max
            >
          </label>
        </div>
        <div class="pm-range" data-pm-range data-bound-max="{{ _max_price }}">
          <div class="pm-range__track"></div>
          <div class="pm-range__fill" data-pm-range-fill></div>
          <input
            type="range"
            class="pm-range__thumb pm-range__thumb--min"
            min="0"
            max="{{ _max_price }}"
            value="{{ _curr_min | round }}"
            step="1"
            data-pm-range-min
            aria-label="Minimum price"
          >
          <input
            type="range"
            class="pm-range__thumb pm-range__thumb--max"
            min="0"
            max="{{ _max_price }}"
            value="{{ _curr_max | round }}"
            step="1"
            data-pm-range-max
            aria-label="Maximum price"
          >
        </div>
        <div class="pm-facet__price-bounds">
          <span>$0</span>
          <span>${{ _max_price }}</span>
        </div>
      </div>
    </div>
  </details>

  {%- comment -%} ── AVAILABILITY ─────────────────────────────────────────── {%- endcomment -%}
  <details class="pm-facet" data-pm-facet open>
    <summary class="pm-facet__summary">
      <span>Availability</span>
      <svg class="pm-facet__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <div class="pm-facet__body">
      {%- if _f_avail -%}
        <ul class="pm-facet__values">
          {%- for value in _f_avail.values -%}
            {%- assign _dis = false -%}
            {%- if value.count == 0 and value.active == false -%}{%- assign _dis = true -%}{%- endif -%}
            <li>
              <label class="pm-facet__opt {% if _dis %}is-disabled{% endif %}">
                <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"
                       {% if value.active %}checked{% endif %} {% if _dis %}disabled{% endif %}>
                <span class="pm-facet__opt-label">{{ value.label }}</span>
                <span class="pm-facet__opt-count">{{ value.count }}</span>
              </label>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        {%- assign _in_stock = 0 -%}
        {%- assign _out_stock = 0 -%}
        {%- if _is_search -%}
          {%- for item in _results.results -%}
            {%- if item.object_type == 'product' -%}
              {%- if item.available -%}{%- assign _in_stock = _in_stock | plus: 1 -%}{%- else -%}{%- assign _out_stock = _out_stock | plus: 1 -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for p in _results.products -%}
            {%- if p.available -%}{%- assign _in_stock = _in_stock | plus: 1 -%}{%- else -%}{%- assign _out_stock = _out_stock | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        <ul class="pm-facet__values">
          <li>
            <label class="pm-facet__opt">
              <input type="checkbox" name="filter.v.availability" value="1" {% if request.url contains 'availability=1' %}checked{% endif %}>
              <span class="pm-facet__opt-label">In stock</span>
              <span class="pm-facet__opt-count">{{ _in_stock }}</span>
            </label>
          </li>
          <li>
            <label class="pm-facet__opt">
              <input type="checkbox" name="filter.v.availability" value="0" {% if request.url contains 'availability=0' %}checked{% endif %}>
              <span class="pm-facet__opt-label">Out of stock</span>
              <span class="pm-facet__opt-count">{{ _out_stock }}</span>
            </label>
          </li>
        </ul>
      {%- endif -%}
    </div>
  </details>

  {%- comment -%} ── PROMOTIONS (collapsed by default) ──────────────────────
      Read On-sale + Featured straight from Shopify's tag filter (_f_promo) so
      they behave like the other facets: live count, stay checked when active,
      and auto-disable at 0. Falls back to count 0 / disabled when the tag has
      no matches in the current result set. {%- endcomment -%}
  {%- assign _os_count = 0 -%}{%- assign _os_active = false -%}{%- assign _os_value = 'on-sale' -%}
  {%- assign _ft_count = 0 -%}{%- assign _ft_active = false -%}{%- assign _ft_value = 'featured' -%}
  {%- if _f_promo -%}
    {%- for v in _f_promo.values -%}
      {%- assign _vv = v.value | downcase -%}
      {%- if _vv == 'on-sale'  -%}{%- assign _os_count = v.count -%}{%- assign _os_active = v.active -%}{%- assign _os_value = v.value -%}{%- endif -%}
      {%- if _vv == 'featured' -%}{%- assign _ft_count = v.count -%}{%- assign _ft_active = v.active -%}{%- assign _ft_value = v.value -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- assign _os_dis = false -%}{%- if _os_count == 0 and _os_active == false -%}{%- assign _os_dis = true -%}{%- endif -%}
  {%- assign _ft_dis = false -%}{%- if _ft_count == 0 and _ft_active == false -%}{%- assign _ft_dis = true -%}{%- endif -%}
  <details class="pm-facet" data-pm-facet>
    <summary class="pm-facet__summary">
      <span>Promotions</span>
      <svg class="pm-facet__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </summary>
    <div class="pm-facet__body">
      <ul class="pm-facet__values">
        <li>
          <label class="pm-facet__opt {% if _os_dis %}is-disabled{% endif %}">
            <input type="checkbox" name="filter.p.tag" value="{{ _os_value }}" {% if _os_active %}checked{% endif %} {% if _os_dis %}disabled{% endif %}>
            <span class="pm-facet__opt-label">On sale</span>
            <span class="pm-facet__opt-count">{{ _os_count }}</span>
          </label>
        </li>
        <li>
          <label class="pm-facet__opt {% if _ft_dis %}is-disabled{% endif %}">
            <input type="checkbox" name="filter.p.tag" value="{{ _ft_value }}" {% if _ft_active %}checked{% endif %} {% if _ft_dis %}disabled{% endif %}>
            <span class="pm-facet__opt-label">Featured</span>
            <span class="pm-facet__opt-count">{{ _ft_count }}</span>
          </label>
        </li>
      </ul>
    </div>
  </details>
</form>

{%- comment -%} Mobile filters toggle drawer {%- endcomment -%}
<button type="button" class="pm-facets__mobile-trigger" data-pm-facets-toggle aria-controls="pm-facets-form">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
  Filters
  {%- if _active_count > 0 -%}<span class="pm-facets__mobile-badge">{{ _active_count }}</span>{%- endif -%}
</button>
