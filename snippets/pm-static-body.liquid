  {%- comment -%} ───────────────────────────────────  REGISTER  ──── {%- endcomment -%}
  {%- when 'register' -%}
    <div class="pm-reg">
      <div class="pm-reg__inner">

        <header class="pm-reg__head">
          <div class="pm-static__kicker">Create Account</div>
          <h1 class="pm-reg__title">Open a business account.</h1>
          <p class="pm-reg__lead">For system integrators, IT teams, education, healthcare, and public-sector buyers. Trade credit available with approved application.</p>
        </header>

        {%- comment -%}
          Canonical Shopify pattern for New Customer Accounts:
          /customer_authentication/login + return_to (relative path).
          The email field's name is `login_hint` so Shopify pre-fills it
          on the hosted sign-in page.
          Ref: https://shopify.dev/docs/storefronts/themes/sign-in
        {%- endcomment -%}
        <form action="/customer_authentication/login" method="get" class="pm-reg__form">
          <input type="hidden" name="return_to" value="/pages/account">
          <div class="pm-reg__grid">

            <div class="pm-reg__field">
              <div class="pm-reg__label-row">
                <label for="pm-reg-email" class="pm-reg__label">Email address</label>
                <span class="pm-reg__req">Required</span>
              </div>
              <input id="pm-reg-email" name="login_hint" type="email" autocomplete="email" placeholder="you@company.com" required>
            </div>

            <div class="pm-reg__field">
              <div class="pm-reg__label-row">
                <label for="pm-reg-phone" class="pm-reg__label">Phone number</label>
                <span class="pm-reg__req">Required</span>
              </div>
              <input id="pm-reg-phone" name="customer[phone]" type="tel" autocomplete="tel" placeholder="(555) 123-4567" required>
            </div>

            <div class="pm-reg__field">
              <div class="pm-reg__label-row">
                <label for="pm-reg-pass" class="pm-reg__label">Password</label>
                <span class="pm-reg__req">Required</span>
              </div>
              {%- comment -%} No `name` — visual only (email magic-link auth) {%- endcomment -%}
              <input id="pm-reg-pass" type="password" autocomplete="new-password" minlength="8">
              <p class="pm-reg__hint">At least 8 characters, with a letter and a number.</p>
            </div>

            <div class="pm-reg__field">
              <div class="pm-reg__label-row">
                <label for="pm-reg-pass2" class="pm-reg__label">Confirm password</label>
                <span class="pm-reg__req">Required</span>
              </div>
              {%- comment -%} No `name` — visual only {%- endcomment -%}
              <input id="pm-reg-pass2" type="password" autocomplete="new-password" minlength="8">
            </div>

            <div class="pm-reg__field">
              <div class="pm-reg__label-row">
                <label for="pm-reg-first" class="pm-reg__label">First name</label>
                <span class="pm-reg__req">Required</span>
              </div>
              <input id="pm-reg-first" name="customer[first_name]" type="text" autocomplete="given-name" required>
            </div>

            <div class="pm-reg__field">
              <div class="pm-reg__label-row">
                <label for="pm-reg-last" class="pm-reg__label">Last name</label>
                <span class="pm-reg__req">Required</span>
              </div>
              <input id="pm-reg-last" name="customer[last_name]" type="text" autocomplete="family-name" required>
            </div>

            <div class="pm-reg__field pm-reg__field--full">
              <div class="pm-reg__label-row">
                <label for="pm-reg-company" class="pm-reg__label">Company name</label>
              </div>
              <input id="pm-reg-company" name="customer[note][company]" type="text" autocomplete="organization" placeholder="Optional">
            </div>

            <div class="pm-reg__field pm-reg__field--full">
              <div class="pm-reg__label-row">
                <label for="pm-reg-addr1" class="pm-reg__label">Address line 1</label>
                <span class="pm-reg__req">Required</span>
              </div>
              <input id="pm-reg-addr1" name="customer[note][address1]" type="text" autocomplete="address-line1" required>
            </div>

            <div class="pm-reg__field pm-reg__field--full">
              <div class="pm-reg__label-row">
                <label for="pm-reg-addr2" class="pm-reg__label">Address line 2</label>
              </div>
              <input id="pm-reg-addr2" name="customer[note][address2]" type="text" autocomplete="address-line2" placeholder="Apt, suite, floor (optional)">
            </div>

            <div class="pm-reg__field">
              <div class="pm-reg__label-row">
                <label for="pm-reg-country" class="pm-reg__label">Country</label>
                <span class="pm-reg__req">Required</span>
              </div>
              <select id="pm-reg-country" name="customer[note][country]" autocomplete="country-name" required>
                <option value="United States" selected>United States</option>
                <option>Canada</option>
                <option>United Kingdom</option>
                <option>Australia</option>
                <option>Germany</option>
                <option>France</option>
                <option>Japan</option>
                <option>Other</option>
              </select>
            </div>

            <div class="pm-reg__field">
              <div class="pm-reg__label-row">
                <label for="pm-reg-state" class="pm-reg__label">State / Province</label>
                <span class="pm-reg__req">Required</span>
              </div>
              <select id="pm-reg-state" name="customer[note][state]" autocomplete="address-level1" required>
                <option value="">Select…</option>
                <option>Alabama</option><option>Alaska</option><option>Arizona</option><option>Arkansas</option>
                <option>California</option><option>Colorado</option><option>Connecticut</option><option>Delaware</option>
                <option>Florida</option><option>Georgia</option><option>Hawaii</option><option>Idaho</option>
                <option>Illinois</option><option>Indiana</option><option>Iowa</option><option>Kansas</option>
                <option>Kentucky</option><option>Louisiana</option><option>Maine</option><option>Maryland</option>
                <option>Massachusetts</option><option>Michigan</option><option>Minnesota</option><option>Mississippi</option>
                <option>Missouri</option><option>Montana</option><option>Nebraska</option><option>Nevada</option>
                <option>New Hampshire</option><option>New Jersey</option><option>New Mexico</option><option>New York</option>
                <option>North Carolina</option><option>North Dakota</option><option>Ohio</option><option>Oklahoma</option>
                <option>Oregon</option><option>Pennsylvania</option><option>Rhode Island</option><option>South Carolina</option>
                <option>South Dakota</option><option>Tennessee</option><option>Texas</option><option>Utah</option>
                <option>Vermont</option><option>Virginia</option><option>Washington</option><option>West Virginia</option>
                <option>Wisconsin</option><option>Wyoming</option><option>District of Columbia</option>
              </select>
            </div>

            <div class="pm-reg__field">
              <div class="pm-reg__label-row">
                <label for="pm-reg-city" class="pm-reg__label">Suburb / City</label>
                <span class="pm-reg__req">Required</span>
              </div>
              <input id="pm-reg-city" name="customer[note][city]" type="text" autocomplete="address-level2" required>
            </div>

            <div class="pm-reg__field">
              <div class="pm-reg__label-row">
                <label for="pm-reg-zip" class="pm-reg__label">Zip / Postcode</label>
                <span class="pm-reg__req">Required</span>
              </div>
              <input id="pm-reg-zip" name="customer[note][zip]" type="text" autocomplete="postal-code" required>
            </div>

          </div>

          <div class="pm-reg__checks">
            <label class="pm-reg__check">
              <input type="checkbox" name="customer[accepts_marketing]" value="1">
              <span>Send me exclusive offers, new product alerts, and curated public-sector deal sheets.</span>
            </label>
            <label class="pm-reg__check">
              <input type="checkbox" name="customer[note][terms_accepted]" value="1" required>
              <span>I agree to Platinum Micro's
                {%- if shop.policies.terms_of_service.url != blank %} <a href="{{ shop.policies.terms_of_service.url }}">Terms</a> and{% else %} Terms and{% endif %}
                {%- if shop.policies.privacy_policy.url != blank %} <a href="{{ shop.policies.privacy_policy.url }}">Privacy Policy</a>{% else %} Privacy Policy{% endif %}.
                <span class="pm-reg__star">*</span>
              </span>
            </label>
          </div>

          <p class="pm-reg__note">
            Next step: we'll hand you off to Shopify's secure sign-in page where you'll receive an email with a sign-in link. After signing in, you'll be returned to <strong>Platinum Micro</strong>.
          </p>

          <button type="submit" class="pm-btn pm-btn--primary pm-btn--block pm-reg__submit">
            Create account
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>

          <p class="pm-reg__foot">Approval typically within one business day. Confirmation will arrive by email when your account is active.</p>
        </form>

        <p class="pm-reg__signin">Already have an account? <a href="/pages/sign-in">Sign in</a></p>

        {%- comment -%}
          Pre-submit hook: New Customer Accounts has no register endpoint that
          accepts customer[*] fields — they would otherwise pollute the URL on
          GET submit. Capture them to sessionStorage so the dashboard can
          remind the user to paste into their Shopify profile, then strip the
          name attrs so only return_to + login_hint reach Shopify.
        {%- endcomment -%}
        <script>
          (function () {
            var form = document.querySelector('form.pm-reg__form');
            if (!form) return;
            form.addEventListener('submit', function () {
              try {
                var data = {};
                form.querySelectorAll('input[name^="customer["], select[name^="customer["]').forEach(function (el) {
                  if (el.type === 'checkbox') data[el.name] = el.checked ? el.value : '';
                  else data[el.name] = el.value || '';
                  el.removeAttribute('name'); // strip before browser builds the GET URL
                });
                sessionStorage.setItem('pm-reg-pending', JSON.stringify(data));
              } catch (e) { /* non-blocking */ }
            }, { capture: true });
          })();
        </script>
      </div>
    </div>

  {%- comment -%} ───────────────────────────────────  SIGN-IN  ──── {%- endcomment -%}
  {%- when 'sign-in' -%}
    <div class="pm-signin">
      <div class="pm-signin__inner">
        <div class="pm-signin__pane">
          <div class="pm-static__kicker">New customer?</div>
          <h2 class="pm-signin__title">Open a business<br>account.</h2>
          <p class="pm-signin__lead">Open an account and you'll be able to:</p>
          <ul class="pm-signin__list">
            <li>Check out faster</li>
            <li>Save multiple shipping addresses</li>
            <li>Access your order history</li>
            <li>Track new orders</li>
            <li>Save items to your lists</li>
          </ul>
          <a href="/pages/register" class="pm-btn pm-btn--primary pm-btn--block">
            Create Account
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <p class="pm-signin__fine">
            By signing up, you agree to Platinum Micro's
            {%- if shop.policies.terms_of_service.url != blank %} <a href="{{ shop.policies.terms_of_service.url }}">Terms</a> and{% else %} Terms and{% endif %}
            {%- if shop.policies.privacy_policy.url != blank %} <a href="{{ shop.policies.privacy_policy.url }}">Privacy Policy</a>{% else %} Privacy Policy{% endif %}.
          </p>
        </div>

        <div class="pm-signin__divider"></div>

        <div class="pm-signin__pane">
          <div class="pm-static__kicker">Returning customer</div>
          <h2 class="pm-signin__title">Sign in to your<br>account.</h2>

          {%- comment -%}
            Canonical Shopify pattern: /customer_authentication/login
            + return_to (relative path). Email name is `login_hint` so
            it pre-fills on Shopify's hosted sign-in page.
            Ref: https://shopify.dev/docs/storefronts/themes/sign-in
          {%- endcomment -%}
          <form action="/customer_authentication/login" method="get" class="pm-signin__form">
            <input type="hidden" name="return_to" value="/pages/account">
            <div class="pm-signin__field">
              <div class="pm-signin__label-row">
                <label for="pm-signin-email" class="pm-signin__label">Email address</label>
                <span class="pm-signin__req">Required</span>
              </div>
              <input
                type="email"
                id="pm-signin-email"
                name="login_hint"
                autocomplete="email"
                placeholder="you@company.com"
                required
              >
            </div>

            <div class="pm-signin__field">
              <div class="pm-signin__label-row">
                <label for="pm-signin-pass" class="pm-signin__label">Password</label>
                <span class="pm-signin__req">Required</span>
              </div>
              {%- comment -%}
                No `name` attr — New Customer Accounts uses email
                magic-link auth, so the password field is visual only
                and should NOT end up in the URL on submit.
              {%- endcomment -%}
              <input
                type="password"
                id="pm-signin-pass"
                autocomplete="current-password"
                placeholder="••••••••"
              >
            </div>

            <a href="/account" class="pm-signin__forgot">Forgot password?</a>

            <button type="submit" class="pm-btn pm-btn--primary pm-btn--block">
              Sign in
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>

            <p class="pm-signin__note">
              Sign-in is handled by Shopify's secure email link. You'll be returned to <strong>Platinum Micro</strong> after signing in.
            </p>
          </form>

          <p class="pm-signin__fine">
            By signing up, you agree to Platinum Micro's
            {%- if shop.policies.terms_of_service.url != blank %} <a href="{{ shop.policies.terms_of_service.url }}">Terms</a> and{% else %} Terms and{% endif %}
            {%- if shop.policies.privacy_policy.url != blank %} <a href="{{ shop.policies.privacy_policy.url }}">Privacy Policy</a>{% else %} Privacy Policy{% endif %}.
          </p>
        </div>
      </div>
    </div>

  {%- comment -%} ───────────────────────────────────  COMPARE  ──── {%- endcomment -%}
  {%- when 'compare' -%}
    <div class="pm-static__body">
      <div class="pm-static__body__inner pm-static__body__inner--wide">
