{%- comment -%}
  PM — Static page body
  Renders the right baked content for a given handle.
{%- endcomment -%}

{%- assign _h = handle -%}
{%- assign _centered = false -%}
{%- if _h == 'about' -%}{%- assign _centered = true -%}{%- endif -%}

{%- comment -%} Brand logo map (Shopify CDN files) — text fallback for the rest {%- endcomment -%}
{%- assign _cdn = 'https://cdn.shopify.com/s/files/1/0715/8841/3523/files/' -%}
{%- assign _brand_logos = 'hpe:HPE_BIG.png|dell:DELL.png|lenovo:0992.HK.png|cisco:CSCO.png|intel:INTC.png|microsoft:MSFT_BIG.png|amd:AMD_BIG.png|samsung:005930.KS_BIG.png|seagate:STX_BIG.png|wd:WDC_BIG.png|micron:MU_BIG.png|arctic:ARCTIC_logo_white.png' -%}

<section class="pm-static{% if _centered %} pm-static--centered{% endif %}">

  {%- comment -%}
    ── DARK NAVY HERO ──
    Skipped on /pages/compare and /pages/sign-in because both render
    their own headers inline.
  {%- endcomment -%}
  {%- assign _skip_hero = false -%}
  {%- if _h == 'compare' or _h == 'sign-in' or _h == 'register' or _h == 'account' or _h == 'lists' -%}{%- assign _skip_hero = true -%}{%- endif -%}
  {%- unless _skip_hero -%}
    <header class="pm-static__hero">
      <div class="pm-static__hero__inner">
        {%- case _h -%}
        {%- when 'about' -%}
          <div class="pm-static__eyebrow">About Platinum Micro</div>
          <h1 class="pm-static__title">For two decades, Platinum Micro has distributed enterprise IT from Southern California to system integrators, public-sector buyers, and healthcare networks worldwide.</h1>
          <p class="pm-static__lead">Forty-plus manufacturer partnerships, real lead times, named account managers — sourced direct, with trade credit available on approved application.</p>
        {%- when 'brands' -%}
          <h1 class="pm-static__title">Authorized partner brands.</h1>
          <p class="pm-static__lead">21 manufacturer relationships across direct authorization and authorized-distributor channels</p>
        {%- when 'contact' -%}
          <div class="pm-static__eyebrow">Talk to a Specialist</div>
          <h1 class="pm-static__title">Talk to Platinum Micro.</h1>
          <p class="pm-static__lead">Mon–Fri · 7am – 5pm PT · Sylmar, California</p>
        {%- when 'shipping-returns' -%}
          <div class="pm-static__eyebrow">Logistics</div>
          <h1 class="pm-static__title">Shipping &amp; returns.</h1>
          <p class="pm-static__lead">Free shipping on the continental U.S. · 30-day returns.</p>
        {%- when 'site-map' -%}
          <div class="pm-static__eyebrow">Site Map</div>
          <h1 class="pm-static__title">Browse the Site.</h1>
          <p class="pm-static__lead">23 pages across 4 sections</p>
        {%- when 'social-responsibility' -%}
          <div class="pm-static__eyebrow">Social Responsibility</div>
          <h1 class="pm-static__title">Where Platinum Micro gives back.</h1>
          <p class="pm-static__lead">Local-first community partnerships, plus national health and humanitarian programs.</p>
        {%- when 'order-verification' -%}
          <div class="pm-static__eyebrow">Order</div>
          <h1 class="pm-static__title">Order Verification</h1>
          <p class="pm-static__lead">Effective May 19, 2026</p>
        {%- else -%}
          <div class="pm-static__eyebrow">Platinum Micro</div>
          <h1 class="pm-static__title">{{ page.title | default: 'Page' }}</h1>
        {%- endcase -%}
      </div>
    </header>
  {%- endunless -%}

  {%- case _h -%}

  {%- comment -%} ────────────────────────────  ABOUT (band layout)  ──── {%- endcomment -%}
  {%- when 'about' -%}
    <section class="pm-band pm-band--paper">
      <div class="pm-band__inner">
        <div class="pm-static__kicker">Mission</div>
        <h2 class="pm-static__h2">Sourced direct. Sold honest.</h2>
        <p>Platinum Micro exists to give institutional IT buyers a straight line to the hardware they need — without the markup theater, the phantom inventory, or the white-glove fees that get layered onto most public-sector contracts.</p>
        <p>We carry real stock. We quote in writing. We answer the phone. And when a part is on a six-week lead time, we say so before you cut the PO.</p>
      </div>
    </section>

    <section class="pm-band pm-band--tint">
      <div class="pm-band__inner">
        <div class="pm-static__kicker">Contracts</div>
        <h2 class="pm-static__h2">Public-sector contract vehicles</h2>
        <p>Buy from Platinum Micro through the contract that fits your procurement workflow. We honor pricing aligned with the underlying cooperative, federal, or state schedule.</p>
        <div class="pm-static__cards pm-static__cards--3col">
          <div class="pm-static__card">
            <h3>OMNIA Partners</h3>
            <p>Lead contract vehicle for cooperative public-sector procurement across the United States.</p>
          </div>
          <div class="pm-static__card">
            <h3>TD SYNNEX</h3>
            <p>Tier-one distribution partnership backing every order with manufacturer-direct supply.</p>
          </div>
          <div class="pm-static__card">
            <h3>GSA-aligned pricing</h3>
            <p>Schedule-aligned pricing available on request for federal and DoD buyers.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="pm-band pm-band--paper">
      <div class="pm-band__inner">
        <div class="pm-static__kicker">Certifications</div>
        <h2 class="pm-static__h2">Credentials and partnerships</h2>
        <div class="pm-static__cards pm-static__cards--2col pm-static__cards--icon">
          <div class="pm-static__card pm-static__card--icon">
            <span class="pm-static__card-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
            <div>
              <h3>Authorized Reseller</h3>
              <p>Direct partner status with HPE, Dell, Lenovo, Cisco, Intel, AMD, and 40+ other manufacturers.</p>
            </div>
          </div>
          <div class="pm-static__card pm-static__card--icon">
            <span class="pm-static__card-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"/></svg></span>
            <div>
              <h3>Small Business</h3>
              <p>SBA Small Business certified, eligible for set-aside and small-business goal contracts.</p>
            </div>
          </div>
          <div class="pm-static__card pm-static__card--icon">
            <span class="pm-static__card-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></span>
            <div>
              <h3>Public-Sector Focus</h3>
              <p>Two decades serving K–12, higher ed, healthcare networks, and state / local government.</p>
            </div>
          </div>
          <div class="pm-static__card pm-static__card--icon">
            <span class="pm-static__card-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8M12 6v12"/></svg></span>
            <div>
              <h3>Trade Credit</h3>
              <p>Net-30 terms available on approved application for qualifying public-sector buyers.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

  {%- comment -%} ────────────────────────────  BRANDS (logo grid)  ──── {%- endcomment -%}
  {%- when 'brands' -%}
    <div class="pm-static__body">
      <div class="pm-static__body__inner pm-static__body__inner--wide">
        <p class="pm-static__intro">Inventory at Platinum Micro flows through two channels — direct authorized-reseller agreements with the manufacturers below, and authorized distribution partnerships (TD SYNNEX, Ingram Micro, and others) for the broader enterprise catalog. Either way, every unit carries the original manufacturer warranty and ships from a verified channel — never from grey-market or secondary sources.</p>

        <article class="pm-brands__block">
          <h2 class="pm-static__h2">Direct authorized resellers</h2>
          <p>Platinum Micro holds direct manufacturer authorization for the brands below — pricing, warranty escalations, and product roadmaps come straight from the source.</p>
          <ul class="pm-brand-cards">
            {%- assign _direct = 'HPE:hpe|Dell:dell|Lenovo:lenovo|Cisco:cisco|Intel:intel|Microsoft:microsoft' | split: '|' -%}
            {%- for _pair in _direct -%}
              {%- assign _kv = _pair | split: ':' -%}
              {%- assign _label = _kv[0] -%}
              {%- assign _key = _kv[1] -%}
              {%- assign _logo = '' -%}
              {%- assign _pairs2 = _brand_logos | split: '|' -%}
              {%- for _p in _pairs2 -%}
                {%- assign _kv2 = _p | split: ':' -%}
                {%- if _kv2[0] == _key -%}{%- assign _logo = _cdn | append: _kv2[1] -%}{%- endif -%}
              {%- endfor -%}
              <li class="pm-brand-card">
                {%- if _logo != '' -%}
                  <img src="{{ _logo }}" alt="{{ _label }}" loading="lazy">
                {%- else -%}
                  <span class="pm-brand-card__text">{{ _label | upcase }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </article>

        <article class="pm-brands__block">
          <h2 class="pm-static__h2">Sourced through authorized distributors</h2>
          <p>Available through Platinum Micro's authorized distribution agreements. Lead times, channel pricing, and warranty handling are identical to direct purchases.</p>
          <ul class="pm-brand-cards">
            {%- assign _dist = 'AMD:amd|NVIDIA:nvidia|Samsung:samsung|Seagate:seagate|Western Digital:wd|Crucial (Micron):micron|Arctic:arctic|ASUS:asus|Acer:acer|Logitech:logitech|APC:apc|Tripp Lite:tripp-lite|NETGEAR:netgear|Kingston:kingston|Corsair:corsair' | split: '|' -%}
            {%- for _pair in _dist -%}
              {%- assign _kv = _pair | split: ':' -%}
              {%- assign _label = _kv[0] -%}
              {%- assign _key = _kv[1] -%}
              {%- assign _logo = '' -%}
              {%- assign _pairs2 = _brand_logos | split: '|' -%}
              {%- for _p in _pairs2 -%}
                {%- assign _kv2 = _p | split: ':' -%}
                {%- if _kv2[0] == _key -%}{%- assign _logo = _cdn | append: _kv2[1] -%}{%- endif -%}
              {%- endfor -%}
              <li class="pm-brand-card">
                {%- if _logo != '' -%}
                  <img src="{{ _logo }}" alt="{{ _label }}" loading="lazy">
                {%- else -%}
                  <span class="pm-brand-card__text">{{ _label | upcase }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </article>

        <article class="pm-static__cta">
          <h3>Don't see your brand?</h3>
          <p>Distribution agreements cover more than 40 manufacturers — many outside this list. Most major enterprise lines can be sourced on request. Call <a href="tel:18777644968">(877) PMG-4YOU</a> or email <a href="mailto:admin@platinummicro.com">admin@platinummicro.com</a> with the manufacturer name and a rough quantity, and Business Development will quote within one business day.</p>
        </article>
      </div>
    </div>

  {%- comment -%} ─────────────────────────────  SITE MAP (link list)  ──── {%- endcomment -%}
  {%- when 'site-map' -%}
    <div class="pm-static__body">
      <div class="pm-static__body__inner">
        <p class="pm-static__intro">Every working route on platinummicro.com, grouped by section. If you can't find what you're looking for, the search bar at the top of every page covers the full product catalog. The contact page lists direct phone and email for sales, support, and billing.</p>

        <section class="pm-sitemap__group">
          <h2 class="pm-static__h2">Catalog</h2>
          <p>Browse the product catalog by category.</p>
          <ul class="pm-sitemap__list">
            <li><a href="/">Home</a></li>
            <li><a href="/collections/components">Components</a></li>
            <li><a href="/collections/computers">Computers</a></li>
            <li><a href="/collections/networking">Networking</a></li>
            <li><a href="/collections/peripherals">Peripherals</a></li>
            <li><a href="/collections/servers">Servers</a></li>
            <li><a href="/collections/software">Software</a></li>
            <li><a href="/collections/bundles">Bulk Options</a></li>
            <li><a href="/collections/bundles">Bundles</a></li>
          </ul>
        </section>

        <section class="pm-sitemap__group">
          <h2 class="pm-static__h2">About</h2>
          <p>Company background, partner brands, and policies.</p>
          <ul class="pm-sitemap__list">
            <li><a href="/pages/about">About Us</a></li>
            <li><a href="/pages/brands">Authorized Brands</a></li>
            <li><a href="/pages/contact">Contact Us</a></li>
            <li><a href="/pages/shipping-returns">Shipping &amp; Returns</a></li>
            <li><a href="/pages/site-map">Site Map</a></li>
            <li><a href="/pages/social-responsibility">Social Responsibility</a></li>
          </ul>
        </section>

        <section class="pm-sitemap__group">
          <h2 class="pm-static__h2">Account</h2>
          <p>Sign in, register, or recover account access.</p>
          <ul class="pm-sitemap__list">
            <li><a href="/account/login">Sign in</a></li>
            <li><a href="/account/register">Register</a></li>
            <li><a href="/account/login#recover">Forgot password</a></li>
            <li><a href="/account/login#recover">Reset password</a></li>
            <li><a href="/account">Profile</a></li>
          </ul>
        </section>

        <section class="pm-sitemap__group">
          <h2 class="pm-static__h2">Legal</h2>
          <ul class="pm-sitemap__list">
            {%- if shop.policies.privacy_policy.url != blank -%}
              <li><a href="{{ shop.policies.privacy_policy.url }}">Privacy Policy</a></li>
            {%- endif -%}
            {%- if shop.policies.terms_of_service.url != blank -%}
              <li><a href="{{ shop.policies.terms_of_service.url }}">Terms &amp; Conditions</a></li>
            {%- endif -%}
            <li><a href="/pages/order-verification">Order Verification</a></li>
          </ul>
        </section>
      </div>
    </div>

  {%- comment -%} ────────────────────────────────────  CONTACT  ──── {%- endcomment -%}
  {%- when 'contact' -%}
    <div class="pm-static__body">
      <div class="pm-static__body__inner">
        <article class="pm-static__block">
          <p>Questions about an order, a quote, or anything else? Reach the Platinum Micro team directly. The fastest path is the toll-free line during business hours; email is checked all day.</p>
        </article>
        <article class="pm-static__block">
          <h2 class="pm-static__h2">By phone</h2>
          <p><a href="tel:18777644968"><strong>(877) PMG-4YOU</strong></a> — toll free, Monday–Friday, 7:00am – 5:00pm Pacific. Calls go to a real person; cancellations and time-sensitive order changes should be made by phone (email may not be received in time).</p>
        </article>
        <article class="pm-static__block">
          <h2 class="pm-static__h2">By email</h2>
          <p><a href="mailto:admin@platinummicro.com"><strong>admin@platinummicro.com</strong></a> — for general inquiries, quote requests, account questions, and return-related help.</p>
          <p>For tax-exempt certification, send documentation to <a href="mailto:tax-exempt@platinummicro.com"><strong>tax-exempt@platinummicro.com</strong></a>.</p>
        </article>
        <article class="pm-static__block">
          <h2 class="pm-static__h2">Mailing address</h2>
          <p>Platinum Micro, Inc.<br>15815 Monte Street, Suite 103<br>Sylmar, CA 91342<br>United States</p>
        </article>
        <article class="pm-static__block">
          <h2 class="pm-static__h2">What you might want instead</h2>
          <ul class="pm-static__list">
            <li>Order tracking, return windows, RMA process → <a href="/pages/shipping-returns">Shipping &amp; returns</a></li>
            <li>Verification call about your order → <a href="/pages/order-verification">Order verification</a></li>
            <li>Account sign-in / password reset → <a href="/account/login">Sign in</a></li>
            <li>Cooperative contracts (OMNIA / NASPO) → <a href="/pages/about">About</a></li>
          </ul>
        </article>
      </div>
    </div>

  {%- comment -%} ───────────────────────────  SHIPPING & RETURNS  ──── {%- endcomment -%}
  {%- when 'shipping-returns' -%}
    <div class="pm-static__body">
      <div class="pm-static__body__inner">
        <article class="pm-static__block">
          <p>Platinum Micro ships from Sylmar, California, partners with multiple carriers, and processes orders Monday through Friday. The policies below are the ones written into every order and invoice.</p>
        </article>
        <article class="pm-static__block">
          <h2 class="pm-static__h2">Free shipping</h2>
          <p>Free shipping on all items to the continental United States. Alaska, Hawaii, and U.S. territories require expedited shipping with additional charges. Orders may arrive in multiple shipments.</p>
        </article>
        <article class="pm-static__block">
          <h2 class="pm-static__h2">Service area</h2>
          <p>Platinum Micro ships to the 48 continental U.S. states, Alaska, Hawaii, and U.S. territories only. International shipping is not available at this time — non-U.S. buyers should contact Business Development for partner-channel options.</p>
        </article>
        <article class="pm-static__block">
          <h2 class="pm-static__h2">Shipment timeline</h2>
          <p>Orders are shipped as soon as possible, typically within 1–2 business days after payment is confirmed. Processing happens Monday–Friday only. Once a package is handed off, transit time is out of Platinum Micro's hands.</p>
          <div class="pm-static__cards pm-static__cards--2col">
            <div class="pm-static__card"><h3>Free Budget Shipping</h3><p>8–14 business days transit, plus 1–2 business days processing.</p></div>
            <div class="pm-static__card"><h3>USPS Priority</h3><p>3–7 business days transit, plus 1–2 business days processing.</p></div>
          </div>
        </article>
        <article class="pm-static__block">
          <h2 class="pm-static__h2">Tracking</h2>
          <p>Track packages directly with the carrier: <a href="https://www.ups.com/track" target="_blank" rel="noopener noreferrer">UPS tracking</a> · <a href="https://tools.usps.com/go/TrackConfirmAction_input" target="_blank" rel="noopener noreferrer">USPS tracking</a>.</p>
        </article>
        <article class="pm-static__block">
          <h2 class="pm-static__h2">Returns</h2>
          <p>All items ship brand new with manufacturer warranty. Bulk and OEM products lack retail packaging and accessories but carry full warranties. Platinum Micro is not responsible for physical damage, misuse, or anything that voids the manufacturer warranty.</p>
          <p><strong>Non-returnable items:</strong> open software, digital downloads, software keycards, online subscriptions, and products from LG, GIGABYTE, and FORTINET.</p>
          <h3>Window &amp; timeline</h3>
          <ul class="pm-static__list">
            <li>30-day return / exchange policy from purchase date.</li>
            <li>RMA numbers are valid for 10 business days from issue.</li>
            <li>RMA processing takes 5–7 business days after receipt.</li>
            <li>Refunds issued within 7 business days of receiving the returned merchandise.</li>
          </ul>
          <h3>Fees &amp; costs</h3>
          <ul class="pm-static__list">
            <li>15% restocking fee on all returns for refund.</li>
            <li>No restocking fee on RMA replacements of defective items.</li>
            <li>Original shipping costs are non-refundable.</li>
            <li>Platinum Micro covers return shipping only on defective-merchandise exchanges.</li>
          </ul>
          <h3>How to return</h3>
          <p>Contact Platinum Micro for an RMA number before shipping anything back. Every return must have a valid carrier tracking number — UPS, FedEx, or USPS. No advance replacements are offered.</p>
          <h3>Return address</h3>
          <p>Platinum Micro, Inc.<br>15815 Monte Street, Suite 103<br>Sylmar, CA 91342<br>United States<br>Toll Free: <a href="tel:18777644968">(877) PMG-4YOU</a></p>
        </article>
      </div>
    </div>

  {%- comment -%} ──────────────────────────  SOCIAL RESPONSIBILITY  ──── {%- endcomment -%}
  {%- when 'social-responsibility' -%}
    <div class="pm-static__body">
      <div class="pm-static__body__inner">
        <article class="pm-static__block">
          <p>Platinum Micro is based in Sylmar, California, and the company's giving reflects that — local-first community partnerships paired with national health, humanitarian, and youth-focused programs. Direct contributions and volunteer time are split across the following organizations.</p>
        </article>
        <article class="pm-static__block">
          <h2 class="pm-static__h2">Partner organizations</h2>
          <ul class="pm-static__list">
            <li><strong>American Red Cross</strong> — Emergency response, blood services, disaster relief.</li>
            <li><strong>Children's Hospital Los Angeles</strong> — Pediatric care and research.</li>
            <li><strong>World Harvest</strong> — Food rescue and distribution.</li>
            <li><strong>Ronald McDonald House</strong> — Housing for families of children in treatment.</li>
            <li><strong>Feeding America</strong> — Nationwide hunger-relief network.</li>
            <li><strong>Wat Thai</strong> — Community programs in the Los Angeles Thai diaspora.</li>
            <li><strong>UCLA Health</strong> — Academic medical research and patient care.</li>
            <li><strong>New Direction for Youth (NDFY)</strong> — Mentorship and education for at-risk youth.</li>
            <li><strong>St. Jude Children's Research Hospital</strong> — Pediatric cancer research and care.</li>
          </ul>
        </article>
        <article class="pm-static__block">
          <h2 class="pm-static__h2">Environmental compliance</h2>
          <p>On the operational side, Platinum Micro complies with California's Electronic Waste Recycling Act, collecting state-mandated fees on covered display devices at purchase and routing them to certified recyclers. Customers with end-of-life equipment are encouraged to use a state-licensed e-waste handler — staff can recommend partners on request.</p>
        </article>
        <article class="pm-static__cta">
          <h3>Get involved</h3>
          <p>Resellers, manufacturers, and customers who want to align a purchase or program with one of the partner organizations above can reach Business Development at <a href="tel:18777644968">(877) PMG-4YOU</a> Monday–Friday, 7am–5pm PT, or <a href="mailto:admin@platinummicro.com">admin@platinummicro.com</a>.</p>
        </article>
      </div>
    </div>

  {%- comment -%} ────────────────────────────────  ACCOUNT (dashboard)  ──── {%- endcomment -%}
  {%- when 'account' -%}
    {%- comment -%}
      Custom dashboard users land on after signing in via
      /customer_authentication/login?return_to=/pages/account.
      We branch on the {{ customer }} object — if Liquid sees them as
      signed in, show the dashboard; otherwise nudge them to /pages/sign-in.
    {%- endcomment -%}
    <div class="pm-acct">
      <div class="pm-acct__inner pm-container">
        {%- if customer -%}
          <header class="pm-acct__head">
            <div class="pm-static__kicker">My Account</div>
            <h1 class="pm-acct__title">Welcome back, {{ customer.first_name | default: 'friend' }}.</h1>
            <p class="pm-acct__lead">Signed in as <strong>{{ customer.email }}</strong>.</p>
          </header>

          <div class="pm-acct__grid">
            {%- assign _parts = routes.account_url | split: '?' -%}
            {%- assign _base = _parts | first -%}
            {%- assign _qs = '' -%}
            {%- if _parts.size > 1 -%}{%- assign _qs = '?' | append: _parts.last -%}{%- endif -%}

            <a class="pm-acct__tile" href="{{ _base }}/orders{{ _qs }}">
              <div class="pm-acct__tile-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="15" y2="16"/></svg>
              </div>
              <div>
                <h3>Orders</h3>
                <p>{{ customer.orders_count | default: 0 }} order{% if customer.orders_count != 1 %}s{% endif %} on file</p>
              </div>
