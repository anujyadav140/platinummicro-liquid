{%- comment -%}
  PM — SEO meta tags
  Canonical + Open Graph + Twitter Card + JSON-LD structured data
  (Organization sitewide, Product on product pages). Rendered in <head>
  from layout/theme.liquid. image_url returns a protocol-relative URL,
  so social/structured-data image URLs are prefixed with `https:`
  (same approach as Shopify's Dawn reference theme).
{%- endcomment -%}
<link rel="canonical" href="{{ canonical_url }}">

{%- comment -%} rel=prev/next for paginated COLLECTIONS (crawl hint for the page series;
    search is noindex so skipped). per_page mirrors the collection section default of 24. {%- endcomment -%}
{%- if request.page_type == 'collection' and collection -%}
  {%- assign _cp = current_page | default: 1 | plus: 0 -%}
  {%- if _cp > 1 -%}
    {%- assign _prev = _cp | minus: 1 -%}
    {%- if _prev <= 1 -%}<link rel="prev" href="{{ shop.url }}{{ collection.url }}">
    {%- else -%}<link rel="prev" href="{{ shop.url }}{{ collection.url }}?page={{ _prev }}">{%- endif -%}
  {%- endif -%}
  {%- assign _seen = _cp | times: 24 -%}
  {%- if _seen < collection.products_count -%}<link rel="next" href="{{ shop.url }}{{ collection.url }}?page={{ _cp | plus: 1 }}">{%- endif -%}
{%- endif -%}

{%- liquid
  assign og_title = page_title
  if request.page_type == 'index'
    assign og_title = shop.name
  endif
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article' or request.page_type == 'blog'
    assign og_type = 'article'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{%- elsif settings.logo != blank -%}
  <meta property="og:image" content="https:{{ settings.logo | image_url: width: 1200 }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if page_image -%}
  <meta name="twitter:image" content="https:{{ page_image | image_url: width: 1200 }}">
{%- endif -%}

{%- comment -%} Organization (sitewide) {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }}
  {%- if settings.logo != blank -%}
  , "logo": {{ settings.logo | image_url: width: 400 | prepend: 'https:' | json }}
  {%- endif -%}
}
</script>

{%- comment -%} WebSite + SearchAction (sitewide) {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": "{{ shop.url }}{{ routes.search_url }}?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- comment -%} BreadcrumbList — mirrors the visible breadcrumbs {%- endcomment -%}
{%- if request.page_type == 'product' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | json }}
    }
    {%- if collection -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json | replace: '</', '<\/' }},
      "item": {{ shop.url | append: collection.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json | replace: '</', '<\/' }},
      "item": {{ shop.url | append: product.url | json }}
    }
    {%- else -%}
    ,{
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json | replace: '</', '<\/' }},
      "item": {{ shop.url | append: product.url | json }}
    }
    {%- endif -%}
  ]
}
</script>
{%- elsif request.page_type == 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": {{ shop.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json | replace: '</', '<\/' }},
      "item": {{ shop.url | append: collection.url | json }}
    }
  ]
}
</script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- assign _v = product.selected_or_first_available_variant -%}
  {%- assign _mpn = product.metafields.custom.mpn | default: product.metafields.specs.mpn -%}
  {%- comment -%} gtin: only emit a valid 12/13-digit barcode {%- endcomment -%}
  {%- assign _gtin = '' -%}
  {%- assign _barcode = _v.barcode | strip -%}
  {%- if _barcode != blank -%}
    {%- assign _barcode_digits = _barcode | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' -%}
    {%- if _barcode_digits == blank -%}
      {%- assign _barcode_len = _barcode | size -%}
      {%- if _barcode_len == 12 or _barcode_len == 13 -%}
        {%- assign _gtin = _barcode -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json | replace: '</', '<\/' }},
    "url": {{ shop.url | append: product.url | json }},
    {%- if product.images.size > 0 -%}
    "image": [{%- for _img in product.images limit: 5 -%}{{ _img | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last %},{% endunless -%}{%- endfor -%}],
    {%- elsif product.featured_media -%}
    "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | truncate: 320 | json | replace: '</', '<\/' }},
    {%- if product.vendor != blank -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    {%- endif -%}
    {%- if _v.sku != blank -%}
    "sku": {{ _v.sku | json }},
    {%- endif -%}
    {%- if _mpn != blank -%}
    "mpn": {{ _mpn | json }},
    {%- endif -%}
    {%- if _gtin != blank -%}
    "gtin": {{ _gtin | json }},
    {%- endif -%}
    "itemCondition": "https://schema.org/NewCondition",
    {%- if product.price_varies -%}
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
      "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
      "offerCount": {{ product.variants.size }},
      "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ shop.url | append: product.url | json }}
    }
    {%- else -%}
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      {%- if _v.price and _v.price > 0 -%}
      "price": {{ _v.price | divided_by: 100.0 | json }},
      {%- endif -%}
      "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": {{ shop.url | append: product.url | json }}
    }
    {%- endif -%}
  }
  </script>
{%- endif -%}
