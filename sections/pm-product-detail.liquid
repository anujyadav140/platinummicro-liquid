{%- comment -%}
  PM — Product Detail Page
  Modeled on the Hydrogen PDP design (platinummicro-hydrogen):
   1. Breadcrumb
   2. Two-column main:
        LEFT  — gallery (~488px cap, thumbs + main with hover zoom)
        RIGHT — info pane that splits at md+ into:
                  - Details: title, brand link, SKU, MPN, divider, price,
                    UPC, Shipping & Returns button, At-a-glance bullets
                  - Buy-box card: Availability + "X in stock", Quantity,
                    Add to Cart / Add to Quote, Add to List
   3. Description ‖ Specifications block (parallel, flat, on pm-paper)
        LEFT  — wider (1.4fr) prose w/ Key features (2-col bullets)
        RIGHT — narrower (1fr) specs table w/ zebra rows + expand toggle
{%- endcomment -%}

{%- assign _v       = product.selected_or_first_available_variant -%}
{%- assign _sku     = _v.sku -%}
{%- assign _upc     = _v.barcode -%}
{%- assign _stock   = _v.inventory_quantity -%}
{%- comment -%} In stock = tracked, positive qty (snippet pm-instock) — NOT product.available, which counts untracked / "sell when out of stock" items as in-stock. {%- endcomment -%}
{%- capture _isc -%}{%- render 'pm-instock', product: product -%}{%- endcapture -%}
{%- assign _instock = false -%}{%- if _isc contains 'true' -%}{%- assign _instock = true -%}{%- endif -%}

{%- comment -%} ── MPN: prefer metafield, fall back to SKU so the line never goes empty ── {%- endcomment -%}
{%- assign _mpn = product.metafields.custom.mpn | default: product.metafields.specs.mpn -%}
{%- if _mpn == blank -%}
  {%- assign _mpn = _sku -%}
{%- endif -%}

{%- comment -%} ── Key features (newline-separated metafield) ── {%- endcomment -%}
{%- assign _features_raw = product.metafields.custom.key_features | default: product.metafields.specs.key_features -%}
{%- assign _features = '' | split: '' -%}
{%- if _features_raw != blank -%}
  {%- assign _features = _features_raw | newline_to_br | split: '<br />' -%}
{%- endif -%}

{%- comment -%}
  ── Bundle modifiers (1:1 port of Hydrogen pm-bundle-options) ──
  Admin contract — Shopify product metafields under the `pmb` namespace:
    pmb.bundle_label            single_line_text   custom header text
    pmb.bundle_max_quantity     number_integer     caps the total qty
    pmb.bundle_discount_percent number_integer     % off base when ANY
                                                   add-on is selected
    pmb.bundle_products         list.product_reference  the catalog of
                                                       pickable add-ons
  When `bundle_products` is empty or unset, the bundle block doesn't
  render at all — the buy-box reads as a non-bundle PDP.
{%- endcomment -%}
{%- assign _bundle_products = product.metafields.pmb.bundle_products.value -%}
{%- assign _bundle_discount = product.metafields.pmb.bundle_discount_percent.value | default: 0 -%}
{%- assign _bundle_max_qty  = product.metafields.pmb.bundle_max_quantity.value -%}
{%- comment -%}
  Bulk Options — products TAGGED "Bulk Options" get quantity-tier pricing:
  10-19 = 10% off, 20-29 = 20% off, 30+ = 30% off. The tiers are shown here
  (link + modal + live "you're saving X%" as qty changes); the actual discount
  is applied by 3 Shopify automatic discounts scoped to the Bulk Options
  collection (best qualifying tier wins on cart quantity). Merchant enables it
  on any product simply by adding the "Bulk Options" tag in the admin.
  ⚠ If you change these percentages/thresholds, also update the automatic
  discounts in Admin → Discounts so the display and the charge stay in sync.
{%- endcomment -%}
{%- assign _is_bulk = false -%}
{%- if product.tags contains 'Bulk Options' -%}{%- assign _is_bulk = true -%}{%- endif -%}
{%- assign _bundle_label    = product.metafields.pmb.bundle_label.value -%}
{%- assign _has_bundle = false -%}
{%- if _bundle_products and _bundle_products.size > 0 -%}
  {%- assign _has_bundle = true -%}
{%- endif -%}

{%- comment -%}
  BC-migrated bundle products carry a real variant OPTION named
  "Bundle and get 3% off" whose "(Pack of N)" variants hold the
  3%-discounted BASE price (that's how BigCommerce charged the deal).
  When present: the JS maps the card's qty -> that variant so the
  discount is genuinely charged, and the redundant option dropdown
  is suppressed below. When absent: no discount is promised or
  charged (matches the BC PDPs, which have no pick list there).
{%- endcomment -%}
{%- assign _has_bundle_variants = false -%}
{%- for _opt in product.options -%}
  {%- assign _optdn = _opt | downcase -%}
  {%- if _optdn contains 'bundle' -%}{%- assign _has_bundle_variants = true -%}{%- endif -%}
{%- endfor -%}

{%- comment -%} Display title: admin label > auto label > generic fallback.
    The "% OFF" claim only renders when bundle variants exist to actually
    charge it — otherwise the honest generic heading. {%- endcomment -%}
{%- assign _bundle_title = _bundle_label -%}
{%- if _bundle_title == blank -%}
  {%- if _bundle_discount > 0 and _has_bundle_variants -%}
    {%- assign _bundle_title = 'BUNDLE AND GET ' | append: _bundle_discount | append: '% OFF' -%}
  {%- else -%}
    {%- assign _bundle_title = 'BUNDLE WITH ADD-ONS' -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  ── Specs sourcing ──
  Delegate to `pm-pdp-specs-build` (ports the Hydrogen pm-product-by-slug
  extractor). It probes BC-style aggregate metafields, Shopify category
  metafields, and per-spec metafields across custom/pm/specs/bc
  namespaces; emits an encoded "name ~~KV~~ value ~~ROW~~ …" stream that
  we split into pairs for rendering rows + at-a-glance bullets.
{%- endcomment -%}
{%- capture _specs_encoded -%}{%- render 'pm-pdp-specs-build', product: product -%}{%- endcapture -%}
{%- assign _spec_pairs = _specs_encoded | split: '~~ROW~~' -%}
{%- assign _spec_count = 0 -%}
{%- for pair in _spec_pairs -%}
  {%- assign _p = pair | strip -%}
  {%- if _p != '' and _p contains '~~KV~~' -%}
    {%- assign _spec_count = _spec_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%}
  ── HP grouped spec sheet (hp_hermes.spec_sheet) ──
  HP SLED products (the configurator-driven imports) carry a curated,
  HP.com-style GROUPED sheet — [{group, rows:[{label,value}]}] — built by
  hp-hermes's curate-specs script, with the picker-owned sections
  (Processor/Memory & Storage/Graphics) already stripped so it never
  contradicts the wizard's live selection (see HANDOFF-CONFIGURATOR.md §4b).
  When present, this REPLACES the generic flat pm-pdp-specs-build table for
  just this product — every other product's specs are completely untouched.
{%- endcomment -%}
{%- assign _hp_spec_sheet = product.metafields.hp_hermes.spec_sheet.value -%}
{%- assign _has_hp_specsheet = false -%}
{%- if _hp_spec_sheet and _hp_spec_sheet.size > 0 -%}{%- assign _has_hp_specsheet = true -%}{%- endif -%}

<main class="pm-pdp">
  {%- comment -%}
    ── PDF datasheet payload ──
    Structured JSON island the "Download datasheet (PDF)" button reads
    from. Keeps the JS asset decoupled from rendered DOM markup —
    swap the markup, the PDF still builds correctly from this data.

    `description_html` is the raw HTML; the JS strips it client-side
    via DOMParser so paragraph / list breaks survive. Specs seed from
    the same `_specs_encoded` (metafield) capture that drives the
    on-page table; when those are empty and specs hydrate client-side
    from pm-product-specs.json, the inline script backfills this island
    (and the PDF also reads the rendered table) so the datasheet always
    matches what the buyer sees.
  {%- endcomment -%}
  {%- capture _specs_json -%}[
  {%- assign _first_s = true -%}
  {%- for pair in _spec_pairs -%}
    {%- assign _kv = pair | split: '~~KV~~' -%}
    {%- if _kv.size >= 2 -%}
      {%- assign _kvn = _kv[0] | strip -%}
      {%- assign _kvv = _kv[1] | strip -%}
      {%- if _kvn != '' and _kvv != '' -%}
        {%- unless _first_s %},{% endunless -%}
        {%- assign _first_s = false -%}
        {"name":{{ _kvn | json | replace: '</', '<\/' }},"value":{{ _kvv | json | replace: '</', '<\/' }}}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  ]{%- endcapture -%}

  {%- capture _features_json -%}[
  {%- assign _first_f = true -%}
  {%- for f in _features -%}
    {%- assign _ft = f | strip -%}
    {%- if _ft != '' -%}
      {%- unless _first_f %},{% endunless -%}
      {%- assign _first_f = false -%}
      {{ _ft | json | replace: '</', '<\/' }}
    {%- endif -%}
  {%- endfor -%}
  ]{%- endcapture -%}

  <script id="pm-pdp-pdf-data" type="application/json">
  {
    "title": {{ product.title | json | replace: '</', '<\/' }},
    "vendor": {{ product.vendor | default: '' | json | replace: '</', '<\/' }},
    "sku": {{ _sku | default: '' | json | replace: '</', '<\/' }},
    "mpn": {{ _mpn | default: '' | json | replace: '</', '<\/' }},
    "upc": {{ _upc | default: '' | json | replace: '</', '<\/' }},
    "price": {{ _v.price | money | json | replace: '</', '<\/' }},
    "url": {{ shop.url | append: product.url | json | replace: '</', '<\/' }},
    "shop": {{ shop.name | json | replace: '</', '<\/' }},
    "available": {% if _instock %}true{% else %}false{% endif %},
    "stock": {{ _stock | default: 0 }},
    "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 1200 | json | replace: '</', '<\/' }}{% else %}""{% endif %},
    "description_html": {{ product.description | default: '' | json | replace: '</', '<\/' }},
    "features": {{ _features_json }},
    "specs": {{ _specs_json }}
  }
  </script>

  <div class="pm-container pm-pdp__top">

    {%- comment -%} ── Breadcrumb ───────────────────────────────────────────── {%- endcomment -%}
    <nav class="pm-pdp__crumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}" class="pm-pdp__crumb-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        <span>Home</span>
      </a>
      {%- if collection -%}
        <svg class="pm-pdp__crumb-sep" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        <a href="{{ collection.url }}" class="pm-pdp__crumb-link">{{ collection.title }}</a>
      {%- endif -%}
      <svg class="pm-pdp__crumb-sep" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      <span class="pm-pdp__crumb-current">{{ product.title | truncate: 80 }}</span>
    </nav>

    {%- comment -%} ── Main grid: Gallery + Info pane ─────────────────────── {%- endcomment -%}
    {%- comment -%} Config (HPE ProLiant) products get the CDW-style wide-content layout {%- endcomment -%}
    {%- comment -%}
      ── HPE ProLiant experience PAUSED for launch (2026-07-01) ──
      The configurator + live panel ran on MOCK middleware data. All the HPE code is left intact
      and gated behind ONE flag. TO RE-ENABLE when the real HPE API is wired: set _hpe_enabled = true
      below. That single flag restores the whole HPE treatment (CDW wide layout, "Starting at"
      eyebrow, real-data detail block, and the configurator render further down). Nothing else changed.
    {%- endcomment -%}
    {%- assign _hpe_enabled = false -%}
    {%- comment -%}
      ── HP (HP Inc, via the Hermes Catalog API) — TESTING ──
      Same one-flag pattern as _hpe_enabled above. Set _hp_enabled = false to
      switch the whole HP treatment off in one line.

      NOTE this is a different vendor to the HPE block above: HP Inc (desktops,
      workstations, displays, Poly, print) vs HPE (ProLiant servers) — separate
      companies since 2015, separate APIs. They do not share data.

      Safe to leave on: both HP snippets self-gate on the product actually having
      the `hp` metafields, so they render nothing on every existing product. Only
      the imported HP SLED products (tag: hp-hermes-test) show anything.
    {%- endcomment -%}
    {%- assign _hp_enabled = true -%}
    {%- comment -%}
      ── HP hardware wizard gate ── the consolidated HP import (tag B2G) carries
      hardware config as REAL variant options, so those PDPs swap the native
      option dropdowns for the stepped wizard (snippets/pm-hp-wizard.liquid).
      The hidden selects stay in the DOM as the source of truth — the wizard
      drives them, the existing variant-switch JS below stays untouched.
    {%- endcomment -%}
    {%- assign _hp_wizard = false -%}
    {%- if _hp_enabled and product.vendor == 'HP' and product.tags contains 'B2G' and product.has_only_default_variant == false -%}
      {%- assign _hp_wizard = true -%}
    {%- endif -%}
    {%- comment -%}
      ── HP procurement data card (UNSPSC / origin / warranty / sustainability) ──
      Anuj: don't display this at all. Independent of _hp_wizard — the card and
      the configurator used to share one snippet (pm-hp-config.liquid) and one
      render call; this flag turns off only the card's render call + its
      [data-pm-hp-info] mount, the wizard keeps working untouched.
    {%- endcomment -%}
    {%- assign _hp_procurement_card = false -%}
    {%- assign _cfg = false -%}
    {%- if _hpe_enabled -%}
      {%- if product.title contains 'ProLiant' or product.vendor contains 'Hewlett' or product.vendor contains 'HPE' -%}{%- assign _cfg = true -%}{%- endif -%}
    {%- endif -%}
    <div class="pm-pdp__main-grid{% if _cfg %} pm-pdp__main-grid--cfg{% endif %}">

      {%- comment -%}
        ── Gallery ──
        DOM order is thumbs → hero; the frame uses column-reverse so the
        hero shows on top with the thumbnails in a horizontal strip
        directly below it (same layout on every breakpoint).
      {%- endcomment -%}
      <div class="pm-pdp__gallery{% if product.images.size > 1 %} pm-pdp__gallery--has-thumbs{% endif %}">
        {%- comment -%}
          ── Frame: thumbs + hero ──
          Hero is intentionally short (2:1 instead of square) so the
          column has room for the At-a-glance bullets below — which
          pushes the Description / Specs band closer to the fold.
        {%- endcomment -%}
        <div class="pm-pdp__gallery-frame">
          {%- if product.images.size > 1 -%}
            <div class="pm-pdp__thumbs">
              {%- for image in product.images limit: 12 -%}
                <button
                  type="button"
                  class="pm-pdp__thumb{% if forloop.first %} is-active{% endif %}"
                  data-pm-pdp-thumb="{{ image | image_url: width: 1600 }}"
                  aria-label="View image {{ forloop.index }}"
                >
                  <img
                    src="{{ image | image_url: width: 160 }}"
                    alt="{{ image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="62"
                    height="62"
                  >
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="pm-pdp__hero" data-pm-pdp-hero>
            {%- if product.featured_image -%}
              {%- comment -%}
                Source is 1600px (not the display ~528px) because the frame
                applies a 2x CSS hover-zoom on this same <img> — at 2x on a
                retina screen the zoom needs ~2100px to stay crisp, so 900px
                looked soft exactly when a buyer zoomed to inspect a part
                (Shopify guideline: product images up to 2048², min 800² for
                zoom). No srcset here on purpose: the thumb-swap JS sets
                .src, which a srcset would override → keep it a single source.
                fetchpriority high because this is the PDP's LCP element.
              {%- endcomment -%}
              <img
                id="pm-pdp-main-img"
                src="{{ product.featured_image | image_url: width: 1600 }}"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                width="1600"
                height="1600"
                loading="eager"
                fetchpriority="high"
                data-pm-pdp-zoom
              >
            {%- else -%}
              <div class="pm-pdp__hero-empty">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              </div>
            {%- endif -%}
          </div>
        </div>

      </div>

      {%- comment -%} ── Info pane: Details column + Buy-box card ──────── {%- endcomment -%}
      <div class="pm-pdp__info-grid">

        {%- comment -%} ── Details column ─────────────────────────────── {%- endcomment -%}
        <div class="pm-pdp__details">
          <h1 class="pm-pdp__title">{{ product.title }}</h1>

          {%- if product.vendor != blank -%}
            <a href="{{ routes.collections_url }}/vendors?q={{ product.vendor | url_encode }}" class="pm-pdp__brand">{{ product.vendor }}</a>
          {%- endif -%}

          <div class="pm-pdp__ids">
            {%- if _sku != blank -%}
              <div class="pm-pdp__id-row">
                <span class="pm-pdp__id-label">SKU:</span>
                <span class="pm-pdp__id-value" id="pm-pdp-sku">{{ _sku }}</span>
              </div>
            {%- endif -%}
            {%- if _mpn != blank -%}
              <div class="pm-pdp__id-row">
                <span class="pm-pdp__id-label">MPN:</span>
                <span class="pm-pdp__id-value">{{ _mpn }}</span>
              </div>
            {%- endif -%}
          </div>

          {%- comment -%}
            ── Price ──
            Quote-only products (out of stock here) hide the price and the
            Add-to-Cart button so the page leads with the Quotify quote flow.
            In-stock products show price + buy controls as normal.
          {%- endcomment -%}
          {%- if _instock -%}
            {%- comment -%} Price reflects the SELECTED/first-available variant (_v), not product.price (the catalog minimum), so the displayed price matches what checkout charges for that variant. The price-meta is always rendered (hidden when not on sale) so the variant-change handler can keep the "was" price + Sale flag in sync instead of leaving the initial-render value stale. {%- endcomment -%}
            {%- assign _on_sale = false -%}
            {%- if _v.compare_at_price > _v.price -%}{%- assign _on_sale = true -%}{%- endif -%}
            <div class="pm-pdp__price-block">
              {%- if _cfg -%}<div class="pm-pdp__price-eyebrow">Starting at</div>{%- endif -%}
              <div class="pm-pdp__price{% if _on_sale %} pm-pdp__price--sale{% endif %}" id="pm-pdp-price">{{ _v.price | money }}</div>
              <div class="pm-pdp__price-meta" data-pm-pdp-price-meta{% unless _on_sale %} hidden{% endunless %}>
                <span class="pm-pdp__price-was">{% if _v.compare_at_price > 0 %}{{ _v.compare_at_price | money }}{% endif %}</span>
                <span class="pm-pdp__price-flag">Sale</span>
              </div>
              {%- if _has_bundle -%}
                <div class="pm-pdp__price-bundle-note" data-pm-pdp-bundle-note hidden>
                  Includes {{ _v.price | money }} base + bundle add-ons
                </div>
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="pm-pdp__price-block pm-pdp__price-block--quote">
              <div class="pm-pdp__price-quote">Pricing by quote</div>
              <div class="pm-pdp__price-quote-sub">Request a quote for current pricing &amp; availability.</div>
              {%- comment -%}
                "Need it sooner?" — anchors to the alternatives rail, which
                quote-only products render right below the buy area (see the
                _recs_mount capture). Ships hidden: pm-recommendations.js
                reveals every [data-pm-recs-jump] only after the rail renders
                with at least one buyable card, so it can never point at an
                empty rail.
                Copy says "buy now" (not "in stock, ships today"): the reveal
                can only test Shopify's `available` flag, which — unlike the
                theme's pm-instock rule — also counts untracked / continue-
                selling variants. "Available to buy now" is true for every one
                of those; a shipping promise wouldn't be.
              {%- endcomment -%}
              <a class="pm-pdp__quote-jump" href="#pm-recs-anchor" data-pm-recs-jump hidden>
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="4" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
                <span>Need it sooner? Shop similar items</span>
              </a>
            </div>
          {%- endif -%}

          {%- if _upc != blank -%}
            <div class="pm-pdp__upc">
              <span class="pm-pdp__id-label">UPC:</span>
              <span class="pm-pdp__upc-value">{{ _upc }}</span>
            </div>
          {%- endif -%}

          <a href="/pages/shipping-returns" class="pm-pdp__ship-btn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="1" y="3" width="15" height="13" rx="1"/>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
              <circle cx="5.5" cy="18.5" r="2.5"/>
              <circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
            <span>Shipping and Returns</span>
          </a>

          {%- comment -%}
            ── At a glance ──
            Sits in the details column (under Shipping & Returns) so it
            fills the space beside the gallery instead of leaving the
            middle column empty.
            IN-STOCK products only: on quote-only PDPs the space goes to
            the "you can buy now" rail instead, and the glance bullets
            just pushed it further down (user call, 2026-07-16). The
            hydration JS null-checks [data-pm-pdp-glance], so omitting
            the markup entirely is safe.
          {%- endcomment -%}
          {%- if _instock -%}
          <div class="pm-pdp__glance" data-pm-pdp-glance{% if _features.size == 0 and _spec_count == 0 and _has_hp_specsheet == false %} hidden{% endif %}>
            <div class="pm-pdp__glance-eyebrow" data-pm-pdp-glance-eyebrow>
              {%- if _features.size > 0 -%}Key features{%- else -%}At a glance{%- endif -%}
            </div>
            <ul class="pm-pdp__glance-list" data-pm-pdp-glance-list>
              {%- if _features.size > 0 -%}
                {%- for f in _features limit: 4 -%}
                  {%- assign _ft = f | strip -%}
                  {%- if _ft != blank -%}
                    <li>
                      <span class="pm-pdp__glance-dot" aria-hidden="true"></span>
                      <span>{{ _ft | escape }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- elsif _has_hp_specsheet -%}
                {%- assign _shown = 0 -%}
                {%- for _section in _hp_spec_sheet -%}
                  {%- if _shown >= 4 -%}{%- break -%}{%- endif -%}
                  {%- for _row in _section.rows -%}
                    {%- if _shown >= 4 -%}{%- break -%}{%- endif -%}
                    {%- if _row.label != blank and _row.value != blank -%}
                      <li>
                        <span class="pm-pdp__glance-dot" aria-hidden="true"></span>
                        <span><strong>{{ _row.label }}:</strong> {{ _row.value }}</span>
                      </li>
                      {%- assign _shown = _shown | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}
              {%- else -%}
                {%- assign _shown = 0 -%}
                {%- for pair in _spec_pairs -%}
                  {%- if _shown >= 4 -%}{%- break -%}{%- endif -%}
                  {%- assign _p = pair | strip -%}
                  {%- if _p == '' -%}{%- continue -%}{%- endif -%}
                  {%- unless _p contains '~~KV~~' -%}{%- continue -%}{%- endunless -%}
                  {%- assign _kv = _p | split: '~~KV~~' -%}
                  {%- assign _nm = _kv[0] | strip -%}
                  {%- assign _vl = _kv[1] | strip -%}
                  {%- if _nm != '' and _vl != '' -%}
                    <li>
                      <span class="pm-pdp__glance-dot" aria-hidden="true"></span>
                      <span><strong>{{ _nm }}:</strong> {{ _vl }}</span>
                    </li>
                    {%- assign _shown = _shown | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
            <a href="#pm-product-description" class="pm-pdp__glance-more">
              <span>See full details &amp; specs</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
          </div>
          {%- endif -%}

        </div>

        {%- comment -%} ── Buy-box card ──────────────────────────────── {%- endcomment -%}
        <aside class="pm-pdp__buybox">

          {%- comment -%}
            ── Bundle modifiers (top of buy-box) ──
            Server renders the option rows; JS in the inline script
            below handles selection state, qty stepping, live total
            recompute, and threading the add-on into the cart-add
            payload. Hidden entirely when no bundle metafields set.
          {%- endcomment -%}
          {%- if _has_bundle -%}
            <div
              class="pm-pdp__bundle"
              data-pm-pdp-bundle
              data-base-variant-id="{{ _v.id }}"
              data-base-price-cents="{{ _v.price }}"
              data-discount-pct="{{ _bundle_discount }}"
              {%- if _bundle_max_qty %} data-max-qty="{{ _bundle_max_qty }}"{%- endif %}
            >
              <header class="pm-pdp__bundle-head">
                <h3 class="pm-pdp__bundle-eyebrow">{{ _bundle_title }}</h3>
              </header>
              <ul class="pm-pdp__bundle-list" role="radiogroup" aria-label="Bundle options">
                {%- comment -%} "None" row — base product only, no add-on {%- endcomment -%}
                <li class="pm-pdp__bundle-row is-selected" data-pm-bundle-row data-value-id="none">
                  <button
                    type="button"
                    class="pm-pdp__bundle-btn"
                    data-pm-bundle-select
                    role="radio"
                    aria-checked="true"
                  >
                    <span class="pm-pdp__bundle-indicator" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    <div class="pm-pdp__bundle-info">
                      <span class="pm-pdp__bundle-name">None</span>
                      <span class="pm-pdp__bundle-sub">Just the base product</span>
                    </div>
                  </button>
                </li>

                {%- for ref in _bundle_products -%}
                  {%- assign _ref_v = ref.selected_or_first_available_variant -%}
                  {%- if _ref_v -%}
                    <li
                      class="pm-pdp__bundle-row"
                      data-pm-bundle-row
                      data-value-id="{{ ref.id }}"
                      data-add-on-variant-id="{{ _ref_v.id }}"
                      data-add-on-price-cents="{{ _ref_v.price }}"
                      data-add-on-sku="{{ _ref_v.sku | escape }}"
                      data-add-on-name="{{ ref.title | escape }}"
                    >
                      <button
                        type="button"
                        class="pm-pdp__bundle-btn"
                        data-pm-bundle-select
                        role="radio"
                        aria-checked="false"
                      >
                        <span class="pm-pdp__bundle-indicator" aria-hidden="true">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                        </span>
                        {%- if ref.featured_image -%}
                          <span class="pm-pdp__bundle-img">
                            <img src="{{ ref.featured_image | image_url: width: 80 }}" alt="" width="40" height="40" loading="lazy">
                          </span>
                        {%- endif -%}
                        <div class="pm-pdp__bundle-info">
                          <span class="pm-pdp__bundle-name">{{ ref.title }}</span>
                          <div class="pm-pdp__bundle-meta">
                            {%- if _ref_v.sku != blank -%}
                              <span class="pm-pdp__bundle-sub">{{ _ref_v.sku }}{% unless _ref_v.available %} · <span class="pm-pdp__bundle-oos">Out of stock</span>{% endunless %}</span>
                            {%- endif -%}
                            <span class="pm-pdp__bundle-price">{{ _ref_v.price | money }} each</span>
                          </div>
                        </div>
                      </button>

                      {%- comment -%}
                        Qty expansion — hidden until the row is selected.
                        JS toggles the `is-open` class on the parent row
                        which reveals this block via CSS.
                      {%- endcomment -%}
                      <div class="pm-pdp__bundle-expand">
                        <div class="pm-pdp__bundle-qty-wrap">
                          <span class="pm-pdp__bundle-qty-label">Quantity</span>
                          <div class="pm-pdp__bundle-qty">
                            <button type="button" data-pm-bundle-qty="-1" aria-label="Decrease bundle quantity">−</button>
                            <input type="number" min="1" value="1" data-pm-bundle-qty-input aria-label="Bundle quantity">
                            <button type="button" data-pm-bundle-qty="1" aria-label="Increase bundle quantity">+</button>
                          </div>
                          {%- if _bundle_max_qty -%}
                            <span class="pm-pdp__bundle-qty-cap">of {{ _bundle_max_qty }}</span>
                          {%- endif -%}
                        </div>
                        <div class="pm-pdp__bundle-addon">
                          <div class="pm-pdp__bundle-addon-label">Add-on</div>
                          <div class="pm-pdp__bundle-addon-total" data-pm-bundle-addon-total>+{{ _ref_v.price | money }}</div>
                        </div>
                      </div>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if product.has_only_default_variant == false -%}
            {%- comment -%}
              Bundle-named options are NOT rendered as dropdowns — the bundle
              card above owns that choice (the migrated "Bundle and get 3% off"
              option would otherwise render a duplicate, confusing select).
              The variants JSON island still renders so the bundle JS can map
              qty -> "(Pack of N)" variant for BC-parity pricing.
            {%- endcomment -%}
            {%- assign _visible_opt_count = 0 -%}
            {%- for option in product.options_with_values -%}
              {%- assign _odn = option.name | downcase -%}
              {%- unless _odn contains 'bundle' -%}{%- assign _visible_opt_count = _visible_opt_count | plus: 1 -%}{%- endunless -%}
            {%- endfor -%}
            {%- if _hp_wizard -%}{%- render 'pm-hp-wizard', product: product -%}{%- endif -%}
            {%- if _visible_opt_count > 0 -%}
            <div class="pm-pdp__options" id="pm-pdp-options"{% if _hp_wizard %} hidden{% endif %}>
              {%- comment -%} hidden when the HP wizard owns the UI — the selects stay as the variant-switch source of truth {%- endcomment -%}
              {%- for option in product.options_with_values -%}
                {%- assign _odn = option.name | downcase -%}
                {%- unless _odn contains 'bundle' -%}
                <div class="pm-pdp__option">
                  <label class="pm-pdp__option-label">{{ option.name }}</label>
                  <select data-pm-pdp-option="{{ forloop.index0 }}">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
                {%- endunless -%}
              {%- endfor -%}
            </div>
            {%- endif -%}
            <script type="application/json" id="pm-pdp-variants">
              {{ product.variants | json }}
            </script>
          {%- endif -%}

          <div class="pm-pdp__avail-label">Availability</div>
          {%- comment -%} Dropship items (vendor/distributor-fulfilled — the HP SLED batch, or anything tagged `dropship`) hold a placeholder qty, not real shelf stock, so they show plain "In stock" with no count. {%- endcomment -%}
          {%- assign _dropship = false -%}
          {%- if product.tags contains 'HP-SLED-2026' or product.tags contains 'dropship' -%}{%- assign _dropship = true -%}{%- endif -%}
          {%- if _instock -%}
            <div class="pm-pdp__avail pm-pdp__avail--in" data-pm-pdp-avail{% if _dropship %} data-dropship{% endif %}{% if _hp_wizard %} data-hp-wizard{% endif %}>
              {%- comment -%} Show the real count whenever there's a tracked qty > 0 — not only DENY — so variants flipped to CONTINUE (Shopify inventory-desync workaround) still show "N in stock". The special configure-your-system HP products say "Available" instead (Anuj) — scoped to _hp_wizard only, everything else unchanged. {%- endcomment -%}
              {%- if _hp_wizard -%}
                Available
              {%- elsif _dropship == false and _v.inventory_management == 'shopify' and _stock and _stock > 0 -%}
                {{ _stock }} in stock
              {%- else -%}
                In stock
              {%- endif -%}
            </div>
          {%- else -%}
            <div class="pm-pdp__avail pm-pdp__avail--out" data-pm-pdp-avail>Out of stock</div>
          {%- endif -%}

          <label for="pm-pdp-qty" class="pm-pdp__qty-label">Quantity:</label>
          <div class="pm-pdp__qty">
            <button type="button" class="pm-pdp__qty-btn" data-pm-pdp-qty="-1" aria-label="Decrease quantity">−</button>
            <input type="number" id="pm-pdp-qty" value="1" min="1" step="1" aria-label="Quantity">
            <button type="button" class="pm-pdp__qty-btn" data-pm-pdp-qty="1" aria-label="Increase quantity">+</button>
          </div>

          {%- if _is_bulk -%}
          <div class="pm-bulk" data-pm-bulk data-bulk-tiers="[[10,19,10],[20,29,20],[30,0,30]]">
            <button type="button" class="pm-bulk__btn" data-pm-bulk-open aria-haspopup="dialog" aria-controls="pm-bulk-modal">
              <span class="pm-bulk__ico" aria-hidden="true">
                <svg class="pm-bulk__ico-bag" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h18l-1.5 10.5a2 2 0 0 1-2 1.5H6.5a2 2 0 0 1-2-1.5L3 9Z"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg>
                <svg class="pm-bulk__ico-ck" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <span class="pm-bulk__txt" aria-live="polite">
                <span class="pm-bulk__t1" data-pm-bulk-t1>Buy in bulk and save</span>
                <span class="pm-bulk__t2" data-pm-bulk-t2>Up to 30% off</span>
              </span>
              <svg class="pm-bulk__chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
          {%- endif -%}

          {%- if _instock -%}
            {%- comment -%} TC-084: inventory cap so JS disables the button when the cart holds every available unit. {%- endcomment -%}
            {%- assign _pdp_maxq = '' -%}
            {%- comment -%} Cap the stepper at on-hand stock for ANY tracked variant with a positive count — DENY (hard ceiling) and CONTINUE alike. The CONTINUE case is the AAAwave inventory-desync workaround variant, which must still cap at its real count, matching the "N in stock" line above. Same gate as the availability display so the two never disagree. {%- endcomment -%}
            {%- if _v.inventory_management == 'shopify' and _stock and _stock > 0 -%}{%- assign _pdp_maxq = _stock -%}{%- endif -%}
            <button
              type="button"
              class="pm-pdp__cta pm-pdp__cta--cart"
              data-pm-add
              data-pm-pdp-add
              data-variant-id="{{ _v.id }}"
              data-variant-sku="{{ _sku | escape }}"
              {% if _pdp_maxq != '' %}data-max-qty="{{ _pdp_maxq }}"{% endif %}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              <span>Add to Cart</span>
            </button>
          {%- endif -%}

          <button
            type="button"
            class="pm-pdp__cta pm-pdp__cta--ghost"
            data-pm-add-to-list-trigger
            data-default-label="Add to List"
            data-item-sku="{{ _sku | escape }}"
            data-item-name="{{ product.title | escape }}"
            data-item-brand="{{ product.vendor | escape }}"
            data-item-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 200 }}{% endif %}"
            data-item-price="{{ _v.price | money }}"
            data-item-href="{{ product.url }}"
            aria-haspopup="menu"
            aria-expanded="false"
          >
            <svg data-pm-add-icon-plus width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            <svg data-pm-add-icon-star width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="0" aria-hidden="true" style="display:none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <span data-pm-add-to-list-label>Add to List</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="pm-pdp__cta-caret"><polyline points="6 9 12 15 18 9"/></svg>
          </button>

          {%- comment -%}
            ── Request a Quote (Quotify) ──
            Quotify's quote-request trigger. The Quotify app embed (enabled in
            config/settings_data.json) loads the script that binds to
            [data-quotify] and opens the quote form / adds to the Quotify quote
            cart. Replaces the old localStorage Add-to-Quote (pm-quote.js).
            Keeps the PM CTA classes so it matches the other PDP actions.
          {%- endcomment -%}
          {%- assign _quote_btn_class = 'pm-pdp__cta pm-pdp__cta--ghost' -%}
          {%- assign _quote_svg_size  = '14' -%}
          {%- unless _instock -%}
            {%- assign _quote_btn_class = 'pm-pdp__cta pm-pdp__cta--quote' -%}
            {%- assign _quote_svg_size  = '15' -%}
          {%- endunless -%}
          {%- comment -%}
            This theme adds to cart via fetch('/cart/add.js') — there's no
            product <form>. Quotify's button is expected inside a product form,
            so wrap it in a no-op form (no action, never submits, display:contents
            so layout is unaffected) to give Quotify's script a form to anchor to.
          {%- endcomment -%}
          <form class="pm-quotify-form" onsubmit="return false;">
            <input type="hidden" name="id" value="{{ _v.id }}">
            <button
              type="button"
              class="{{ _quote_btn_class }} quotify-request-quote-btn"
              data-quotify
              data-pm-pdp-quote
              data-product-id="{{ product.id }}"
              data-variant="{{ _v.id }}"
              data-product="{{ product | json | escape }}"
              aria-label="Request a quote for {{ product.title | escape }}"
            >
              <svg width="{{ _quote_svg_size }}" height="{{ _quote_svg_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
              <span>Request a Quote</span>
            </button>
          </form>

          {%- comment -%} ── HPE ProLiant configurator (stepped wizard, ProLiant only) — PAUSED for launch; gated by _hpe_enabled (set at top of section). Re-enable there. ── {%- endcomment -%}
          {%- if _hpe_enabled -%}{%- render 'pm-hpe-config', product: product -%}{%- endif -%}

          {%- comment -%} ── HP procurement data panel — gated by _hp_procurement_card (top of section). Currently OFF per Anuj. ── {%- endcomment -%}
          {%- if _hp_procurement_card -%}
            {%- render 'pm-hp-config', product: product -%}
          {%- endif -%}

          {%- comment -%}
            ── Download datasheet (PDF) ──
            Client-side jsPDF build. Reads the #pm-pdp-pdf-data JSON
            island and composes a branded one-/multi-page PDF with the
            product's title, image, price, SKU/MPN/UPC, description,
            key features, and full specs table. No vendor dependencies,
            no Google search — the PDF is self-contained so buyers
            can forward it to procurement / IT teams.
          {%- endcomment -%}
          <div class="pm-pdp__cta-row">
          <button
            type="button"
            class="pm-pdp__cta pm-pdp__cta--ghost pm-pdp__cta--pdf"
            data-pm-pdp-pdf
            aria-label="Download {{ product.title | escape }} datasheet as PDF"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <polyline points="9 14 12 17 15 14"/>
              <line x1="12" y1="11" x2="12" y2="17"/>
            </svg>
            <span data-pm-pdp-pdf-label>Download datasheet (PDF)</span>
          </button>

          {%- comment -%}
            ── Email / share this product ──
            Plain mailto: link prefilled with title, price and the absolute
            product URL. No backend, works in any mail client. url_encode
            uses '+' for spaces, which mailto bodies render literally — so
            we swap '+' → '%20' (literal '+' chars are already '%2B').
          {%- endcomment -%}
          {%- capture _share_subject -%}{{ shop.name }}: {{ product.title }}{%- endcapture -%}
          {%- capture _share_body -%}I thought you might be interested in this product from {{ shop.name }}:
{{ product.title }} — {{ _v.price | money }}
{% if _sku != blank %}SKU: {{ _sku }}
{% endif %}{{ shop.url }}{{ product.url }}{%- endcapture -%}
          <a
            class="pm-pdp__cta pm-pdp__cta--ghost pm-pdp__cta--share"
            href="mailto:?subject={{ _share_subject | url_encode | replace: '+', '%20' }}&body={{ _share_body | url_encode | replace: '+', '%20' }}"
            aria-label="Share {{ product.title | escape }} by email"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"/>
              <path d="M3 7l9 6 9-6"/>
            </svg>
          </a>
          </div>

          <label class="pm-pdp__compare">
            <input type="checkbox" data-pm-compare data-product-handle="{{ product.handle }}">
            <span>Compare</span>
          </label>
        </aside>
      </div>

      {%- comment -%} ── Config products only: Description + Specs flow in the wide left column (CDW-style) ── {%- endcomment -%}
      {%- if _cfg -%}{%- render 'pm-pdp-detail-block', product: product, features: _features, spec_pairs: _spec_pairs, spec_count: _spec_count -%}{%- endif -%}

    </div>
  </div>

  {%- comment -%}
    ── Recommendations mount — built once, placed by stock state ──
    Fallback collection = first non-utility collection the product belongs to,
    used to top up the rail when Shopify's related set is thin (e.g.
    freshly-imported HPE servers).
    QUOTE-ONLY products emit the mount HERE — directly under the buy area,
    before Description — headed "Similar items you can buy now" with
    data-prefer-available (pm-recommendations.js sorts purchasable cards
    first), so a price-shopper landing from Google sees buyable alternatives
    before bouncing. The buy-area jump link targets #pm-recs-anchor.
    That heading is a claim about the rail's contents, so pm-recommendations.js
    reverts it to "You may also like" if no purchasable card ends up in it.
    IN-STOCK products emit the mount in its original spot below the specs
    with the original heading — markup identical to before this feature.
  {%- endcomment -%}
  {%- assign _rec_fbcol = '' -%}
  {%- for c in product.collections -%}
    {%- unless c.handle == 'all' or c.handle == 'frontpage' or c.handle contains 'bundle' -%}
      {%- if _rec_fbcol == '' -%}{%- assign _rec_fbcol = c.handle -%}{%- endif -%}
    {%- endunless -%}
  {%- endfor -%}
  {%- capture _recs_mount -%}
  <div
    {% unless _instock %}id="pm-recs-anchor" class="pm-recs-early" data-prefer-available="1" {% endunless %}data-pm-recs
    data-product-id="{{ product.id }}"
    data-vendor="{{ product.vendor | escape }}"
    data-title="{{ product.title | escape }}"
    data-intent="related"
    data-limit="10"
    data-heading="{% if _instock %}You may also like{% else %}Similar items you can buy now{% endif %}"
    data-fallback-collection="{{ _rec_fbcol }}"
  ></div>
  {%- endcapture -%}
  {%- unless _instock -%}{{ _recs_mount }}{%- endunless -%}

  {%- comment -%} ── Description ‖ Specifications ─────────────────────────── {%- endcomment -%}
  {%- comment -%} Non-config products keep the original full-width Description/Specs band here ── {%- endcomment -%}
  {%- unless _cfg -%}
  <section id="pm-product-description" class="pm-pdp__longblock">
    <div class="pm-container pm-pdp__longblock-inner">
      <div class="pm-pdp__longgrid">

        {%- comment -%} ── Description (wider, left) ─────────────────────── {%- endcomment -%}
        <div class="pm-pdp__desc-col">
          <h2 class="pm-pdp__h2">Description</h2>
          {%- if product.description != blank -%}
            <div class="pm-pdp__desc-body rte">{{ product.description }}</div>
            {%- comment -%}
              Hide broken inline images in the migrated description. Some BigCommerce
              descriptions embedded images hosted on BC's CDN that weren't rehosted
              during migration, so they 404 and render a broken-image icon. This
              hides any description image that fails to load (already-failed on parse,
              OR fails later). Storefront-side cosmetic mask only — the description
              HTML itself is untouched.
            {%- endcomment -%}
            <script>
              (function () {
                var imgs = document.querySelectorAll('.pm-pdp__desc-body img');
                for (var i = 0; i < imgs.length; i++) {
                  (function (img) {
                    var hide = function () { img.style.display = 'none'; };
                    if (img.complete && img.naturalWidth === 0) { hide(); }
                    img.addEventListener('error', hide);
                  })(imgs[i]);
                }
              })();
            </script>
          {%- else -%}
            <p class="pm-pdp__empty">
              A long-form description for this part is not yet published.
              Reach out to your account manager for spec sheets and
              configuration guidance.
            </p>
          {%- endif -%}

          {%- if _features.size > 0 -%}
            <div class="pm-pdp__features">
              <div class="pm-pdp__features-eyebrow">Key features</div>
              <ul class="pm-pdp__features-list">
                {%- for f in _features -%}
                  {%- assign _ft = f | strip -%}
                  {%- if _ft != blank -%}
                    <li>
                      <span class="pm-pdp__glance-dot" aria-hidden="true"></span>
                      <span>{{ _ft | escape }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%}
          ── Specifications (narrower, right) ──
          HP grouped sheet takes priority (server-rendered, static, no JS —
          see _has_hp_specsheet above). Otherwise: server-side render uses
          metafields when available; when they aren't (Hydrogen ships specs
          in a separate sidecar JSON, not metafields), JS hydrates this
          section from the bundled pm-product-specs.json asset using
          `data-pm-pdp-handle`. The two paths never both render.
        {%- endcomment -%}
        {%- if _has_hp_specsheet -%}
        <div class="pm-pdp__specs-col">
          <div class="pm-pdp__specs-head">
            <h2 class="pm-pdp__h2">Specifications</h2>
          </div>
          {%- comment -%}
            Truncate by GROUP, not row — cutting a group off mid-list would
            show a header with only some of its specs, which reads as
            broken. First 3 groups visible, rest behind a "Show N more"
            toggle. Pure CSS checkbox-hack (no JS): the input must be a
            DOM-earlier sibling of both the extra groups and the label for
            `~` to reach them, but `hidden` removes it from layout so the
            visual order (groups, then the toggle) is unaffected.
          {%- endcomment -%}
          {%- assign _sheet_group_count = 0 -%}
          {%- for _section in _hp_spec_sheet -%}{%- if _section.rows.size > 0 -%}{%- assign _sheet_group_count = _sheet_group_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
          {%- assign _sheet_visible_groups = 3 -%}
          <div class="pm-pdp__specsheet">
            {%- if _sheet_group_count > _sheet_visible_groups -%}
              <input type="checkbox" id="pm-specsheet-toggle-{{ product.id }}" class="pm-pdp__specsheet-toggle-input" hidden>
            {%- endif -%}
            {%- assign _gi = 0 -%}
            {%- for _section in _hp_spec_sheet -%}
              {%- if _section.rows.size > 0 -%}
                {%- assign _gi = _gi | plus: 1 -%}
                <div class="pm-pdp__specsheet-group{% if _gi > _sheet_visible_groups %} is-extra{% endif %}">
                  <h3 class="pm-pdp__specsheet-group-h">{{ _section.group }}</h3>
                  <div class="pm-pdp__specs">
                    {%- for _row in _section.rows -%}
                      {%- if _row.label != blank and _row.value != blank -%}
                        <div class="pm-pdp__spec-row">
                          <dt class="pm-pdp__spec-key">{{ _row.label }}</dt>
                          <dd class="pm-pdp__spec-val">{{ _row.value }}</dd>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
            {%- if _sheet_group_count > _sheet_visible_groups -%}
              {%- assign _sheet_extra_groups = _sheet_group_count | minus: _sheet_visible_groups -%}
              <label for="pm-specsheet-toggle-{{ product.id }}" class="pm-pdp__specs-toggle pm-pdp__specsheet-toggle-label">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><polyline points="6 9 12 15 18 9"/></svg>
                <span class="pm-pdp__specsheet-toggle-more">Show {{ _sheet_extra_groups }} more section{% if _sheet_extra_groups != 1 %}s{% endif %}</span>
                <span class="pm-pdp__specsheet-toggle-less">Show fewer specs</span>
              </label>
            {%- endif -%}
          </div>
        </div>
        {%- else -%}
        <div
          class="pm-pdp__specs-col"
          data-pm-pdp-handle="{{ product.handle }}"
          data-pm-pdp-specs-asset="{{ 'pm-product-specs.json' | asset_url }}"
        >
          <div class="pm-pdp__specs-head">
            <h2 class="pm-pdp__h2">Specifications</h2>
            <span
              class="pm-pdp__specs-count"
              data-pm-pdp-specs-count
              {% if _spec_count == 0 %}hidden{% endif %}
            >
              {%- if _spec_count > 0 -%}{{ _spec_count }} {% if _spec_count == 1 %}spec{% else %}specs{% endif %}{%- endif -%}
            </span>
          </div>

          <dl
            class="pm-pdp__specs"
            data-pm-pdp-specs
            data-total="{{ _spec_count }}"
            {% if _spec_count == 0 %}hidden{% endif %}
          >
            {%- assign _i = 0 -%}
            {%- for pair in _spec_pairs -%}
              {%- assign _p = pair | strip -%}
              {%- if _p == '' -%}{%- continue -%}{%- endif -%}
              {%- unless _p contains '~~KV~~' -%}{%- continue -%}{%- endunless -%}
              {%- assign _kv = _p | split: '~~KV~~' -%}
              {%- assign _nm = _kv[0] | strip -%}
              {%- assign _vl = _kv[1] | strip -%}
              {%- if _nm != '' and _vl != '' -%}
                <div class="pm-pdp__spec-row{% if _i >= 8 %} is-extra{% endif %}" data-pm-pdp-spec-row>
                  <dt class="pm-pdp__spec-key">{{ _nm }}</dt>
                  <dd class="pm-pdp__spec-val">{{ _vl }}</dd>
                </div>
                {%- assign _i = _i | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </dl>

          {%- assign _extra = _spec_count | minus: 8 -%}
          <button
            type="button"
            class="pm-pdp__specs-toggle"
            data-pm-pdp-specs-toggle
            aria-expanded="false"
            {% if _spec_count <= 8 %}hidden{% endif %}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><polyline points="6 9 12 15 18 9"/></svg>
            <span data-pm-pdp-specs-toggle-label>
              {%- if _spec_count > 8 -%}Show {{ _extra }} more {% if _extra == 1 %}spec{% else %}specs{% endif %}{%- endif -%}
            </span>
          </button>

          {%- comment -%} ── HP procurement data (UNSPSC / origin / lifecycle) mounts here, under the specs where reference data belongs — filled by pm-hp-config. OFF per Anuj (_hp_procurement_card). ── {%- endcomment -%}
          {%- if _hp_procurement_card -%}<div data-pm-hp-info></div>{%- endif -%}

          <p
            class="pm-pdp__empty"
            data-pm-pdp-specs-empty
            {% if _spec_count > 0 %}hidden{% endif %}
          >
            Detailed specifications for this part are not yet published.
            Reach out to your account manager — dimensions, voltage,
            capacity, and supported configurations will be confirmed
            within one business day.
          </p>
        </div>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endunless -%}

  {%- comment -%}
    ── "You may also like" — Shopify-native product recommendations ──
    intent=related (powered by the store's own order/behavioral data). The mount is
    empty until pm-recommendations.js lazy-fetches /recommendations/products.json and
    renders PM cards below the specs. Empty result → mount stays 0-height (no section).
    IN-STOCK products only — quote-only products place this mount ABOVE the
    Description band instead (see the _recs_mount capture there).
  {%- endcomment -%}
  {%- if _instock -%}{{ _recs_mount }}{%- endif -%}

  {%- comment -%}
    ── Recently viewed strip ──
    Tracking + render handled by assets/pm-recently-viewed.js. The
    track element stamps the current product's data into data-attrs
    the JS auto-pushes onto the MRU on load. The mount holds the
    rendered horizontal cards; its `data-current-sku` lets the JS
    filter out the current PDP's own item so the strip never shows
    "you're looking at this thing — here, look at it again".
  {%- endcomment -%}
  <div
    data-pm-rv-track
    data-rv-sku="{{ _sku | escape }}"
    data-rv-handle="{{ product.handle }}"
    data-rv-title="{{ product.title | escape }}"
    data-rv-vendor="{{ product.vendor | escape }}"
    data-rv-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 320 }}{% endif %}"
    data-rv-price="{{ _v.price | money }}"
    data-rv-href="{{ product.url }}"
    hidden
  ></div>
  <section class="pm-rv" data-pm-rv-mount data-current-sku="{{ _sku | escape }}" hidden></section>

  {%- if _is_bulk -%}
  {%- comment -%} Bulk discount rates modal — mirrors the 3 automatic discounts on the Bulk Options collection. {%- endcomment -%}
  <div class="pm-bulkmodal" id="pm-bulk-modal" data-pm-bulk-modal role="dialog" aria-modal="true" aria-labelledby="pm-bulk-modal-title" hidden>
    <div class="pm-bulkmodal__backdrop" data-pm-bulk-close></div>
    <div class="pm-bulkmodal__panel" role="document">
      <button type="button" class="pm-bulkmodal__close" data-pm-bulk-close aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
      <div class="pm-bulkmodal__head">
        <span class="pm-bulkmodal__eyebrow">Volume pricing</span>
        <h2 class="pm-bulkmodal__title" id="pm-bulk-modal-title">Bulk discount rates</h2>
        <p class="pm-bulkmodal__lede">The more you order, the more you save. Discounts apply automatically at checkout — no code needed.</p>
      </div>
      <ul class="pm-bulkmodal__tiers">
        <li class="pm-bulkmodal__tier" data-tier-min="10" data-tier-max="19">
          <span class="pm-bulkmodal__range"><strong>10&nbsp;–&nbsp;19</strong> units</span>
          <span class="pm-bulkmodal__pct">10% off</span>
        </li>
        <li class="pm-bulkmodal__tier" data-tier-min="20" data-tier-max="29">
          <span class="pm-bulkmodal__range"><strong>20&nbsp;–&nbsp;29</strong> units</span>
          <span class="pm-bulkmodal__pct">20% off</span>
        </li>
        <li class="pm-bulkmodal__tier" data-tier-min="30" data-tier-max="0">
          <span class="pm-bulkmodal__range"><strong>30+</strong> units</span>
          <span class="pm-bulkmodal__pct">30% off</span>
        </li>
      </ul>
      <p class="pm-bulkmodal__foot">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        Mix isn&rsquo;t required — the discount is based on the quantity of this item in your cart.
      </p>
    </div>
  </div>

  <style>
    /* ── Bulk Options: full-width "buy in bulk and save" strip that morphs into a live savings state ── */
    .pm-bulk{margin-top:14px;border:1px solid #ecdfd6;border-radius:10px;background:linear-gradient(180deg,#fdfaf6,#faf2ea);transition:border-color .18s,background .18s;}
    .pm-bulk__btn{display:flex;align-items:center;gap:11px;width:100%;padding:10px 12px;background:none;border:none;border-radius:10px;text-align:left;cursor:pointer;font-family:var(--pm-font-body);transition:background .15s;}
    .pm-bulk__btn:hover{background:rgba(166,61,47,.05);}
    .pm-bulk__btn:focus-visible{outline:2px solid #c04e3e;outline-offset:2px;}
    .pm-bulk__ico{width:32px;height:32px;flex:none;border-radius:8px;background:#fff;border:1px solid #efe1d7;display:grid;place-items:center;color:#c04e3e;transition:color .18s,border-color .18s;}
    .pm-bulk__ico-ck{display:none;}
    .pm-bulk__txt{flex:1;min-width:0;display:flex;flex-direction:column;gap:1px;}
    .pm-bulk__t1{font:700 12.5px/1.3 var(--pm-font-body);color:var(--pm-ink-900);}
    .pm-bulk__t2{font:500 11.5px/1.3 var(--pm-font-body);color:var(--pm-ink-500);}
    .pm-bulk__chev{flex:none;color:#c9b7a8;transition:color .18s;}
    .pm-bulk.is-active{border-color:#c9ecd6;background:linear-gradient(180deg,#f4fbf7,#e9f6ee);}
    .pm-bulk.is-active .pm-bulk__btn:hover{background:rgba(26,160,94,.06);}
    .pm-bulk.is-active .pm-bulk__ico{color:#1aa05e;border-color:#c9ecd6;}
    .pm-bulk.is-active .pm-bulk__ico-bag{display:none;}
    .pm-bulk.is-active .pm-bulk__ico-ck{display:block;}
    .pm-bulk.is-active .pm-bulk__t1{color:#137a48;}
    .pm-bulk.is-active .pm-bulk__chev{color:#a9d9bd;}

    /* ── Bulk discount rates modal ── */
    .pm-bulkmodal{position:fixed;inset:0;z-index:1200;display:flex;align-items:center;justify-content:center;padding:20px;}
    .pm-bulkmodal[hidden]{display:none;}
    .pm-bulkmodal__backdrop{position:absolute;inset:0;background:rgba(7,21,37,.58);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);animation:pmBulkFade .2s ease;}
    .pm-bulkmodal__panel{position:relative;width:100%;max-width:420px;background:#fff;border-radius:18px;box-shadow:0 24px 70px rgba(7,21,37,.34),0 2px 8px rgba(7,21,37,.12);overflow:hidden;animation:pmBulkRise .26s cubic-bezier(.16,1,.3,1);}
    .pm-bulkmodal__close{position:absolute;top:14px;right:14px;width:32px;height:32px;display:grid;place-items:center;border:none;border-radius:9px;background:rgba(255,255,255,.14);color:#fff;cursor:pointer;transition:background .16s;}
    .pm-bulkmodal__close:hover{background:rgba(255,255,255,.28);}
    .pm-bulkmodal__close:focus-visible{outline:2px solid #fff;outline-offset:2px;}
    .pm-bulkmodal__head{padding:26px 28px 20px;background:linear-gradient(135deg,#0d2340 0%,#12315c 100%);color:#fff;}
    .pm-bulkmodal__eyebrow{display:inline-block;font:700 11px/1 'Inter',system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#e79b8c;margin-bottom:9px;}
    .pm-bulkmodal__title{margin:0 0 8px;font:800 23px/1.15 'Inter',system-ui,sans-serif;letter-spacing:-.01em;}
    .pm-bulkmodal__lede{margin:0;font:400 13.5px/1.55 'Inter',system-ui,sans-serif;color:#c6d0dd;}
    .pm-bulkmodal__tiers{list-style:none;margin:0;padding:14px 16px;display:flex;flex-direction:column;gap:8px;}
    .pm-bulkmodal__tier{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:14px 16px;border:1px solid #eef0f3;border-radius:12px;background:#fbfcfd;transition:border-color .16s,background .16s,box-shadow .16s,transform .16s;}
    .pm-bulkmodal__range{font:500 14.5px/1 'Inter',system-ui,sans-serif;color:#344054;}
    .pm-bulkmodal__range strong{font-weight:800;color:#101828;}
    .pm-bulkmodal__pct{font:800 14px/1 'Inter',system-ui,sans-serif;color:#a63d2f;background:#faeee9;border:1px solid #f0d9d1;padding:7px 12px;border-radius:999px;white-space:nowrap;transition:background .16s,color .16s,border-color .16s;}
    .pm-bulkmodal__tier.is-active{border-color:#1aa05e;background:#f0faf4;box-shadow:0 4px 16px rgba(26,160,94,.15);transform:translateX(2px);}
    .pm-bulkmodal__tier.is-active .pm-bulkmodal__pct{background:#1aa05e;color:#fff;border-color:#1aa05e;}
    .pm-bulkmodal__foot{display:flex;align-items:flex-start;gap:8px;margin:0;padding:4px 24px 24px;font:400 12.5px/1.5 'Inter',system-ui,sans-serif;color:#667085;}
    .pm-bulkmodal__foot svg{color:#1aa05e;flex:none;margin-top:2px;}
    @keyframes pmBulkFade{from{opacity:0;}to{opacity:1;}}
    @keyframes pmBulkRise{from{opacity:0;transform:translateY(14px) scale(.97);}to{opacity:1;transform:none;}}
    @media (prefers-reduced-motion:reduce){.pm-bulkmodal__backdrop,.pm-bulkmodal__panel{animation:none;}.pm-bulk,.pm-bulk__btn,.pm-bulk__ico,.pm-bulk__chev{transition:none;}}
  </style>
  {%- endif -%}
</main>

<script>
(function () {
  // ── Gallery thumbs (click + hover swap) ──
  var main = document.getElementById('pm-pdp-main-img');
  var setActiveThumb = function (target) {
    document.querySelectorAll('[data-pm-pdp-thumb]').forEach(function (b) {
      b.classList.toggle('is-active', b === target);
    });
  };
  document.querySelectorAll('[data-pm-pdp-thumb]').forEach(function (btn) {
    var swap = function () {
      var url = btn.getAttribute('data-pm-pdp-thumb');
      if (main) main.src = url;
      setActiveThumb(btn);
    };
    btn.addEventListener('click', swap);
    btn.addEventListener('mouseenter', swap);
  });


  // ── Hero hover-zoom (Amazon-style, cursor-tracked transform-origin) ──
  // Match the Hydrogen PmProductGallery: 2x scale on the <img>, origin
  // follows the cursor as %. Surrounding frame is overflow:hidden via
  // CSS so the unzoomed area is clipped, no portal / lens needed.
  var frame = document.querySelector('[data-pm-pdp-hero]');
  var zoomImg = document.querySelector('[data-pm-pdp-zoom]');
  if (frame && zoomImg) {
    var ZOOM = 2;
    var clamp = function (n) { return Math.max(0, Math.min(100, n)); };
    frame.addEventListener('mouseenter', function () {
      zoomImg.style.transform = 'scale(' + ZOOM + ')';
      frame.style.cursor = 'zoom-out';
    });
    frame.addEventListener('mouseleave', function () {
      zoomImg.style.transform = 'scale(1)';
      zoomImg.style.transformOrigin = '50% 50%';
      frame.style.cursor = 'zoom-in';
    });
    frame.addEventListener('mousemove', function (e) {
      var r = frame.getBoundingClientRect();
      var x = clamp(((e.clientX - r.left) / r.width) * 100);
      var y = clamp(((e.clientY - r.top) / r.height) * 100);
      zoomImg.style.transformOrigin = x + '% ' + y + '%';
    });
    frame.style.cursor = 'zoom-in';
  }

  // ── Quantity ± buttons — capped at available stock; signal Request-a-Quote ──
  var qty = document.getElementById('pm-pdp-qty');
  var pdpAddBtn   = document.querySelector('[data-pm-pdp-add]');
  var pdpQuoteBtn = document.querySelector('[data-pm-pdp-quote]');
  var pdpIncBtn   = document.querySelector('[data-pm-pdp-qty="1"]');

  // Single owner of the "orange Request a Quote" signal: ON when the shopper has
  // selected every available unit (stepper at the cap) OR the cart already holds
  // all available units (add button maxed). data-max-qty = available stock.
  window.pmUpdatePdpQuoteSignal = function () {
    if (!pdpQuoteBtn) return;
    var max = pdpAddBtn ? parseInt(pdpAddBtn.getAttribute('data-max-qty'), 10) : NaN;
    var atStepMax = !isNaN(max) && max >= 1 && (parseInt(qty && qty.value, 10) || 1) >= max;
    var cartMaxed = !!(pdpAddBtn && pdpAddBtn.classList.contains('is-maxed'));
    pdpQuoteBtn.classList.toggle('is-quote-wanted', atStepMax || cartMaxed);
  };

  function clampPdpQty() {
    if (!qty) return;
    var max = pdpAddBtn ? parseInt(pdpAddBtn.getAttribute('data-max-qty'), 10) : NaN;
    var v = Math.max(1, parseInt(qty.value, 10) || 1);
    if (!isNaN(max) && max >= 1 && v > max) v = max;   // never exceed available stock
    qty.value = v;
    if (pdpIncBtn && !isNaN(max) && max >= 1) pdpIncBtn.disabled = v >= max;
    window.pmUpdatePdpQuoteSignal();
  }

  document.querySelectorAll('[data-pm-pdp-qty]').forEach(function (b) {
    b.addEventListener('click', function () {
      var d = parseInt(b.getAttribute('data-pm-pdp-qty'), 10) || 0;
      qty.value = Math.max(1, (parseInt(qty.value, 10) || 1) + d);
      clampPdpQty();
    });
  });
  if (qty) {
    qty.addEventListener('input', clampPdpQty);
    qty.addEventListener('change', clampPdpQty);
    clampPdpQty();
  }

  // ── Variant selection (updates variant id, availability, image, price) ──
  var variantsEl = document.getElementById('pm-pdp-variants');
  var addBtn     = document.querySelector('[data-pm-pdp-add]');
  if (variantsEl) {
    var variants = [];
    try { variants = JSON.parse(variantsEl.textContent); } catch (e) {}
    var moneyFmt = function (cents) {
      try {
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD' }).format(cents / 100);
      } catch (e) { return '$' + (cents / 100).toFixed(2); }
    };
    document.querySelectorAll('[data-pm-pdp-option]').forEach(function (sel) {
      sel.addEventListener('change', function () {
        var chosen = Array.from(document.querySelectorAll('[data-pm-pdp-option]')).map(function (s) { return s.value; });
        var match = variants.find(function (v) {
          return chosen.every(function (c, i) { return v['option' + (i + 1)] === c; });
        });
        if (!match) return;

        // Update SKU + price
        var skuEl = document.getElementById('pm-pdp-sku');
        if (skuEl && match.sku) skuEl.textContent = match.sku;
        var priceEl = document.getElementById('pm-pdp-price');
        if (priceEl && typeof match.price === 'number') priceEl.textContent = moneyFmt(match.price);
        // Keep the compare-at "was" price + Sale flag in sync with the chosen variant
        // (otherwise the initial-render sale state stays stale across variant switches).
        var priceMeta = document.querySelector('[data-pm-pdp-price-meta]');
        var onSale = typeof match.compare_at_price === 'number' && match.compare_at_price > match.price;
        if (priceEl) priceEl.classList.toggle('pm-pdp__price--sale', onSale);
        if (priceMeta) {
          if (onSale) {
            priceMeta.removeAttribute('hidden');
            var wasEl = priceMeta.querySelector('.pm-pdp__price-was');
            if (wasEl) wasEl.textContent = moneyFmt(match.compare_at_price);
          } else {
            priceMeta.setAttribute('hidden', '');
          }
        }

        // Update hero image
        if (match.featured_image && main) {
          main.src = match.featured_image.src;
        }

        // Update availability badge
        var availEl = document.querySelector('[data-pm-pdp-avail]');
        if (availEl) {
          if (!match.available) {
            availEl.className = 'pm-pdp__avail pm-pdp__avail--out';
            availEl.textContent = 'Out of stock';
          } else if (availEl.hasAttribute('data-hp-wizard')) {
            // special configure-your-system HP products always say "Available" (Anuj)
            availEl.className = 'pm-pdp__avail pm-pdp__avail--in';
            availEl.textContent = 'Available';
          } else if (!availEl.hasAttribute('data-dropship') && match.inventory_management === 'shopify' && typeof match.inventory_quantity === 'number' && match.inventory_quantity > 0) {
            // dropship items (data-dropship, set server-side) never show a count — the qty is a placeholder
            availEl.className = 'pm-pdp__avail pm-pdp__avail--in';
            availEl.textContent = match.inventory_quantity.toLocaleString() + ' in stock';
          } else {
            availEl.className = 'pm-pdp__avail pm-pdp__avail--in';
            availEl.textContent = 'In stock';
          }
        }

        // Wire the cart button to the new variant
        if (addBtn) {
          addBtn.setAttribute('data-variant-id', match.id);
          addBtn.setAttribute('data-variant-sku', match.sku || '');
          // TC-084: keep the inventory cap in sync with the chosen variant. Cap at the
          // real count for ANY tracked variant with stock > 0 — DENY and CONTINUE alike —
          // so it matches the "N in stock" line and the server-rendered data-max-qty.
          if (match.inventory_management === 'shopify' && typeof match.inventory_quantity === 'number' && match.inventory_quantity > 0) {
            addBtn.setAttribute('data-max-qty', match.inventory_quantity);
          } else {
            addBtn.removeAttribute('data-max-qty');
          }
          addBtn.classList.remove('is-maxed');
          delete addBtn.dataset.origLabel;
          if (match.available) {
            addBtn.removeAttribute('disabled');
            var lbl = addBtn.querySelector('span');
            if (lbl) lbl.textContent = 'Add to Cart';
          } else {
            addBtn.setAttribute('disabled', '');
          }
          // Re-evaluate against the current cart (may already be maxed).
          if (window.PmAddToCart && window.PmAddToCart.syncMaxed) window.PmAddToCart.syncMaxed();
        }

        // Keep the bundle base price in sync with the chosen variant so the
        // displayed bundle total reflects the newly selected variant's price.
        if (bundleRoot && typeof match.price === 'number') {
          bundleRoot.setAttribute('data-base-price-cents', match.price);
          recomputeBundlePrice();
        }
      });
    });
  }

  // ─────────────────────────────────────────────────────────────────
  // BUNDLE MODIFIERS — 1:1 port of Hydrogen pm-bundle-options
  // ─────────────────────────────────────────────────────────────────
  // Reads the `pmb.*` metafields rendered into data-attrs on the
  // .pm-pdp__bundle root. Tracks selected add-on + its quantity, and
  // recomputes the live PDP price as:
  //   discounted base + (addOnPrice × qty)
  // On Add-to-Cart, the picked add-on is appended as a second cart
  // line so checkout sees both base and add-on as discrete items.
  var bundleRoot = document.querySelector('[data-pm-pdp-bundle]');
  var bundleState = { row: null }; // selected row element, null = None
  var bundleNote  = document.querySelector('[data-pm-pdp-bundle-note]');
  var priceEl     = document.getElementById('pm-pdp-price');

  function moneyFmt(cents) {
    try {
      return new Intl.NumberFormat(undefined, {
        style: 'currency',
        currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'USD'
      }).format(cents / 100);
    } catch (e) { return '$' + (cents / 100).toFixed(2); }
  }

  function basePriceCents() {
    if (!bundleRoot) return null;
    return parseInt(bundleRoot.getAttribute('data-base-price-cents'), 10) || 0;
  }
  function bundleMaxQty() {
    if (!bundleRoot) return null;
    var m = parseInt(bundleRoot.getAttribute('data-max-qty'), 10);
    return isNaN(m) ? null : m;
  }
  function getRowQty(row) {
    if (!row) return 0;
    var input = row.querySelector('[data-pm-bundle-qty-input]');
    return input ? Math.max(1, parseInt(input.value, 10) || 1) : 1;
  }
  function getRowAddOnCents(row) {
    if (!row) return 0;
    return parseInt(row.getAttribute('data-add-on-price-cents'), 10) || 0;
  }

  // Picked add-on as { variantId, sku, name, qty, lineQty, lineCents } or null.
  // qty = drives the buyer chose (drives the base-variant mapping);
  // lineQty/variantId = the actual cart line: qty 1 -> the single drive,
  // qty N>=2 -> ONE unit of the "Pack of N" product (BC parity pricing).
  function currentBundlePick() {
    if (!bundleRoot || !bundleState.row) return null;
    var row = bundleState.row;
    if (row.getAttribute('data-value-id') === 'none') return null;
    var qty = getRowQty(row);
    var tier = (qty >= 2 && bundleTiers[qty]) ? bundleTiers[qty] : null;
    if (tier) {
      return {
        variantId: tier.variantId,
        sku:       tier.sku,
        name:      tier.title || (row.getAttribute('data-add-on-name') + ' (Pack of ' + qty + ')'),
        qty:       qty,
        lineQty:   1,
        unitCents: tier.price,
        lineCents: tier.price
      };
    }
    var unitCents = getRowAddOnCents(row);
    return {
      variantId: row.getAttribute('data-add-on-variant-id'),
      sku:       row.getAttribute('data-add-on-sku'),
      name:      row.getAttribute('data-add-on-name'),
      qty:       qty,
      lineQty:   qty,
      unitCents: unitCents,
      lineCents: unitCents * qty
    };
  }

  // ── BC-parity variant map ──
  // Migrated bundle products carry variants titled "(Pack of N)" whose
  // price IS the base at the bundle discount (that's how BigCommerce
  // charged it). Map add-on qty -> variant so the discount is genuinely
  // charged at checkout — no synthetic % math on the client.
  var bundleBaseVariant = null; // plain variant = full base price ("None")
  var bundlePackMap = null;     // { n: "(Pack of N)" variant } = 3%-off base
  (function buildBundleVariantMap() {
    if (!bundleRoot) return;
    var el = document.getElementById('pm-pdp-variants');
    if (!el) return;
    var vs = [];
    try { vs = JSON.parse(el.textContent); } catch (e) {}
    if (!vs.length) return;
    var map = {}, sawPack = false, single = null;
    vs.forEach(function (v) {
      var t = [v.option1, v.option2, v.option3, v.title].filter(Boolean).join(' ');
      var m = t.match(/pack of (\d+)/i);
      if (m) { sawPack = true; map[parseInt(m[1], 10)] = v; }
      else if (!single) single = v;
    });
    if (!sawPack) return; // not a migrated bundle-variant product
    bundleBaseVariant = single || null;
    bundlePackMap = map;
  })();
  // The variant whose price is what BigCommerce charges for the base:
  // no pick -> full base; ANY pick -> the 3%-off base (BC discounts the
  // base on single-drive picks too — verified against BC's own pricing
  // endpoint). Exact pack match wins; otherwise the cheapest pack
  // variant carries the same discounted base price.
  function bundleChargeVariant(hasPick, qtyWanted) {
    if (!bundlePackMap) return null;
    if (!hasPick) return bundleBaseVariant;
    if (bundlePackMap[qtyWanted]) return bundlePackMap[qtyWanted];
    var cheapest = null;
    Object.keys(bundlePackMap).forEach(function (k) {
      var v = bundlePackMap[k];
      if (!cheapest || v.price < cheapest.price) cheapest = v;
    });
    return cheapest || bundleBaseVariant;
  }
  // Point the form + add button at the charged variant.
  function syncBundleVariant(v) {
    if (!v) return;
    if (addBtn) {
      addBtn.setAttribute('data-variant-id', v.id);
      addBtn.setAttribute('data-variant-sku', v.sku || '');
    }
    var idInput = document.querySelector('.pm-pdp__cart-form input[name="id"], form input[name="id"]');
    if (idInput) idInput.value = v.id;
  }

  // ── BC-parity add-on tiers ──
  // BigCommerce's pick lists sell the multi-drive choices as their own
  // "Pack of N" PRODUCTS at their own (higher) prices — migrated into
  // Shopify as real products (SKUs CCWDS400T4B0EX2..X6). qty 1 adds the
  // single drive; qty N>=2 adds the Pack-of-N product, so the charged
  // total matches BC exactly. Resolved at runtime from the storefront
  // (products must be published); until a pack resolves, qty N falls
  // back to N x single drive.
  var BUNDLE_TIER_HANDLES = {
    2: 'wd-4tb-wd-blue-sn5000-nvme-internal-solid-state-drive-ssd-pcie-gen-4-0-m-2-2280-up-to-5-500-mb-s-pack-of-2',
    3: 'wd-4tb-wd-blue-sn5000-nvme-internal-solid-state-drive-ssd-pcie-gen-4-0-m-2-2280-up-to-5-500-mb-s-pack-of-3',
    4: 'wd-4tb-wd-blue-sn5000-nvme-internal-solid-state-drive-ssd-pcie-gen-4-0-m-2-2280-up-to-5-500-mb-s-pack-of-4',
    5: 'wd-4tb-wd-blue-sn5000-nvme-internal-solid-state-drive-ssd-pcie-gen-4-0-m-2-2280-up-to-5-500-mb-s-pack-of-5',
    6: 'wd-4tb-wd-blue-sn5000-nvme-internal-solid-state-drive-ssd-pcie-gen-4-0-m-2-2280-up-to-5-500-mb-s-pack-of-6'
  };
  var bundleTiers = {}; // n -> { variantId, price, sku, title }
  (function loadBundleTiers() {
    if (!bundlePackMap) return; // only migrated bundle products use tiers
    Object.keys(BUNDLE_TIER_HANDLES).forEach(function (n) {
      fetch('/products/' + BUNDLE_TIER_HANDLES[n] + '.js')
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (p) {
          if (!p || !p.variants || !p.variants.length) return;
          bundleTiers[n] = {
            variantId: p.variants[0].id,
            price: p.variants[0].price,
            sku: p.variants[0].sku || '',
            title: p.title || ''
          };
          recomputeBundlePrice(); // refresh totals once the tier resolves
        })
        .catch(function () {});
    });
  })();

  function recomputeBundlePrice() {
    if (!bundleRoot || !priceEl) return;
    var pick = currentBundlePick();
    var hasPick = !!pick;
    // Charged base = the mapped variant's price (BC parity: "(Pack of N)"
    // variants already hold the discounted base; the plain variant holds
    // full base for "None"). Without a map, base + add-ons at full price —
    // exactly what checkout charges. No client-side % discounting.
    var mv = bundleChargeVariant(hasPick, hasPick ? pick.qty : 1);
    if (mv) syncBundleVariant(mv);
    var baseAfter = mv ? mv.price : basePriceCents();
    var addOn     = hasPick ? pick.lineCents : 0;
    priceEl.textContent = moneyFmt(baseAfter + addOn);
    if (bundleNote) {
      if (hasPick) bundleNote.removeAttribute('hidden');
      else bundleNote.setAttribute('hidden', '');
    }
    // Update the per-row add-on total label.
    if (hasPick) {
      var row = bundleState.row;
      var totalEl = row.querySelector('[data-pm-bundle-addon-total]');
      if (totalEl) totalEl.textContent = '+' + moneyFmt(pick.lineCents);
    }
  }

  function selectBundleRow(row) {
    if (!bundleRoot) return;
    bundleRoot.querySelectorAll('[data-pm-bundle-row]').forEach(function (r) {
      var on = r === row;
      r.classList.toggle('is-selected', on);
      var btn = r.querySelector('[data-pm-bundle-select]');
      if (btn) {
        btn.setAttribute('aria-checked', on ? 'true' : 'false');
        btn.setAttribute('tabindex', on ? '0' : '-1'); // a11y: roving tabindex
      }
    });
    bundleState.row = row;
    recomputeBundlePrice();
  }

  if (bundleRoot) {
    // Default selection = "None" row, already marked .is-selected server-side.
    bundleState.row = bundleRoot.querySelector('[data-pm-bundle-row].is-selected');

    // Normalize price + charged variant to the mapped base ("None" = the
    // full-price variant) in case the server-rendered default differs.
    recomputeBundlePrice();

    // a11y: roving tabindex — only the checked radio is in the tab order.
    bundleRoot.querySelectorAll('[data-pm-bundle-select]').forEach(function (b) {
      b.setAttribute('tabindex', b.getAttribute('aria-checked') === 'true' ? '0' : '-1');
    });

    // a11y: arrow-key navigation within the radiogroup (WAI-ARIA radiogroup) —
    // Down/Right → next, Up/Left → prev (both wrap), Home/End → first/last.
    // Moving focus also moves the selection, per the radiogroup pattern.
    bundleRoot.addEventListener('keydown', function (e) {
      var btn = e.target.closest('[data-pm-bundle-select]');
      if (!btn) return;
      var key = e.key;
      if (key !== 'ArrowDown' && key !== 'ArrowRight' && key !== 'ArrowUp' &&
          key !== 'ArrowLeft' && key !== 'Home' && key !== 'End') return;
      e.preventDefault();
      var radios = Array.prototype.slice.call(bundleRoot.querySelectorAll('[data-pm-bundle-select]'));
      var i = radios.indexOf(btn), next;
      if (key === 'Home') next = radios[0];
      else if (key === 'End') next = radios[radios.length - 1];
      else if (key === 'ArrowDown' || key === 'ArrowRight') next = radios[(i + 1) % radios.length];
      else next = radios[(i - 1 + radios.length) % radios.length];
      if (!next) return;
      var nextRow = next.closest('[data-pm-bundle-row]');
      if (nextRow) selectBundleRow(nextRow); // updates tabindex + aria-checked + price
      next.focus();
    });

    bundleRoot.addEventListener('click', function (e) {
      var selectBtn = e.target.closest('[data-pm-bundle-select]');
      if (selectBtn) {
        var row = selectBtn.closest('[data-pm-bundle-row]');
        if (row) selectBundleRow(row);
        return;
      }
      var qBtn = e.target.closest('[data-pm-bundle-qty]');
      if (qBtn) {
        var row2 = qBtn.closest('[data-pm-bundle-row]');
        if (!row2) return;
        var input = row2.querySelector('[data-pm-bundle-qty-input]');
        if (!input) return;
        var d = parseInt(qBtn.getAttribute('data-pm-bundle-qty'), 10) || 0;
        var v = (parseInt(input.value, 10) || 1) + d;
        var cap = bundleMaxQty();
        if (cap != null) v = Math.min(v, cap);
        v = Math.max(1, v);
        input.value = v;
        // Picking qty on an unselected row also selects it.
        if (row2 !== bundleState.row) selectBundleRow(row2);
        else recomputeBundlePrice();
      }
    });

    bundleRoot.addEventListener('input', function (e) {
      var input = e.target.closest('[data-pm-bundle-qty-input]');
      if (!input) return;
      var row = input.closest('[data-pm-bundle-row]');
      if (!row) return;
      var cap = bundleMaxQty();
      var v = parseInt(input.value, 10) || 1;
      if (cap != null) v = Math.min(v, cap);
      v = Math.max(1, v);
      input.value = v;
      if (row !== bundleState.row) selectBundleRow(row);
      else recomputeBundlePrice();
    });
  }

  // ─────────────────────────────────────────────────────────────────
  // Add to cart — bundle-aware. Always intercepts when there's a
  // bundle pick (multi-line payload) OR qty > 1; otherwise falls
  // through to pm-add-to-cart.js's universal handler.
  // ─────────────────────────────────────────────────────────────────
  if (addBtn) {
    addBtn.addEventListener('click', function (e) {
      var n = parseInt(qty && qty.value, 10) || 1;
      var pick = currentBundlePick();
      if (n <= 1 && !pick) return; // let pm-add-to-cart.js handle the simple case

      e.stopImmediatePropagation();
      e.preventDefault();
      addBtn.dataset.busy = '1';
      addBtn.disabled = true;
      var label = addBtn.querySelector('span');
      var orig = label ? label.textContent : '';
      if (label) label.textContent = 'Adding…';

      // Not every qty>1 add is a bundle: e.g. the HP configurator wizard
      // sets data-pm-add-properties (its picked Processor/Memory/Storage/
      // Graphics) then clicks this SAME button at whatever qty the shopper
      // chose. Without this fallback, this handler's stopImmediatePropagation
      // above silently swallows the click before pm-add-to-cart.js's own
      // (properties-aware) handler ever sees it, and the build gets lost.
      var wizProps = null;
      if (!pick) {
        var wizPropsRaw = addBtn.getAttribute('data-pm-add-properties');
        if (wizPropsRaw) { try { wizProps = JSON.parse(wizPropsRaw); } catch (e3) {} }
      }
      var items = [
        {
          id: parseInt(addBtn.getAttribute('data-variant-id'), 10),
          quantity: n,
          properties: pick ? { '_bundle': 'base', '_bundle_addon_sku': pick.sku } : (wizProps || undefined)
        }
      ];
      if (pick) {
        items.push({
          id: parseInt(pick.variantId, 10),
          // Each base unit gets one add-on LINE unit: the single drive
          // (lineQty = chosen qty) or ONE Pack-of-N product (lineQty = 1),
          // matching how BigCommerce charges the pick.
          quantity: pick.lineQty * n,
          properties: { '_bundle': 'addon', '_bundle_base_sku': (addBtn.getAttribute('data-variant-sku') || ''), '_bundle_drives': String(pick.qty * n) }
        });
      }

      var fetchOpts = {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: items })
      };

      fetch('/cart/add.js', fetchOpts)
        .then(function (r) { if (!r.ok) throw new Error('fail'); return r.json(); })
        .then(function () {
          if (label) label.textContent = 'Added';
          document.dispatchEvent(new CustomEvent('pm:cart-changed', { detail: { source: 'pdp', addedCount: n } }));
          setTimeout(function () {
            if (label) label.textContent = orig || 'Add to Cart';
            addBtn.disabled = false;
            addBtn.dataset.busy = '0';
          }, 900);
        })
        .catch(function () {
          if (label) label.textContent = orig || 'Add to Cart';
          addBtn.disabled = false;
          addBtn.dataset.busy = '0';
        });
    }, true);
  }

  // ── Specs: expand/collapse + asset-driven hydration ──
  // The PDP renders an empty Specifications block when no usable
  // metafields exist server-side. Mirror the Hydrogen storefront's
  // approach by loading specs from a single bundled JSON asset
  // (pm-product-specs.json, keyed by product handle) and populating
  // the table on the client. The asset hits Shopify's CDN with long
  // cache headers; we also cache the parsed map in sessionStorage so
  // subsequent PDPs reuse it without parsing 2MB of JSON twice.
  var specsRoot   = document.querySelector('[data-pm-pdp-handle]');
  var specsDl     = document.querySelector('[data-pm-pdp-specs]');
  var specsToggle = document.querySelector('[data-pm-pdp-specs-toggle]');
  var specsEmpty  = document.querySelector('[data-pm-pdp-specs-empty]');
  var specsCount  = document.querySelector('[data-pm-pdp-specs-count]');

  var escapeHtml = function (s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  };

  var wireSpecsToggle = function (total) {
    if (!specsToggle || !specsDl) return;
    if (total <= 8) { specsToggle.setAttribute('hidden', ''); return; }
    specsToggle.removeAttribute('hidden');
    var extra = total - 8;
    var lbl = specsToggle.querySelector('[data-pm-pdp-specs-toggle-label]');
    var svg = specsToggle.querySelector('svg');
    if (lbl) lbl.textContent = 'Show ' + extra + ' more spec' + (extra === 1 ? '' : 's');
    // Idempotent wiring — replace the previous listener (this fn may be
    // called twice: once at load with metafield count, once after the
    // asset fetch with the real count).
    var clone = specsToggle.cloneNode(true);
    specsToggle.parentNode.replaceChild(clone, specsToggle);
    specsToggle = clone;
    var lbl2 = specsToggle.querySelector('[data-pm-pdp-specs-toggle-label]');
    var svg2 = specsToggle.querySelector('svg');
    specsToggle.addEventListener('click', function () {
      var expanded = specsToggle.getAttribute('aria-expanded') === 'true';
      var next = !expanded;
      specsToggle.setAttribute('aria-expanded', next ? 'true' : 'false');
      specsDl.classList.toggle('is-expanded', next);
      if (svg2) svg2.style.transform = next ? 'rotate(180deg)' : '';
      if (lbl2) {
        lbl2.textContent = next
          ? 'Show fewer specs'
          : ('Show ' + extra + ' more spec' + (extra === 1 ? '' : 's'));
      }
    });
  };

  var populateSpecs = function (specs) {
    if (!Array.isArray(specs) || specs.length === 0 || !specsDl) return false;

    var rowsHtml = '';
    for (var i = 0; i < specs.length; i++) {
      var s = specs[i] || {};
      var nm = (s.name || '').trim();
      var vl = (s.value || '').trim();
      if (!nm || !vl) continue;
      var extraCls = i >= 8 ? ' is-extra' : '';
      rowsHtml +=
        '<div class="pm-pdp__spec-row' + extraCls + '" data-pm-pdp-spec-row>' +
          '<dt class="pm-pdp__spec-key">' + escapeHtml(nm) + '</dt>' +
          '<dd class="pm-pdp__spec-val">' + escapeHtml(vl) + '</dd>' +
        '</div>';
    }
    if (!rowsHtml) return false;

    specsDl.innerHTML = rowsHtml;
    specsDl.removeAttribute('hidden');
    specsDl.setAttribute('data-total', String(specs.length));

    // Keep the PDF data island in sync: asset-driven specs aren't in the
    // server-rendered island, so the "Download datasheet (PDF)" build would
    // otherwise miss them. Backfill only when the island has no specs yet.
    try {
      var pdfIsland = document.getElementById('pm-pdp-pdf-data');
      if (pdfIsland) {
        var pdfData = JSON.parse(pdfIsland.textContent || '{}');
        if (!Array.isArray(pdfData.specs) || pdfData.specs.length === 0) {
          pdfData.specs = specs
            .map(function (s) { return { name: (s.name || '').trim(), value: (s.value || '').trim() }; })
            .filter(function (s) { return s.name && s.value; });
          pdfIsland.textContent = JSON.stringify(pdfData);
        }
      }
    } catch (e) { /* island optional */ }

    if (specsCount) {
      specsCount.textContent = specs.length + ' ' + (specs.length === 1 ? 'spec' : 'specs');
      specsCount.removeAttribute('hidden');
    }
    if (specsEmpty) specsEmpty.setAttribute('hidden', '');

    wireSpecsToggle(specs.length);

    // Hydrate the at-a-glance bullets too, when the server didn't.
    var glance = document.querySelector('[data-pm-pdp-glance]');
    var glanceList = document.querySelector('[data-pm-pdp-glance-list]');
    var glanceEyebrow = document.querySelector('[data-pm-pdp-glance-eyebrow]');
    if (glance && glanceList && glance.hasAttribute('hidden')) {
      var bulletsHtml = '';
      var bulletCount = 0;
      for (var j = 0; j < specs.length && bulletCount < 4; j++) {
        var sb = specs[j] || {};
        var bn = (sb.name || '').trim();
        var bv = (sb.value || '').trim();
        if (!bn || !bv) continue;
        bulletsHtml +=
          '<li>' +
            '<span class="pm-pdp__glance-dot" aria-hidden="true"></span>' +
            '<span><strong>' + escapeHtml(bn) + ':</strong> ' + escapeHtml(bv) + '</span>' +
          '</li>';
        bulletCount++;
      }
      if (bulletsHtml) {
        glanceList.innerHTML = bulletsHtml;
        if (glanceEyebrow) glanceEyebrow.textContent = 'At a glance';
        glance.removeAttribute('hidden');
      }
    }
    return true;
  };

  // Wire toggle for any server-rendered specs first.
  if (specsDl && specsDl.querySelector('.pm-pdp__spec-row')) {
    var serverTotal = parseInt(specsDl.getAttribute('data-total'), 10) || 0;
    wireSpecsToggle(serverTotal);
  }

  // ── Asset-driven specs: lazy-hydrate only when needed ──
  // pm-product-specs.json is ~2 MB; fetch + parse it ONLY when the buyer
  // engages — the specs section nears the viewport, the page is scrolled, or
  // the PDF datasheet build asks via window.PmPdpSpecs.ensure(). PDPs where
  // nobody scrolls and nobody downloads the datasheet skip the 2 MB entirely.
  // The parsed map is cached in sessionStorage for reuse across PDPs, and
  // ensureSpecs() is idempotent (one shared promise, safe to call repeatedly).
  if (specsRoot && specsDl && !specsDl.querySelector('.pm-pdp__spec-row')) {
    var handle   = specsRoot.getAttribute('data-pm-pdp-handle');
    var assetUrl = specsRoot.getAttribute('data-pm-pdp-specs-asset');

    var ensurePromise = null;
    var ensureSpecs = function () {
      if (ensurePromise) return ensurePromise;
      if (!handle || !assetUrl) { ensurePromise = Promise.resolve(); return ensurePromise; }
      var cacheKey = 'pm-specs-v1:' + assetUrl;
      var apply = function (map) {
        if (map && typeof map === 'object' && map[handle]) populateSpecs(map[handle]);
      };
      // sessionStorage hit → reuse the parsed map, no network/parse of 2 MB.
      try {
        var raw = sessionStorage.getItem(cacheKey);
        if (raw) { apply(JSON.parse(raw)); ensurePromise = Promise.resolve(); return ensurePromise; }
      } catch (e) { /* ignore */ }
      ensurePromise = fetch(assetUrl, { cache: 'force-cache' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (map) {
          if (!map) return;
          try { sessionStorage.setItem(cacheKey, JSON.stringify(map)); } catch (e) { /* quota */ }
          apply(map);
        })
        .catch(function () { /* silent */ });
      return ensurePromise;
    };

    // The PDF datasheet awaits this so it still includes asset-driven specs
    // even when the buyer downloads it without scrolling to the spec table.
    window.PmPdpSpecs = { ensure: ensureSpecs };

    // Trigger 1 — the first scroll (any amount). This preloads the specs (and
    // the asset-driven "At a glance" bullets) on the earliest sign of
    // engagement, well before the buyer reaches the spec table further down.
    window.addEventListener('scroll', function onFirstScroll() {
      window.removeEventListener('scroll', onFirstScroll);
      ensureSpecs();
    }, { passive: true });

    // Trigger 2 — short pages where the spec table is already on-screen once
    // the layout settles (images loaded) hydrate without needing a scroll. We
    // check on `load` (not via IntersectionObserver) so the test runs against
    // the SETTLED layout, not the taller-than-real pre-image-load layout.
    var loadIfVisible = function () {
      var r = specsRoot.getBoundingClientRect();
      // Only if the spec section is actually on-screen after settle; anything
      // below the fold waits for the first scroll (which preloads it anyway).
      if (r.top < window.innerHeight) ensureSpecs();
    };
    if (document.readyState === 'complete') loadIfVisible();
    else window.addEventListener('load', loadIfVisible);
  }

  // Add to Quote is wired via the global pm-quote.js delegated
  // [data-pm-quote-add] click handler — no per-PDP handler needed.

  // ── Bulk Options: "buy in bulk and save" modal + live per-qty savings ──
  // Display only — the real discount is applied by the Bulk Options automatic
  // discounts at checkout. Tiers here MUST mirror those discounts.
  (function () {
    var bulk = document.querySelector('[data-pm-bulk]');
    var modal = document.getElementById('pm-bulk-modal');
    if (!bulk || !modal) return;

    var strip   = bulk;
    var t1El    = bulk.querySelector('[data-pm-bulk-t1]');
    var t2El    = bulk.querySelector('[data-pm-bulk-t2]');
    var openBtn = bulk.querySelector('[data-pm-bulk-open]');
    var qtyEl   = document.getElementById('pm-pdp-qty');
    var tiers   = [];
    try { tiers = JSON.parse(bulk.getAttribute('data-bulk-tiers') || '[]'); } catch (e) { tiers = []; }
    // tiers: [[min, max(0=∞), pct], …] ascending by min.
    var maxPct = tiers.length ? tiers[tiers.length - 1][2] : 0;

    function tierFor(n) {
      var hit = null;
      for (var i = 0; i < tiers.length; i++) {
        var min = tiers[i][0], max = tiers[i][1], pct = tiers[i][2];
        if (n >= min && (max === 0 || n <= max)) hit = { min: min, pct: pct };
      }
      return hit;
    }
    // Smallest tier whose threshold is still above the current qty — for the "add N more" nudge.
    function nextTier(n) {
      for (var i = 0; i < tiers.length; i++) { if (tiers[i][0] > n) return { min: tiers[i][0], pct: tiers[i][2] }; }
      return null;
    }

    function updateLive() {
      var n = Math.max(1, parseInt(qtyEl && qtyEl.value, 10) || 1);
      var t = tierFor(n);
      // Highlight the matching tier row inside the modal.
      var rows = modal.querySelectorAll('[data-tier-min]');
      for (var i = 0; i < rows.length; i++) {
        var min = parseInt(rows[i].getAttribute('data-tier-min'), 10);
        rows[i].classList.toggle('is-active', !!t && t.min === min);
      }
      // Morph the strip in place: terracotta "buy in bulk" ⇄ green "you're saving X%".
      var nt = nextTier(n);
      if (t) {
        strip.classList.add('is-active');
        if (t1El) t1El.textContent = "You're saving " + t.pct + "% at checkout";
        if (t2El) t2El.textContent = nt ? ('Add ' + (nt.min - n) + ' more to reach ' + nt.pct + '% off') : 'Best volume price unlocked';
      } else {
        strip.classList.remove('is-active');
        if (t1El) t1El.textContent = 'Buy in bulk and save';
        if (t2El) t2El.textContent = (n > 1 && nt) ? ('Add ' + (nt.min - n) + ' more to save ' + nt.pct + '%') : ('Up to ' + maxPct + '% off');
      }
    }

    var lastFocus = null;
    function openModal() {
      lastFocus = document.activeElement;
      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      if (window.PmFocusTrap) { PmFocusTrap.trap(modal); }
      else { var c = modal.querySelector('[data-pm-bulk-close]'); if (c) c.focus(); }
    }
    function closeModal() {
      modal.hidden = true;
      document.documentElement.style.overflow = '';
      if (window.PmFocusTrap) { PmFocusTrap.release(); }
      else if (lastFocus && lastFocus.focus) { lastFocus.focus(); }
    }

    if (openBtn) openBtn.addEventListener('click', openModal);
    modal.querySelectorAll('[data-pm-bulk-close]').forEach(function (el) {
      el.addEventListener('click', closeModal);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    // Track the quantity stepper. The existing stepper handlers clamp the value
    // synchronously on click, so defer our read to the next tick to see the
    // clamped result; the input/change events already fire post-clamp.
    if (qtyEl) {
      qtyEl.addEventListener('input', updateLive);
      qtyEl.addEventListener('change', updateLive);
    }
    document.querySelectorAll('[data-pm-pdp-qty]').forEach(function (b) {
      b.addEventListener('click', function () { setTimeout(updateLive, 0); });
    });
    updateLive();
  })();
})();
</script>

{% schema %}
{
  "name": "PM — Product Detail",
  "settings": []
}
{% endschema %}
