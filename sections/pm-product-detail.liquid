{%- comment -%}
  PM — Product Detail Page
  Two-column layout: gallery left, info right.
  + Add uses the universal data-pm-add handler → opens cart drawer.
  Compare checkbox uses the universal data-pm-compare handler.
{%- endcomment -%}

{%- assign _v = product.selected_or_first_available_variant -%}

<section class="pm-pdp">
  <div class="pm-container pm-pdp__inner">

    <nav class="pm-breadcrumb pm-pdp__breadcrumb" aria-label="Breadcrumb">
      <a href="/">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Home
      </a>
      <span class="pm-breadcrumb__sep">›</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span class="pm-breadcrumb__sep">›</span>
      {%- endif -%}
      <span aria-current="page" class="pm-breadcrumb__current">{{ product.title | truncate: 60 }}</span>
    </nav>

    <div class="pm-pdp__grid">

      {%- comment -%} ── Gallery ─────────────────────────────────────── {%- endcomment -%}
      <div class="pm-pdp__gallery">
        <div class="pm-pdp__main">
          {%- if product.featured_image -%}
            <img
              id="pm-pdp-main-img"
              src="{{ product.featured_image | image_url: width: 900 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              width="900"
              height="900"
              loading="eager"
            >
          {%- else -%}
            <div class="pm-pdp__main-placeholder">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            </div>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="pm-pdp__thumbs">
            {%- for image in product.images limit: 8 -%}
              <button
                type="button"
                class="pm-pdp__thumb{% if forloop.first %} is-active{% endif %}"
                data-pm-pdp-thumb="{{ image | image_url: width: 900 }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 160 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="68"
                  height="68"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ── Info column ─────────────────────────────────── {%- endcomment -%}
      <div class="pm-pdp__info">
        {%- if product.vendor != blank -%}
          <div class="pm-pdp__brand">{{ product.vendor | upcase }}</div>
        {%- endif -%}

        <h1 class="pm-pdp__title">{{ product.title }}</h1>

        {%- if _v.sku != blank -%}
          <div class="pm-pdp__sku">SKU <span>{{ _v.sku }}</span></div>
        {%- endif -%}

        <div class="pm-pdp__price">
          {%- if product.compare_at_price > product.price -%}
            <span class="pm-pdp__price-now pm-pdp__price-now--sale">{{ product.price | money }}</span>
            <span class="pm-pdp__price-strike">{{ product.compare_at_price | money }}</span>
            <span class="pm-pdp__flag pm-pdp__flag--sale">Sale</span>
          {%- else -%}
            <span class="pm-pdp__price-now">{{ product.price | money }}</span>
            {%- if product.available -%}
              <span class="pm-pdp__stock">
                <span class="pm-pdp__stock-dot"></span>In stock
              </span>
            {%- else -%}
              <span class="pm-pdp__stock pm-pdp__stock--out">
                <span class="pm-pdp__stock-dot"></span>Sold out
              </span>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- comment -%} Variant selector (only if non-default options) {%- endcomment -%}
        {%- if product.has_only_default_variant == false -%}
          <div class="pm-pdp__options" id="pm-pdp-options">
            {%- for option in product.options_with_values -%}
              <div class="pm-pdp__option">
                <label class="pm-pdp__option-label">{{ option.name }}</label>
                <select data-pm-pdp-option="{{ forloop.index0 }}">
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
            {%- comment -%} Embed variant data as JSON for client-side selection {%- endcomment -%}
            <script type="application/json" id="pm-pdp-variants">
              {{ product.variants | json }}
            </script>
          </div>
        {%- endif -%}

        <div class="pm-pdp__actions">
          <div class="pm-pdp__qty">
            <button type="button" class="pm-pdp__qty-btn" data-pm-pdp-qty="-1" aria-label="Decrease quantity">−</button>
            <input type="number" id="pm-pdp-qty" value="1" min="1" step="1" aria-label="Quantity">
            <button type="button" class="pm-pdp__qty-btn" data-pm-pdp-qty="1" aria-label="Increase quantity">+</button>
          </div>
          {%- if product.available -%}
            <button
              type="button"
              class="pm-btn pm-btn--primary pm-pdp__add"
              data-pm-add
              data-pm-pdp-add
              data-variant-id="{{ _v.id }}"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              <span>Add to cart</span>
            </button>
          {%- else -%}
            <button type="button" class="pm-btn pm-pdp__add" disabled>Sold out</button>
          {%- endif -%}
        </div>

        <label class="pm-pdp__compare">
          <input type="checkbox" data-pm-compare data-product-handle="{{ product.handle }}">
          <span>Compare</span>
        </label>

        {%- comment -%} Trust signals {%- endcomment -%}
        <ul class="pm-pdp__trust">
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Free freight on orders over $5,000
          </li>
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Ships from Southern California
          </li>
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Quotes valid 14 days — call <a href="tel:18777644968">(877) PMG-4YOU</a>
          </li>
        </ul>

        {%- if product.description != blank -%}
          <details class="pm-pdp__details" open>
            <summary>
              <span>Product details</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="pm-pdp__desc rte">{{ product.description }}</div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  // ── Gallery thumbs ──
  var main = document.getElementById('pm-pdp-main-img');
  document.querySelectorAll('[data-pm-pdp-thumb]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var url = btn.getAttribute('data-pm-pdp-thumb');
      if (main) main.src = url;
      document.querySelectorAll('[data-pm-pdp-thumb]').forEach(function (b) {
        b.classList.toggle('is-active', b === btn);
      });
    });
  });

  // ── Quantity ± buttons (also feeds the Add button's quantity) ──
  var qty = document.getElementById('pm-pdp-qty');
  document.querySelectorAll('[data-pm-pdp-qty]').forEach(function (b) {
    b.addEventListener('click', function () {
      var d = parseInt(b.getAttribute('data-pm-pdp-qty'), 10) || 0;
      var v = Math.max(1, (parseInt(qty.value, 10) || 1) + d);
      qty.value = v;
    });
  });

  // ── Variant selection ──
  var variantsEl = document.getElementById('pm-pdp-variants');
  var addBtn     = document.querySelector('[data-pm-pdp-add]');
  if (variantsEl && addBtn) {
    var variants = [];
    try { variants = JSON.parse(variantsEl.textContent); } catch (e) {}
    document.querySelectorAll('[data-pm-pdp-option]').forEach(function (sel) {
      sel.addEventListener('change', function () {
        var chosen = Array.from(document.querySelectorAll('[data-pm-pdp-option]')).map(function (s) { return s.value; });
        var match = variants.find(function (v) {
          return chosen.every(function (c, i) { return v['option' + (i + 1)] === c; });
        });
        if (match) {
          addBtn.setAttribute('data-variant-id', match.id);
          if (match.available) { addBtn.removeAttribute('disabled'); addBtn.querySelector('span').textContent = 'Add to cart'; }
          else { addBtn.setAttribute('disabled', ''); addBtn.querySelector('span').textContent = 'Sold out'; }
          if (match.featured_image && main) main.src = match.featured_image.src.replace(/(\.[a-z]+)$/, '_900x900$1');
        }
      });
    });
  }

  // ── Add to cart uses the chosen quantity (pm-add-to-cart.js by default uses 1) ──
  if (addBtn) {
    addBtn.addEventListener('click', function (e) {
      var n = parseInt(qty.value, 10) || 1;
      // pm-add-to-cart.js posts quantity 1; intercept for PDP to send chosen qty
      if (n > 1) {
        e.stopImmediatePropagation();
        e.preventDefault();
        addBtn.dataset.busy = '1';
        addBtn.disabled = true;
        var label = addBtn.querySelector('span');
        var orig = label ? label.textContent : '';
        if (label) label.textContent = 'Adding…';
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [{ id: parseInt(addBtn.getAttribute('data-variant-id'), 10), quantity: n }] })
        })
          .then(function (r) { if (!r.ok) throw new Error('fail'); return r.json(); })
          .then(function () {
            if (label) label.textContent = 'Added';
            document.dispatchEvent(new CustomEvent('pm:cart-changed', { detail: { source: 'pdp', addedCount: n } }));
            setTimeout(function () {
              if (label) label.textContent = orig || 'Add to cart';
              addBtn.disabled = false;
              addBtn.dataset.busy = '0';
            }, 900);
          })
          .catch(function () {
            if (label) label.textContent = orig || 'Add to cart';
            addBtn.disabled = false;
            addBtn.dataset.busy = '0';
          });
      }
    }, true /* capture, so we run before pm-add-to-cart.js's bubble-phase listener */);
  }
})();
</script>

{% schema %}
{
  "name": "PM — Product Detail",
  "settings": []
}
{% endschema %}
