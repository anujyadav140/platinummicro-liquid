{%- comment -%}
  PM — Promotion Card(s)
  Block-based: each "Card" block renders one promo card; cards lay out in a
  responsive row (1-up mobile → 2-up tablet → up to 4-up desktop). Shared
  look (colours, radius, spacing) is set on the section root as CSS custom
  properties; per-card content lives on the block. Styles: pm-home-sections.css.
{%- endcomment -%}
{%- assign _cols = section.blocks.size | at_most: 4 | at_least: 1 -%}
<section
  class="pm-promo-section"
  style="
    --pc-pt:{{ section.settings.padding_top }}px;
    --pc-pb:{{ section.settings.padding_bottom }}px;
    --pc-section-bg:{{ section.settings.section_bg }};
    --pc-bg:{{ section.settings.bg_color }};
    --pc-radius:{{ section.settings.border_radius }}px;
    --pc-eyebrow:{{ section.settings.eyebrow_color }};
    --pc-title:{{ section.settings.title_color }};
    --pc-body:{{ section.settings.body_color }};
    --pc-cta-bg:{{ section.settings.accent_color }};
    --pc-cta-text:{{ section.settings.cta_text_color }};
    --pc-cols:{{ _cols }};
  "
>
  <div class="pm-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="pm-promo-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="pm-promo-grid">
      {%- for block in section.blocks -%}
        <article class="pm-promo-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div
              class="pm-promo-card__image"
              style="background-image:url('{{ block.settings.image | image_url: width: 800 }}');background-position:{{ block.settings.image_position | default: 'center' }};"
              role="img"
              aria-label="{{ block.settings.title | escape }}"
            ></div>
          {%- endif -%}
          <div class="pm-promo-card__content">
            {%- if block.settings.eyebrow != blank -%}
              <div class="pm-promo-card__eyebrow">{{ block.settings.eyebrow }}</div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="pm-promo-card__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="pm-promo-card__body">{{ block.settings.body }}</p>
            {%- endif -%}
            {%- if block.settings.cta_label != blank and block.settings.cta_href != blank -%}
              <a class="pm-promo-card__cta" href="{{ block.settings.cta_href }}">
                {{ block.settings.cta_label }}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PM — Promotion Card",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Section" },
    { "type": "text",  "id": "heading",        "label": "Section heading (optional)" },
    { "type": "color", "id": "section_bg",     "label": "Section background", "default": "#FBFAF7" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",        "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom",     "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },

    { "type": "header", "content": "Card style (all cards)" },
    { "type": "color", "id": "bg_color",       "label": "Card background",   "default": "#0D2340" },
    { "type": "range", "id": "border_radius",  "label": "Card radius",       "min": 0, "max": 32, "step": 1, "unit": "px", "default": 12 },
    { "type": "color", "id": "eyebrow_color",  "label": "Eyebrow color",     "default": "#C04E3E" },
    { "type": "color", "id": "title_color",    "label": "Title color",       "default": "#FFFFFF" },
    { "type": "color", "id": "body_color",     "label": "Body color",        "default": "#D8DEE7" },
    { "type": "color", "id": "accent_color",   "label": "Button color",      "default": "#A63D2F" },
    { "type": "color", "id": "cta_text_color", "label": "Button text color", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Card image" },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image focus point",
          "options": [
            { "value": "center",       "label": "Center" },
            { "value": "top",          "label": "Top" },
            { "value": "bottom",       "label": "Bottom" },
            { "value": "left center",  "label": "Left" },
            { "value": "right center", "label": "Right" }
          ],
          "default": "center"
        },
        { "type": "text",     "id": "eyebrow",   "label": "Eyebrow text" },
        { "type": "text",     "id": "title",     "label": "Headline" },
        { "type": "textarea", "id": "body",      "label": "Body text" },
        { "type": "text",     "id": "cta_label", "label": "CTA label" },
        { "type": "url",      "id": "cta_href",  "label": "CTA link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PM — Promotion Card",
      "blocks": [
        { "type": "card", "settings": { "eyebrow": "LIMITED-TIME OFFER", "title": "Cisco refresh window — Q4 pricing locked.", "body": "HPE, Cisco, and Dell lease returns arriving now. Fixed-price bundles, no auction.", "cta_label": "View the deal" } },
        { "type": "card", "settings": { "eyebrow": "NEW ARRIVALS", "title": "Latest enterprise storage in stock.", "body": "NVMe-ready NAS and rack units from Asustor, QNAP and Synology.", "cta_label": "Shop storage" } },
        { "type": "card", "settings": { "eyebrow": "BULK PRICING", "title": "Volume quotes in 24 hours.", "body": "Tiered pricing for system integrators and public-sector buyers.", "cta_label": "Request a quote" } },
        { "type": "card", "settings": { "eyebrow": "CERTIFIED REFURB", "title": "Refurbished gear, full warranty.", "body": "Up to 60% off list on tested, warrantied enterprise hardware.", "cta_label": "Browse refurb" } }
      ]
    }
  ]
}
{% endschema %}
