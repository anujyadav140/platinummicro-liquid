{%- assign columns     = section.settings.columns_desktop | default: 4 -%}
{%- assign cols_mobile = section.settings.columns_mobile | default: 2 -%}
{%- assign per_page    = section.settings.products_per_page | default: 24 -%}

<div class="pm-container" style="padding-top:32px;padding-bottom:64px;">
  {%- comment -%} Sort + filter bar {%- endcomment -%}
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
    <div style="font-size:13px;color:var(--pm-ink-500);">
      {%- if collection.products_count > 0 -%}
        Showing {{ collection.products | size }} of {{ collection.products_count }} products
      {%- endif -%}
    </div>
    <form style="display:flex;align-items:center;gap:8px;">
      <label for="pm-sort" style="font-size:13px;font-weight:500;color:var(--pm-ink-700);">Sort by</label>
      <select
        id="pm-sort"
        name="sort_by"
        onchange="window.location.href = window.location.pathname + '?sort_by=' + this.value;"
        style="padding:7px 12px;border:1.5px solid var(--pm-ink-200);border-radius:6px;font-size:13px;color:var(--pm-ink-900);background:white;cursor:pointer;"
      >
        {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
        <option value="manual"{% if current_sort == 'manual' %} selected{% endif %}>Featured</option>
        <option value="best-selling"{% if current_sort == 'best-selling' %} selected{% endif %}>Best selling</option>
        <option value="title-ascending"{% if current_sort == 'title-ascending' %} selected{% endif %}>A–Z</option>
        <option value="title-descending"{% if current_sort == 'title-descending' %} selected{% endif %}>Z–A</option>
        <option value="price-ascending"{% if current_sort == 'price-ascending' %} selected{% endif %}>Price: low–high</option>
        <option value="price-descending"{% if current_sort == 'price-descending' %} selected{% endif %}>Price: high–low</option>
        <option value="created-descending"{% if current_sort == 'created-descending' %} selected{% endif %}>Newest</option>
      </select>
    </form>
  </div>

  {%- paginate collection.products by per_page -%}
    {%- if collection.products.size > 0 -%}
      <ul class="pm-product-grid" style="display:grid;grid-template-columns:repeat({{ cols_mobile }},1fr);gap:16px;">
        {%- for product in collection.products -%}
          <li>
            {%- render 'pm-product-card', product: product -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav aria-label="Pagination" style="display:flex;justify-content:center;align-items:center;gap:8px;margin-top:48px;">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="pm-header__action-btn" style="border:1.5px solid var(--pm-ink-200);border-radius:6px;">← Prev</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" style="padding:8px 14px;border:1.5px solid var(--pm-ink-200);border-radius:6px;font-size:14px;color:var(--pm-ink-700);">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span style="padding:8px 14px;border:1.5px solid var(--pm-terracotta);border-radius:6px;font-size:14px;font-weight:700;color:var(--pm-terracotta);background:var(--pm-terracotta-pale);">{{ part.title }}</span>
            {%- else -%}
              <span style="padding:8px 4px;color:var(--pm-ink-400);">{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="pm-header__action-btn" style="border:1.5px solid var(--pm-ink-200);border-radius:6px;">Next →</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div style="text-align:center;padding:80px 0;color:var(--pm-ink-500);">
        <p style="font-size:18px;font-weight:600;margin-bottom:8px;">No products found</p>
        <a href="/collections/all" style="color:var(--pm-terracotta);">Browse all products →</a>
      </div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

<style>
@media (min-width: 768px) {
  .pm-product-grid { grid-template-columns: repeat(3, 1fr) !important; }
}
@media (min-width: 1024px) {
  .pm-product-grid { grid-template-columns: repeat({{ columns }}, 1fr) !important; }
}
</style>

{% schema %}
{
  "name": "PM — Product Grid",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Products per row (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
