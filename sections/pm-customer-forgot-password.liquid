{%- comment -%}
  PM — Forgot Password
  Port of: app/routes/account_.forgot-password.tsx
  Centered card, email → reset link
{%- endcomment -%}

<div style="min-height:100vh;background:var(--pm-paper,#F5F3EF);padding:80px 16px;">
  <div style="max-width:480px;margin:0 auto;">

    <div style="text-align:center;margin-bottom:28px;">
      <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.14em;color:var(--pm-tan,#C9A96E);margin-bottom:10px;">Forgot password</div>
      <h1 style="font-size:28px;font-weight:800;color:var(--pm-ink-900,#071525);line-height:1.2;letter-spacing:-0.02em;margin-bottom:12px;">Reset your password.</h1>
      <p style="font-size:14px;color:var(--pm-ink-500,#6B7280);line-height:1.6;">Enter your account email address and we'll send you a secure link to reset your password.</p>
    </div>

    <div style="background:white;border:1.5px solid var(--pm-ink-200,#E5E7EB);border-radius:16px;padding:36px 32px;box-shadow:0 4px 24px rgba(7,21,37,0.06);">

      {%- form 'recover_customer_password' -%}

        {%- if form.posted_successfully? -%}
          <div style="display:flex;align-items:flex-start;gap:12px;background:#F0FDF4;border:1.5px solid #86EFAC;border-radius:8px;padding:16px 18px;margin-bottom:24px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" style="flex-shrink:0;margin-top:1px;" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <div>
              <div style="font-size:14px;font-weight:700;color:#15803D;margin-bottom:2px;">Check your inbox</div>
              <div style="font-size:13px;color:#166534;">We've emailed a password reset link. It may take a few minutes to arrive.</div>
            </div>
          </div>
        {%- else -%}

          {%- if form.errors -%}
            <div style="display:flex;align-items:flex-start;gap:12px;background:#FEF2F2;border:1.5px solid #FCA5A5;border-radius:8px;padding:14px 16px;margin-bottom:24px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" style="flex-shrink:0;margin-top:1px;" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <div>
                {%- for error in form.errors -%}
                  <div style="font-size:13px;color:#991B1B;">{{ form.errors.messages[error] }}</div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <div style="margin-bottom:20px;">
            {%- render 'pm-form-field',
                label:        'Email address',
                name:         'email',
                type:         'email',
                required:     true,
                placeholder:  'you@company.com',
                autocomplete: 'email',
                error:        form.errors.messages['email']
            -%}
          </div>

          <button
            type="submit"
            style="width:100%;background:var(--pm-navy,#071525);color:white;border:none;border-radius:8px;padding:14px 24px;font-size:15px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:opacity 0.15s;"
            onmouseover="this.style.opacity='0.8';" onmouseout="this.style.opacity='1';"
          >
            Send reset link
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>

        {%- endif -%}

      {%- endform -%}

    </div>

    <div style="text-align:center;margin-top:20px;">
      <span style="font-size:13px;color:var(--pm-ink-500,#6B7280);">Remembered it?</span>
      <a href="/account/login" style="font-size:13px;color:var(--pm-terracotta,#C0392B);font-weight:600;text-decoration:none;margin-left:6px;border-bottom:1.5px solid transparent;transition:border-color 0.15s;"
         onmouseover="this.style.borderBottomColor='var(--pm-terracotta,#C0392B)';" onmouseout="this.style.borderBottomColor='transparent';">Sign in →</a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "PM — Forgot Password",
  "settings": []
}
{% endschema %}
