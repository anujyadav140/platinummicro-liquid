{%- comment -%}
  PM — Forgot Password
  Centered card layout, email → reset link.
  Styling lives in .pm-auth-* classes in pm-auth-misc.css.
{%- endcomment -%}

<div class="pm-auth">
  <div class="pm-auth__inner">

    <header class="pm-auth__head">
      <div class="pm-auth__eyebrow">Forgot password</div>
      <h1 class="pm-auth__title">Reset your password.</h1>
      <p class="pm-auth__lead">Enter your account email address and we'll send you a secure link to reset your password.</p>
    </header>

    <div class="pm-auth__card">

      {%- form 'recover_customer_password' -%}

        {%- if form.posted_successfully? -%}
          <div class="pm-auth__alert pm-auth__alert--success pm-auth__alert--lg" role="status">
            <svg class="pm-auth__alert-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <div>
              <div class="pm-auth__alert-title">Check your inbox</div>
              <div class="pm-auth__alert-msg">We've emailed a password reset link. It may take a few minutes to arrive.</div>
            </div>
          </div>
        {%- else -%}

          {%- if form.errors -%}
            <div class="pm-auth__alert pm-auth__alert--error" role="alert">
              <svg class="pm-auth__alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <div>
                {%- for error in form.errors -%}
                  <div class="pm-auth__alert-msg">{{ form.errors.messages[error] }}</div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <div class="pm-auth__section">
            {%- render 'pm-form-field',
                label:        'Email address',
                name:         'email',
                type:         'email',
                required:     true,
                placeholder:  'you@company.com',
                autocomplete: 'email',
                error:        form.errors.messages['email']
            -%}
          </div>

          <button type="submit" class="pm-auth__submit pm-auth__submit--navy">
            Send reset link
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>

        {%- endif -%}

      {%- endform -%}

    </div>

    <div class="pm-auth__footer-block pm-auth__footer-block--bare">
      <span class="pm-auth__footer-text">Remembered it?</span>
      <a href="/account/login" class="pm-auth__sign-in-link">Sign in →</a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "PM — Forgot Password",
  "settings": []
}
{% endschema %}
