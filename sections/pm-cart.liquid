{%- comment -%}
  PM — Cart page (two-bucket model).

  Renders two buckets:
    1. STOCKED — real Shopify cart lines, server-rendered from cart.items.
       Standard /checkout flow via the order-summary card.
    2. QUOTE   — local pm:quote:v1 store (window.PmQuote), client-rendered.
       Submits via Shopify's built-in {% form 'contact' %} which emails
       the store's configured contact address with the SKU list +
       customer-entered notes. Zero apps required; the wire is ready to
       swap to Globo / Draft Orders later without touching the UI.

  Empty-state handling: the "your cart is empty" panel is suppressed
  when the local quote store has items, even if cart.items is empty —
  a quote-only cart is still a cart.
{%- endcomment -%}

<div class="pm-container pm-cart-page">
  <h1 class="pm-cart-page__h1">Your cart</h1>

  <div class="pm-cart-layout" data-pm-cart-layout>

    {%- comment -%} ── Items column ────────────────────────────────────────── {%- endcomment -%}
    <div class="pm-cart-items">

      {%- comment -%} ── Bucket 1: stocked items (server-rendered) ──────── {%- endcomment -%}
      {%- if cart.item_count > 0 -%}
        <section class="pm-cart-bucket" data-pm-cart-stocked>
          <header class="pm-cart-bucket__head">
            <h2 class="pm-cart-bucket__title">In-stock items</h2>
            <p class="pm-cart-bucket__lede">Ready to ship. Settle in checkout.</p>
          </header>
          {%- for item in cart.items -%}
            <div class="pm-cart-row" data-cart-row="{{ forloop.index }}" data-cart-key="{{ item.key }}" data-cart-unit-cents="{{ item.final_price }}" data-cart-unit-original="{{ item.original_price }}">
              <a href="{{ item.url }}" class="pm-cart-row__img-link">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 160 }}"
                    alt="{{ item.image.alt | default: item.product.title | escape }}"
                    width="80"
                    height="80"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="pm-cart-row__img-empty">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  </div>
                {%- endif -%}
              </a>

              <div class="pm-cart-row__main">
                <div class="pm-cart-row__top">
                  <div class="pm-cart-row__info">
                    {%- if item.product.vendor != blank -%}
                      <div class="pm-cart-row__brand">{{ item.product.vendor }}</div>
                    {%- endif -%}
                    <a href="{{ item.url }}" class="pm-cart-row__name">{{ item.product.title }}</a>
                    {%- unless item.variant.title == 'Default Title' -%}
                      <div class="pm-cart-row__variant">{{ item.variant.title }}</div>
                    {%- endunless -%}
                    {%- if item.variant.sku != blank -%}
                      <div class="pm-cart-row__sku">SKU: {{ item.variant.sku }}</div>
                    {%- endif -%}
                  </div>
                  {%- assign _line_discounted = false -%}
                  {%- assign _line_pct = 0 -%}
                  {%- if item.original_line_price > item.final_line_price -%}
                    {%- assign _line_discounted = true -%}
                    {%- assign _line_pct = item.original_line_price | minus: item.final_line_price | times: 100.0 | divided_by: item.original_line_price | round -%}
                  {%- endif -%}
                  <div class="pm-cart-row__price">
                    <div class="pm-cart-row__price-now">
                      <s class="pm-cart-row__line-was" data-cart-line-was {% unless _line_discounted %}hidden{% endunless %}>{{ item.original_line_price | money }}</s>
                      <span class="pm-cart-row__line-price" data-cart-line-price>{{ item.final_line_price | money }}</span>
                    </div>
                    <div class="pm-cart-row__unit">
                      <span class="pm-cart-row__save" data-cart-save {% unless _line_discounted %}hidden{% endunless %}>{{ _line_pct }}% off</span><span data-cart-unit>{{ item.final_price | money }} each</span>
                    </div>
                  </div>
                </div>

                <div class="pm-cart-row__controls">
                  {%- comment -%} TC-085: cap the + stepper at on-hand stock for ANY tracked variant with a positive count — DENY + CONTINUE alike (matches the PDP gate). {%- endcomment -%}
                  {%- assign _cart_max = '' -%}
                  {%- if item.variant.inventory_management == 'shopify' and item.variant.inventory_quantity and item.variant.inventory_quantity > 0 -%}{%- assign _cart_max = item.variant.inventory_quantity -%}{%- endif -%}
                  <div class="pm-qty"{% if _cart_max != '' %} data-cart-max="{{ _cart_max }}"{% endif %}>
                    <button class="pm-qty-btn" data-line="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity">−</button>
                    <span data-cart-qty-display>{{ item.quantity }}</span>
                    <button class="pm-qty-btn" data-line="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity"{% if _cart_max != '' and item.quantity >= _cart_max %} disabled{% endif %}>+</button>
                  </div>
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="pm-cart-row__remove" data-cart-remove="{{ forloop.index }}">Remove</a>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </section>
      {%- endif -%}

      {%- comment -%}
        Quotes are handled entirely by Quotify (the "Show Quote Cart" sticky
        button + its own quote flow), so the cart page no longer renders a
        local quote bucket. The old client-rendered PmQuote bucket lived here.
      {%- endcomment -%}

      {%- comment -%} ── Empty state ─ rendered by Liquid when the cart is empty {%- endcomment -%}
      <div class="pm-cart-empty" data-pm-cart-empty {% if cart.item_count > 0 %}hidden{% endif %}>
        <div class="pm-cart-empty__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        </div>
        <h2 class="pm-cart-empty__title">Your cart is empty</h2>
        <p class="pm-cart-empty__lede">Looks like you haven't added any items yet.</p>
        <a href="{{ routes.all_products_collection_url }}" class="pm-cart-page__btn pm-cart-page__btn--primary">
          Browse catalog
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    {%- comment -%} ── Summary sidebar ───────────────────────────────────── {%- endcomment -%}
    <div class="pm-cart-summary">

      {%- comment -%} Order summary — only when there ARE stocked items {%- endcomment -%}
      {%- if cart.item_count > 0 -%}
        <aside class="pm-cart-card" data-pm-cart-order-summary>
          <h2 class="pm-cart-card__h2">Order summary</h2>

          <div class="pm-cart-card__rows">
            <div class="pm-cart-card__row">
              <span data-cart-itemcount-label>Subtotal ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
              <span data-cart-subtotal class="pm-cart-card__row-val">{{ cart.original_total_price | money }}</span>
            </div>
            <div class="pm-cart-card__row pm-cart-card__row--savings" data-cart-savings-row {% unless cart.total_discounts > 0 %}hidden{% endunless %}>
              <span>Savings</span>
              <span data-cart-savings>−{{ cart.total_discounts | money }}</span>
            </div>
            <div class="pm-cart-card__row" data-pm-ship
              {%- if customer.default_address and customer.default_address.country != blank -%}
                data-ship-country="{{ customer.default_address.country | escape }}"
                data-ship-province="{{ customer.default_address.province | escape }}"
                data-ship-zip="{{ customer.default_address.zip | escape }}"
              {%- endif -%}>
              <span>Shipping</span>
              <span class="pm-cart-card__row-val" data-pm-ship-summary>
                <span data-pm-ship-amount></span>
                <button type="button" class="pm-ship__toggle" data-pm-ship-toggle aria-expanded="false" aria-controls="pm-ship-panel">Estimate</button>
              </span>
            </div>
            <div class="pm-ship__panel" id="pm-ship-panel" data-pm-ship-panel hidden>
              <div class="pm-ship__fields">
                <label class="pm-ship__field">
                  <span>Country</span>
                  <select data-pm-ship-country autocomplete="country">{{ country_option_tags }}</select>
                </label>
                <label class="pm-ship__field" data-pm-ship-prov-wrap hidden>
                  <span>State / Province</span>
                  <select data-pm-ship-province autocomplete="address-level1"></select>
                </label>
                <label class="pm-ship__field">
                  <span>ZIP / Postal code</span>
                  <input type="text" inputmode="text" autocomplete="postal-code" data-pm-ship-zip placeholder="e.g. 90001">
                </label>
              </div>
              <button type="button" class="pm-ship__btn" data-pm-ship-go>Get rates</button>
              <div class="pm-ship__result" data-pm-ship-result aria-live="polite"></div>
              <p class="pm-ship__note">Estimate only. You'll choose your shipping method at checkout.</p>
            </div>
          </div>

          <div class="pm-cart-card__total">
            <span>Total</span>
            <span data-cart-total>{{ cart.total_price | money }}</span>
          </div>

          <div class="pm-cart-card__note">
            <label for="pm-cart-note">Order note (optional)</label>
            <textarea
              id="pm-cart-note"
              name="note"
              rows="3"
              placeholder="PO number, delivery instructions, etc."
              form="pm-cart-form"
            >{{ cart.note }}</textarea>
          </div>

          <form id="pm-cart-form" action="{{ routes.cart_url }}" method="post">
            <input type="hidden" name="checkout" value="1">
            <button type="submit" class="pm-cart-page__btn pm-cart-page__btn--primary pm-cart-page__btn--block">
              Proceed to checkout
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </form>

          <a href="{{ routes.all_products_collection_url }}" class="pm-cart-card__continue">← Continue shopping</a>
        </aside>
      {%- endif -%}

    </div>
  </div>
</div>

<style>
.pm-cart-page { padding: 48px 16px 80px; }
.pm-cart-page__h1 {
  font-size: 28px;
  font-weight: 700;
  color: var(--pm-ink-900);
  margin: 0 0 24px;
  letter-spacing: -0.02em;
}

/* Layout */
.pm-cart-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
}
@media (min-width: 960px) {
  .pm-cart-layout { grid-template-columns: 1fr 380px; align-items: start; }
  .pm-cart-summary { position: sticky; top: 24px; display: flex; flex-direction: column; gap: 16px; }
}

/* Bucket */
.pm-cart-bucket {
  background: #fff;
  border: 1px solid var(--pm-ink-200);
  border-radius: 12px;
  padding: 22px 24px;
  margin-bottom: 16px;
}
.pm-cart-bucket__head { margin-bottom: 12px; }
.pm-cart-bucket__title {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0;
  font-size: 16px;
  font-weight: 700;
  color: var(--pm-ink-900);
}
.pm-cart-bucket__lede {
  margin: 4px 0 0;
  font-size: 13px;
  color: var(--pm-ink-500);
  line-height: 1.5;
}

/* Row */
.pm-cart-row {
  display: flex;
  gap: 16px;
  padding: 16px 0;
  border-top: 1px solid var(--pm-ink-100);
}
.pm-cart-row:first-of-type { border-top: none; padding-top: 8px; }
.pm-cart-row__img-link { flex-shrink: 0; }
.pm-cart-row__img-link img,
.pm-cart-row__img-empty {
  width: 80px;
  height: 80px;
  object-fit: contain;
  border-radius: 6px;
  border: 1px solid var(--pm-ink-200);
  background: #fff;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pm-cart-row__img-empty { background: var(--pm-ink-100); color: var(--pm-ink-300); }

.pm-cart-row__main { flex: 1; min-width: 0; }
.pm-cart-row__top { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
.pm-cart-row__brand {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--pm-tan);
  margin-bottom: 4px;
}
.pm-cart-row__name {
  font-size: 15px;
  font-weight: 600;
  color: var(--pm-ink-900);
  text-decoration: none;
  line-height: 1.3;
}
.pm-cart-row__variant { font-size: 13px; color: var(--pm-ink-500); margin-top: 2px; }
.pm-cart-row__sku { font-size: 12px; color: var(--pm-ink-400); margin-top: 2px; }
.pm-cart-row__price { text-align: right; flex-shrink: 0; }
.pm-cart-row__price-now { display: flex; align-items: baseline; justify-content: flex-end; gap: 8px; flex-wrap: wrap; }
.pm-cart-row__line-price { font-size: 16px; font-weight: 700; color: var(--pm-ink-900); }
.pm-cart-row__line-was { font-size: 13px; color: var(--pm-ink-400); text-decoration: line-through; }
.pm-cart-row__line-was[hidden] { display: none; }
.pm-cart-row__unit { font-size: 12px; color: var(--pm-ink-400); margin-top: 3px; }
.pm-cart-row__save { color: #137a48; font-weight: 700; }
.pm-cart-row__save[hidden] { display: none; }
.pm-cart-row__save::after { content: "·"; margin: 0 5px; color: var(--pm-ink-300); font-weight: 400; }

.pm-cart-row__controls { display: flex; align-items: center; gap: 16px; margin-top: 12px; flex-wrap: wrap; }
.pm-qty {
  display: inline-flex;
  align-items: center;
  border: 1.5px solid var(--pm-ink-200);
  border-radius: 6px;
  overflow: hidden;
  background: #fff;
}
.pm-qty-btn {
  width: 36px;
  height: 36px;
  background: none;
  border: none;
  cursor: pointer;
  font-size: 18px;
  color: var(--pm-ink-700);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background var(--pm-dur-fast);
}
.pm-qty-btn:hover:not(:disabled) { background: var(--pm-ink-100); }
.pm-qty-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.pm-qty > span {
  min-width: 36px;
  text-align: center;
  font-size: 14px;
  font-weight: 600;
  color: var(--pm-ink-900);
  padding: 0 4px;
}
.pm-cart-row__remove {
  /* Reset native button chrome so the <button> renders identical to
     the <a> sibling on the stocked-items side. (When the JS-rendered
     quote rows changed from <a href="#"> to <button> for a11y, the
     browser's default button border + grey background became visible.) */
  appearance: none;
  -webkit-appearance: none;
  background: transparent;
  border: 0;
  padding: 0;
  font: inherit;
  cursor: pointer;
  font-size: 13px;
  color: var(--pm-ink-400);
  text-decoration: none;
  border-bottom: 1px solid var(--pm-ink-300);
  line-height: 1.2;
}
.pm-cart-row__remove:hover { color: var(--pm-danger); border-bottom-color: var(--pm-danger); }

/* Empty state */
.pm-cart-empty { text-align: center; padding: 64px 24px; }
.pm-cart-empty__icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 20px;
  background: var(--pm-ink-100);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--pm-ink-400);
}
.pm-cart-empty__title { font-size: 20px; font-weight: 700; color: var(--pm-ink-900); margin: 0 0 8px; }
.pm-cart-empty__lede { font-size: 15px; color: var(--pm-ink-500); margin: 0 0 24px; }

/* Summary card */
.pm-cart-card {
  background: #fff;
  border: 1px solid var(--pm-ink-200);
  border-radius: 12px;
  padding: 24px;
}
.pm-cart-card__h2 { margin: 0 0 16px; font-size: 18px; font-weight: 700; color: var(--pm-ink-900); }
.pm-cart-card__rows { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
.pm-cart-card__row { display: flex; justify-content: space-between; font-size: 14px; color: var(--pm-ink-600); }
.pm-cart-card__row[hidden] { display: none; }
.pm-cart-card__row-val { font-weight: 600; color: var(--pm-ink-900); }
.pm-cart-card__row--savings { color: var(--pm-terracotta); }
.pm-cart-card__row--savings span:last-child { font-weight: 600; }
.pm-cart-card__row--muted { font-size: 13px; color: var(--pm-ink-500); }
/* ── Shipping estimator ── */
.pm-ship__toggle {
  appearance: none; background: none; border: 0; padding: 0; cursor: pointer;
  font: inherit; font-weight: 600; color: var(--pm-terracotta);
  text-decoration: underline; text-underline-offset: 2px;
}
.pm-ship__toggle:hover { color: var(--pm-terracotta-dark, #8f340c); }
.pm-ship__panel {
  margin: 4px 0 2px; padding: 14px; border: 1px solid var(--pm-line, rgba(13,35,64,0.12));
  border-radius: 10px; background: rgba(13,35,64,0.02);
}
.pm-ship__fields { display: grid; gap: 10px; }
@media (min-width: 480px) { .pm-ship__fields { grid-template-columns: 1fr 1fr; } .pm-ship__field--zip { grid-column: 1 / -1; } }
.pm-ship__field { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--pm-ink-600); }
.pm-ship__field span { font-weight: 600; }
.pm-ship__field select, .pm-ship__field input {
  width: 100%; box-sizing: border-box; padding: 8px 10px; font-size: 14px;
  border: 1px solid var(--pm-line, rgba(13,35,64,0.18)); border-radius: 8px;
  background: #fff; color: var(--pm-ink-900);
}
.pm-ship__btn {
  margin-top: 12px; width: 100%; appearance: none; cursor: pointer;
  background: var(--pm-navy, #0d2340); color: #fff; border: 0; border-radius: 8px;
  padding: 10px 14px; font-size: 14px; font-weight: 700;
}
.pm-ship__btn:hover { filter: brightness(1.08); }
.pm-ship__btn:disabled { opacity: 0.6; cursor: default; }
.pm-ship__result { margin-top: 12px; display: flex; flex-direction: column; gap: 6px; }
.pm-ship__rate {
  display: flex; justify-content: space-between; font-size: 14px; color: var(--pm-ink-900);
  padding: 8px 10px; border-radius: 8px; background: #fff; border: 1px solid var(--pm-line, rgba(13,35,64,0.1));
}
.pm-ship__rate-name { display: inline-flex; align-items: center; gap: 8px; }
.pm-ship__rate-tag { font-size: 10px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #137a48; background: #e8f5ee; border: 1px solid #bce8d1; border-radius: 999px; padding: 2px 7px; }
.pm-ship__rate > span:last-child { font-weight: 700; }
.pm-ship__loading, .pm-ship__none { font-size: 13px; color: var(--pm-ink-500); }
.pm-ship__note { margin: 10px 0 0; font-size: 11.5px; color: var(--pm-ink-500); }

.pm-cart-card__total {
  border-top: 1.5px solid var(--pm-ink-200);
  padding-top: 14px;
  margin-bottom: 18px;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.pm-cart-card__total > span:first-child { font-size: 16px; font-weight: 700; color: var(--pm-ink-900); }
.pm-cart-card__total > span:last-child { font-size: 20px; font-weight: 800; color: var(--pm-ink-900); }

.pm-cart-card__note { margin-bottom: 14px; }
.pm-cart-card__note label { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: var(--pm-ink-700); }
.pm-cart-card__note textarea {
  width: 100%;
  padding: 10px 12px;
  border: 1.5px solid var(--pm-ink-200);
  border-radius: 6px;
  font-size: 13px;
  color: var(--pm-ink-900);
  resize: vertical;
  font-family: inherit;
  box-sizing: border-box;
}
.pm-cart-card__continue {
  display: block;
  text-align: center;
  margin-top: 14px;
  font-size: 13px;
  color: var(--pm-ink-500);
  text-decoration: none;
}
.pm-cart-card__continue:hover { color: var(--pm-ink-700); text-decoration: underline; }

/* Buttons */
.pm-cart-page__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 20px;
  border-radius: 8px;
  border: 1px solid transparent;
  font-family: var(--pm-font-body);
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: background var(--pm-dur-fast), color var(--pm-dur-fast), border-color var(--pm-dur-fast);
  text-decoration: none;
}
.pm-cart-page__btn--block { width: 100%; }
.pm-cart-page__btn--primary {
  background: var(--pm-terracotta);
  color: #fff;
  padding: 14px 24px;
  font-size: 15px;
}
.pm-cart-page__btn--primary:hover { background: var(--pm-terracotta-light); color: #fff; }
.pm-cart-page__btn--ghost {
  background: transparent;
  color: var(--pm-ink-700);
}
.pm-cart-page__btn--ghost:hover { background: var(--pm-ink-100); color: var(--pm-ink-900); }

</style>

<script>
(function () {
  var CURRENCY = {{ cart.currency.iso_code | default: shop.currency | json }};

  function formatMoney(cents) {
    try {
      return new Intl.NumberFormat('en-US', {
        style: 'currency', currency: CURRENCY,
        minimumFractionDigits: 2, maximumFractionDigits: 2
      }).format((cents || 0) / 100);
    } catch (e) {
      return '$' + ((cents || 0) / 100).toFixed(2);
    }
  }
  // ─────────────────────────────────────────────────────────────────
  // Stocked-cart qty stepper.
  // ─────────────────────────────────────────────────────────────────
  var pendingQty = {}, inflightQty = {}, debounceTimer = {}, inflight = {};

  function getRow(line) { return document.querySelector('[data-cart-row="' + line + '"]'); }

  function refreshRowDisplay(line) {
    var row = getRow(line); if (!row) return;
    var qty = pendingQty[line]; if (qty == null) return;
    var unitCents = parseInt(row.getAttribute('data-cart-unit-cents'), 10) || 0;
    var origUnit  = parseInt(row.getAttribute('data-cart-unit-original'), 10) || unitCents;
    var qtySpan = row.querySelector('[data-cart-qty-display]');
    if (qtySpan) qtySpan.textContent = qty;
    var priceEl = row.querySelector('[data-cart-line-price]');
    if (priceEl) priceEl.textContent = formatMoney(qty * unitCents);
    // Optimistically scale the struck "was" too (kept in sync with the qty).
    var wasEl = row.querySelector('[data-cart-line-was]');
    if (wasEl && !wasEl.hidden) wasEl.textContent = formatMoney(qty * origUnit);
    var btns = row.querySelectorAll('.pm-qty-btn');
    if (btns[0]) btns[0].setAttribute('data-qty', Math.max(0, qty - 1));
    if (btns[1]) btns[1].setAttribute('data-qty', qty + 1);
    // TC-085: disable + once the line hits its available-stock cap (data-cart-max).
    var _qwrap = row.querySelector('.pm-qty');
    var _max = _qwrap ? parseInt(_qwrap.getAttribute('data-cart-max'), 10) : NaN;
    if (btns[1] && !isNaN(_max)) btns[1].disabled = qty >= _max;
    refreshTotals();
  }

  // Optimistic summary while the shopper clicks the stepper. Subtotal = ORIGINAL
  // price, Total = DISCOUNTED price, Savings = the gap — so the three always
  // reconcile (Subtotal − Savings = Total). Exact within a discount tier; the
  // authoritative server cart (applyServerCart) snaps it after each change so
  // quantity-tiered bulk discounts stay exact across thresholds.
  function refreshTotals() {
    var origCents = 0, finalCents = 0, itemCount = 0;
    document.querySelectorAll('[data-cart-row]').forEach(function (row) {
      var line = row.getAttribute('data-cart-row');
      var q = pendingQty[line];
      if (q == null) {
        var sp = row.querySelector('[data-cart-qty-display]');
        q = sp ? parseInt(sp.textContent, 10) || 0 : 0;
      }
      var finalUnit = parseInt(row.getAttribute('data-cart-unit-cents'), 10) || 0;
      var origUnit  = parseInt(row.getAttribute('data-cart-unit-original'), 10) || finalUnit;
      finalCents += q * finalUnit;
      origCents  += q * origUnit;
      itemCount  += q;
    });
    setSummary(origCents, Math.max(0, origCents - finalCents), finalCents, itemCount);
    updateBadges(itemCount);
  }

  // Shared summary painter — used by the optimistic pass AND the server sync so
  // both render the rows identically. shipCents is folded into Total.
  function setSummary(subtotalCents, savingsCents, itemsTotalCents, itemCount) {
    var sub = document.querySelector('[data-cart-subtotal]'); if (sub) sub.textContent = formatMoney(subtotalCents);
    var srow = document.querySelector('[data-cart-savings-row]');
    var sval = document.querySelector('[data-cart-savings]');
    if (savingsCents > 0) { if (srow) srow.hidden = false; if (sval) sval.textContent = '−' + formatMoney(savingsCents); }
    else if (srow) { srow.hidden = true; }
    var shipCents = window.__pmShipEstimateCents || 0;
    var total = document.querySelector('[data-cart-total]'); if (total) total.textContent = formatMoney(itemsTotalCents + shipCents);
    var lbl = document.querySelector('[data-cart-itemcount-label]');
    if (lbl && itemCount != null) lbl.textContent = 'Subtotal (' + itemCount + ' ' + (itemCount === 1 ? 'item' : 'items') + ')';
  }

  // Header + mobile badges show stocked cart lines PLUS pending quote lines.
  function updateBadges(itemCount) {
    var quoteCount = 0;
    try {
      var _qraw = window.localStorage.getItem('pm:quote:v1');
      if (_qraw) { var _qarr = JSON.parse(_qraw); if (Array.isArray(_qarr)) quoteCount = _qarr.length; }
    } catch (e) {}
    var badgeTotal = itemCount + quoteCount;
    document.querySelectorAll('[data-cart-badge]').forEach(function (badge) {
      if (badgeTotal > 0) { badge.textContent = badgeTotal; badge.removeAttribute('hidden'); }
      else { badge.setAttribute('hidden', ''); }
    });
  }

  // Authoritative sync from a /cart/change.js response. Re-bakes each line's
  // discounted unit + line total + "was"/"% off", then repaints the summary from
  // the real cart — so quantity-tiered bulk discounts are EXACT after each edit,
  // even when a change crosses a tier boundary (10→20→30%).
  function applyServerCart(cart) {
    if (!cart || !cart.items) return;
    var rows = [].slice.call(document.querySelectorAll('[data-cart-row]'));
    var byKey = {};
    cart.items.forEach(function (it) { if (it && it.key != null) byKey[it.key] = it; });
    // Shopify re-keys a line once an automatic discount attaches, so the row's
    // page-load data-cart-key stops matching the change response — which stranded
    // each line on its original tier (summary updated, line didn't). When the
    // row and line counts line up (nothing mid-removal), fall back to DOM order
    // (rows render in cart-line order) and re-pin the key so it matches next time.
    var alignByOrder = rows.length === cart.items.length;
    rows.forEach(function (row, i) {
      var it = byKey[row.getAttribute('data-cart-key')];
      if (!it && alignByOrder) it = cart.items[i];
      if (!it) return;
      if (it.key != null) row.setAttribute('data-cart-key', it.key);
      row.setAttribute('data-cart-unit-cents', it.final_price);
      row.setAttribute('data-cart-unit-original', it.original_price);
      var pe = row.querySelector('[data-cart-line-price]'); if (pe) pe.textContent = formatMoney(it.final_line_price);
      var unit = row.querySelector('[data-cart-unit]'); if (unit) unit.textContent = formatMoney(it.final_price) + ' each';
      var wasEl = row.querySelector('[data-cart-line-was]');
      var saveEl = row.querySelector('[data-cart-save]');
      if (it.original_line_price > it.final_line_price) {
        var pct = Math.round((it.original_line_price - it.final_line_price) / it.original_line_price * 100);
        if (wasEl) { wasEl.textContent = formatMoney(it.original_line_price); wasEl.hidden = false; }
        if (saveEl) { saveEl.textContent = pct + '% off'; saveEl.hidden = false; }
      } else {
        if (wasEl) wasEl.hidden = true;
        if (saveEl) saveEl.hidden = true;
      }
    });
    setSummary(cart.original_total_price, cart.total_discount, cart.total_price, cart.item_count);
    updateBadges(cart.item_count);
  }

  function flushChange(line) {
    if (inflight[line]) return;
    var target = pendingQty[line]; if (target == null) return;
    if (target === inflightQty[line]) return;
    inflight[line] = true; inflightQty[line] = target; var sentQty = target;

    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({ line: parseInt(line, 10), quantity: sentQty })
    }).then(function (r) {
      return r.json().then(function (j) { return { ok: r.ok, body: j }; });
    }).then(function (res) {
      inflight[line] = false;
      if (!res.ok || !res.body.items) {
        // Over available stock → Shopify rejects with 422 and NO cart body.
        // Re-sync this line from the authoritative cart so the row isn't wiped,
        // and pin the real cap so + disables.
        fetch('/cart.js', { headers: { Accept: 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (cart) {
            var it = cart.items && cart.items[parseInt(line, 10) - 1];
            var realQty = it ? it.quantity : 0;
            pendingQty[line] = realQty;
            var cw = getRow(line) && getRow(line).querySelector('.pm-qty');
            if (cw && realQty > 0) cw.setAttribute('data-cart-max', realQty);
            refreshRowDisplay(line);
            applyServerCart(cart); // capped → resync summary + line discounts
          }).catch(function () {});
        return;
      }
      var serverItem = res.body.items && res.body.items[parseInt(line, 10) - 1];
      var serverQty = serverItem ? serverItem.quantity : 0;
      // Snap every line + the summary to the authoritative cart so tiered bulk
      // discounts stay exact as quantities cross 10/20/30-unit thresholds.
      applyServerCart(res.body);
      // TC-085: a capped increment means serverQty IS the real available max —
      // pin it so + disables even when Liquid's inventory_quantity was higher
      // than what's actually sellable online.
      if (serverQty < sentQty) {
        var _capWrap = getRow(line) && getRow(line).querySelector('.pm-qty');
        if (_capWrap) _capWrap.setAttribute('data-cart-max', serverQty);
      }
      if (pendingQty[line] === sentQty) {
        if (serverQty !== pendingQty[line]) {
          pendingQty[line] = serverQty;
          refreshRowDisplay(line);
        }
      } else {
        flushChange(line);
      }
      if (serverQty === 0) {
        var row = getRow(line);
        if (row) {
          row.style.transition = 'opacity 180ms ease';
          row.style.opacity = '0';
          setTimeout(function () { row.remove(); refreshTotals(); }, 200);
        }
        if (res.body.item_count === 0) {
          // Cart emptied → reload so Liquid renders the empty state.
          window.location.assign(window.location.pathname);
        }
      }
    }).catch(function () { inflight[line] = false; });
  }

  function scheduleChange(line) {
    clearTimeout(debounceTimer[line]);
    debounceTimer[line] = setTimeout(function () { flushChange(line); }, 250);
  }

  document.addEventListener('click', function (e) {
    var qBtn = e.target.closest('.pm-qty-btn[data-line]');
    if (qBtn) {
      e.preventDefault();
      var line = qBtn.dataset.line;
      var qty  = Math.max(0, parseInt(qBtn.dataset.qty, 10) || 0);
      pendingQty[line] = qty;
      if (window.__pmClearShipEstimate) window.__pmClearShipEstimate(); // weight changed → estimate stale
      refreshRowDisplay(line);
      scheduleChange(line);
      return;
    }
    var rmLink = e.target.closest('[data-cart-remove]');
    if (rmLink) {
      e.preventDefault();
      var line2 = rmLink.dataset.cartRemove;
      pendingQty[line2] = 0;
      if (window.__pmClearShipEstimate) window.__pmClearShipEstimate(); // contents changed → estimate stale
      var row2 = getRow(line2);
      if (row2) { row2.style.transition = 'opacity 160ms ease'; row2.style.opacity = '0.4'; }
      refreshTotals();
      scheduleChange(line2);
    }
  });

  /* ── Shipping estimator ──
     Uses Shopify's storefront shipping-rates AJAX API against the CURRENT
     cart: the customer picks country / state / ZIP and we show the real
     rates configured in Settings > Shipping and delivery. The cheapest is
     added to the order Total as an estimate (final total is confirmed at
     checkout). Any cart change clears the estimate so it can't go stale. */
  (function () {
    var root = document.querySelector('[data-pm-ship]');
    if (!root) return;
    var panel   = document.querySelector('[data-pm-ship-panel]');
    var toggle  = document.querySelector('[data-pm-ship-toggle]');
    var country = document.querySelector('[data-pm-ship-country]');
    var provWrap= document.querySelector('[data-pm-ship-prov-wrap]');
    var prov    = document.querySelector('[data-pm-ship-province]');
    var zip     = document.querySelector('[data-pm-ship-zip]');
    var go      = document.querySelector('[data-pm-ship-go]');
    var result  = document.querySelector('[data-pm-ship-result]');
    var amount  = document.querySelector('[data-pm-ship-amount]');

    function esc(s){ return String(s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
    function money(cents){ return cents === 0 ? 'FREE' : '$' + (cents/100).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}); }

    // ── Destination resolution ──
    // Two sources, in order: (1) the signed-in customer's saved address
    // rendered by Liquid (data-ship-*); (2) a destination remembered in
    // localStorage from a previous estimate. New customer accounts often
    // don't expose customer.default_address to storefront Liquid, so the
    // remembered destination is what makes auto-estimate reliable — once a
    // customer estimates their address, every later visit auto-calculates.
    var DEST_KEY = 'pm:ship:dest';
    function readDest() { try { var d = JSON.parse(localStorage.getItem(DEST_KEY) || 'null'); return (d && d.country && d.zip) ? d : null; } catch (e) { return null; } }
    function saveDest(d) { try { localStorage.setItem(DEST_KEY, JSON.stringify(d)); } catch (e) {} }

    var remembered = readDest();
    var savedCountry  = root.getAttribute('data-ship-country')  || (remembered && remembered.country)  || 'United States';
    var savedProvince = root.getAttribute('data-ship-province') || (remembered && remembered.province) || '';
    var savedZip      = root.getAttribute('data-ship-zip')      || (remembered && remembered.zip)      || '';
    if (country) {
      for (var i = 0; i < country.options.length; i++) {
        if (country.options[i].value === savedCountry) { country.selectedIndex = i; break; }
      }
      syncProvinces();
      if (savedProvince && prov) prov.value = savedProvince;
      if (savedZip && zip) zip.value = savedZip;
    }

    if (toggle) toggle.addEventListener('click', function () {
      var hidden = panel.hasAttribute('hidden');
      if (hidden) { panel.removeAttribute('hidden'); toggle.setAttribute('aria-expanded','true'); }
      else { panel.setAttribute('hidden',''); toggle.setAttribute('aria-expanded','false'); }
    });

    // ── Auto-estimate on load ──
    // Fire automatically when we have a full destination (country + state +
    // zip) from EITHER the account address or a remembered estimate. The US
    // rate API requires a state, so all three parts are needed. Otherwise
    // the manual "Estimate" flow stands (a guest we've never seen). Any
    // failure/throttle falls back silently to manual.
    if (savedCountry && savedProvince && savedZip) {
      if (amount) amount.textContent = '';
      if (toggle) toggle.textContent = 'Calculating…';
      fetchRates(true);
    }

    if (country) country.addEventListener('change', syncProvinces);
    function syncProvinces() {
      var opt = country.options[country.selectedIndex];
      var provs = [];
      try { provs = JSON.parse(opt.getAttribute('data-provinces') || '[]'); } catch (e) {}
      if (!provs.length) { provWrap.setAttribute('hidden',''); prov.innerHTML = ''; return; }
      prov.innerHTML = provs.map(function (p) { return '<option value="' + esc(p[0]) + '">' + esc(p[0]) + '</option>'; }).join('');
      provWrap.removeAttribute('hidden');
    }

    function fetchRates(auto) {
      var c = country.value;
      var p = provWrap.hasAttribute('hidden') ? '' : prov.value;
      var z = (zip.value || '').trim();
      if (!c) { if (!auto) result.innerHTML = '<span class="pm-ship__none">Choose a country.</span>'; return; }
      if (go) go.disabled = true;
      if (!auto) result.innerHTML = '<span class="pm-ship__loading">Getting rates…</span>';
      var qs = '?shipping_address[country]=' + encodeURIComponent(c) +
               '&shipping_address[province]=' + encodeURIComponent(p) +
               '&shipping_address[zip]=' + encodeURIComponent(z);
      fetch('/cart/shipping_rates.json' + qs, { headers: { Accept: 'application/json' } })
        .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
        .then(function (data) {
          var rates = (data && data.shipping_rates) || [];
          if (!rates.length) {
            if (!auto) result.innerHTML = '<span class="pm-ship__none">No rates for this address — shipping will be calculated at checkout.</span>';
            clearEstimate();
            // Auto path with a known address but no rate: say so plainly
            // instead of a dead "Estimate" affordance (there is no rate to
            // show until one exists in Settings > Shipping and delivery).
            if (auto && toggle) {
              toggle.textContent = 'Calculated at checkout';
              toggle.style.pointerEvents = 'none';
              toggle.style.textDecoration = 'none';
              toggle.style.color = 'var(--pm-ink-500, #64748b)';
            }
            return;
          }
          rates.sort(function (a, b) { return parseFloat(a.price) - parseFloat(b.price); });
          // Informational list — NOT a picker (the shopper chooses the method at
          // checkout). Tag the cheapest "Lowest" so it's clear which rate the
          // estimate reflects, without dressing it up as a selected radio.
          result.innerHTML = rates.map(function (rt, idx) {
            var cents = Math.round(parseFloat(rt.price) * 100);
            var tag = idx === 0 ? '<span class="pm-ship__rate-tag">Lowest</span>' : '';
            return '<div class="pm-ship__rate">' +
                     '<span class="pm-ship__rate-name">' + esc(rt.name) + tag + '</span>' +
                     '<span>' + money(cents) + '</span></div>';
          }).join('');
          // Apply the cheapest as the running estimate + reflect it in the row.
          var cheapest = Math.round(parseFloat(rates[0].price) * 100);
          window.__pmShipEstimateCents = cheapest;
          if (amount) amount.textContent = money(cheapest) + ' ';
          if (toggle) toggle.textContent = 'change';
          if (typeof refreshTotals === 'function') refreshTotals();
          // Remember this destination so future visits auto-calculate.
          saveDest({ country: c, province: p, zip: z });
        })
        .catch(function () {
          // Silent on auto (fall back to the manual "Estimate" affordance);
          // explicit note when the customer clicked the button.
          if (!auto) result.innerHTML = '<span class="pm-ship__none">Couldn’t fetch rates right now — shipping will be calculated at checkout.</span>';
          clearEstimate();
        })
        .finally(function () { if (go) go.disabled = false; });
    }
    if (go) go.addEventListener('click', function () { fetchRates(false); });

    function clearEstimate() {
      window.__pmShipEstimateCents = 0;
      if (amount) amount.textContent = '';
      if (toggle) toggle.textContent = 'Estimate';
      if (result) result.innerHTML = '';
    }
    // A cart mutation (qty change / removal) invalidates the estimate:
    // rates depend on weight/contents, so drop it and let them re-estimate.
    // Exposed so the cart's own qty/remove handlers (outer IIFE) can call it.
    window.__pmClearShipEstimate = clearEstimate;
    document.addEventListener('pm:cart-changed', clearEstimate);
  })();
})();
</script>

{% schema %}
{
  "name": "PM — Cart",
  "settings": []
}
{% endschema %}
