<div class="pm-container" style="padding-top:48px;padding-bottom:80px;">
  <h1 style="font-size:28px;font-weight:700;color:var(--pm-ink-900);margin-bottom:32px;letter-spacing:-0.02em;">Your cart</h1>

  {%- if cart.item_count > 0 -%}
    <div class="pm-cart-layout">

      {%- comment -%} Line items {%- endcomment -%}
      <div class="pm-cart-items">
        {%- for item in cart.items -%}
          <div class="pm-cart-item" style="display:flex;gap:16px;padding:20px 0;border-bottom:1px solid var(--pm-ink-200);">

            {%- comment -%} Product image {%- endcomment -%}
            <a href="{{ item.url }}" style="flex-shrink:0;">
              {%- if item.image -%}
                <img
                  src="{{ item.image | image_url: width: 160 }}"
                  alt="{{ item.image.alt | default: item.product.title | escape }}"
                  width="80"
                  height="80"
                  style="width:80px;height:80px;object-fit:contain;border-radius:6px;border:1px solid var(--pm-ink-200);padding:4px;background:var(--pm-white);"
                  loading="lazy"
                >
              {%- else -%}
                <div style="width:80px;height:80px;border-radius:6px;border:1px solid var(--pm-ink-200);background:var(--pm-ink-100);display:flex;align-items:center;justify-content:center;">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--pm-ink-300)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
              {%- endif -%}
            </a>

            {%- comment -%} Item details {%- endcomment -%}
            <div style="flex:1;min-width:0;">
              <div style="display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;">
                <div>
                  {%- if item.product.vendor != blank -%}
                    <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.08em;color:var(--pm-tan);margin-bottom:4px;">{{ item.product.vendor }}</div>
                  {%- endif -%}
                  <a href="{{ item.url }}" style="font-size:15px;font-weight:600;color:var(--pm-ink-900);text-decoration:none;line-height:1.3;">{{ item.product.title }}</a>
                  {%- unless item.variant.title == 'Default Title' -%}
                    <div style="font-size:13px;color:var(--pm-ink-500);margin-top:2px;">{{ item.variant.title }}</div>
                  {%- endunless -%}
                  {%- if item.variant.sku != blank -%}
                    <div style="font-size:12px;color:var(--pm-ink-400);margin-top:2px;">SKU: {{ item.variant.sku }}</div>
                  {%- endif -%}
                </div>
                <div style="text-align:right;flex-shrink:0;">
                  <div style="font-size:16px;font-weight:700;color:var(--pm-ink-900);">{{ item.final_line_price | money }}</div>
                  {%- if item.original_line_price != item.final_line_price -%}
                    <div style="font-size:13px;color:var(--pm-ink-400);text-decoration:line-through;">{{ item.original_line_price | money }}</div>
                  {%- endif -%}
                  <div style="font-size:12px;color:var(--pm-ink-400);margin-top:2px;">{{ item.final_price | money }} each</div>
                </div>
              </div>

              {%- comment -%} Quantity + remove {%- endcomment -%}
              <div style="display:flex;align-items:center;gap:16px;margin-top:12px;flex-wrap:wrap;">
                <div style="display:flex;align-items:center;border:1.5px solid var(--pm-ink-200);border-radius:6px;overflow:hidden;">
                  <button
                    class="pm-qty-btn"
                    data-cart-qty-url="{{ routes.cart_change_url }}"
                    data-line="{{ forloop.index }}"
                    data-qty="{{ item.quantity | minus: 1 }}"
                    aria-label="Decrease quantity"
                    style="width:36px;height:36px;background:none;border:none;cursor:pointer;font-size:18px;color:var(--pm-ink-700);display:flex;align-items:center;justify-content:center;"
                  >−</button>
                  <span style="min-width:36px;text-align:center;font-size:14px;font-weight:600;color:var(--pm-ink-900);padding:0 4px;">{{ item.quantity }}</span>
                  <button
                    class="pm-qty-btn"
                    data-cart-qty-url="{{ routes.cart_change_url }}"
                    data-line="{{ forloop.index }}"
                    data-qty="{{ item.quantity | plus: 1 }}"
                    aria-label="Increase quantity"
                    style="width:36px;height:36px;background:none;border:none;cursor:pointer;font-size:18px;color:var(--pm-ink-700);display:flex;align-items:center;justify-content:center;"
                  >+</button>
                </div>
                <a
                  href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                  style="font-size:13px;color:var(--pm-ink-400);text-decoration:none;border-bottom:1px solid var(--pm-ink-300);"
                  data-cart-remove="{{ forloop.index }}"
                >Remove</a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Order summary sidebar {%- endcomment -%}
      <div class="pm-cart-summary">
        <div style="background:var(--pm-ink-50,#F9FAFB);border:1.5px solid var(--pm-ink-200);border-radius:12px;padding:28px;">
          <h2 style="font-size:18px;font-weight:700;color:var(--pm-ink-900);margin-bottom:20px;">Order summary</h2>

          <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px;">
            <div style="display:flex;justify-content:space-between;font-size:14px;color:var(--pm-ink-600);">
              <span>Subtotal ({{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %})</span>
              <span style="font-weight:600;color:var(--pm-ink-900);">{{ cart.total_price | money }}</span>
            </div>
            {%- if cart.total_discounts > 0 -%}
              <div style="display:flex;justify-content:space-between;font-size:14px;color:var(--pm-terracotta);">
                <span>Savings</span>
                <span style="font-weight:600;">−{{ cart.total_discounts | money }}</span>
              </div>
            {%- endif -%}
            <div style="display:flex;justify-content:space-between;font-size:13px;color:var(--pm-ink-500);">
              <span>Shipping</span>
              <span>Calculated at checkout</span>
            </div>
          </div>

          <div style="border-top:1.5px solid var(--pm-ink-200);padding-top:16px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:baseline;">
            <span style="font-size:16px;font-weight:700;color:var(--pm-ink-900);">Total</span>
            <span style="font-size:20px;font-weight:800;color:var(--pm-ink-900);">{{ cart.total_price | money }}</span>
          </div>

          {%- comment -%} Cart note {%- endcomment -%}
          <div style="margin-bottom:16px;">
            <label for="pm-cart-note" style="font-size:13px;font-weight:600;color:var(--pm-ink-700);display:block;margin-bottom:6px;">Order note (optional)</label>
            <textarea
              id="pm-cart-note"
              name="note"
              rows="3"
              placeholder="PO number, delivery instructions, etc."
              form="pm-cart-form"
              style="width:100%;padding:10px 12px;border:1.5px solid var(--pm-ink-200);border-radius:6px;font-size:13px;color:var(--pm-ink-900);resize:vertical;font-family:inherit;box-sizing:border-box;"
            >{{ cart.note }}</textarea>
          </div>

          <form id="pm-cart-form" action="{{ routes.cart_url }}" method="post">
            <input type="hidden" name="checkout" value="1">
            <button
              type="submit"
              style="width:100%;background:var(--pm-terracotta);color:white;border:none;border-radius:8px;padding:14px 24px;font-size:15px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:opacity 0.15s;"
              onmouseover="this.style.opacity='0.88';" onmouseout="this.style.opacity='1';"
            >
              Proceed to checkout
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </button>
          </form>

          <a
            href="/collections/all"
            style="display:block;text-align:center;margin-top:14px;font-size:13px;color:var(--pm-ink-500);text-decoration:none;border-bottom:1px solid transparent;"
            onmouseover="this.style.borderBottomColor='var(--pm-ink-400)';" onmouseout="this.style.borderBottomColor='transparent';"
          >← Continue shopping</a>

          {%- comment -%} Trust signals {%- endcomment -%}
          <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--pm-ink-200);display:flex;flex-direction:column;gap:8px;">
            <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--pm-ink-500);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              Secure checkout — SSL encrypted
            </div>
            <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--pm-ink-500);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              Free freight on orders over $5,000
            </div>
            <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--pm-ink-500);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><polyline points="16 21 12 17 8 21"/><polyline points="8 3 12 7 16 3"/></svg>
              Net-30 terms available — contact us
            </div>
          </div>
        </div>
      </div>
    </div>

  {%- else -%}
    {%- comment -%} Empty cart state {%- endcomment -%}
    <div style="text-align:center;padding:80px 24px;">
      <div style="width:64px;height:64px;margin:0 auto 20px;background:var(--pm-ink-100);border-radius:50%;display:flex;align-items:center;justify-content:center;">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--pm-ink-400)" stroke-width="1.5" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
      </div>
      <h2 style="font-size:20px;font-weight:700;color:var(--pm-ink-900);margin-bottom:8px;">Your cart is empty</h2>
      <p style="font-size:15px;color:var(--pm-ink-500);margin-bottom:28px;">Looks like you haven't added any items yet.</p>
      <a
        href="/collections/all"
        class="pm-hero__cta"
        style="display:inline-flex;align-items:center;gap:8px;background:var(--pm-terracotta);color:white;text-decoration:none;padding:12px 24px;border-radius:8px;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;"
      >
        Browse catalog
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  {%- endif -%}
</div>

<style>
.pm-cart-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
}
@media (min-width: 960px) {
  .pm-cart-layout {
    grid-template-columns: 1fr 380px;
    align-items: start;
  }
  .pm-cart-summary {
    position: sticky;
    top: 24px;
  }
}
</style>

<script>
(function() {
  // Cart page reload is fine for now — keeps totals/discounts in sync.
  // (Drawer-style optimistic update would require re-rendering the
  // entire summary block too.)
  function reloadCart() { window.location.reload(); }

  document.addEventListener('click', function (e) {
    var qBtn = e.target.closest('.pm-qty-btn');
    if (qBtn) {
      e.preventDefault();
      var line = qBtn.dataset.line;
      var qty  = parseInt(qBtn.dataset.qty, 10);
      if (qty < 0) qty = 0;
      qBtn.disabled = true;
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ line: parseInt(line, 10), quantity: qty })
      })
        .then(function () { document.dispatchEvent(new CustomEvent('pm:cart-changed')); })
        .then(reloadCart);
      return;
    }
    var rmLink = e.target.closest('[data-cart-remove]');
    if (rmLink) {
      e.preventDefault();
      var line = rmLink.dataset.cartRemove;
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ line: parseInt(line, 10), quantity: 0 })
      })
        .then(function () { document.dispatchEvent(new CustomEvent('pm:cart-changed')); })
        .then(reloadCart);
    }
  });
})();
</script>

{% schema %}
{
  "name": "PM — Cart",
  "settings": []
}
{% endschema %}
