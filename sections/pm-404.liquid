{%- comment -%}
  PM — 404 / static-page renderer.

  Strategy: render BOTH the genuine 404 view AND the seven static bodies
  (hidden) into the same page. JS reads window.location.pathname and
  reveals whichever one matches. This is the reliable fallback for when
  Shopify's `request.path` is empty or normalized inside the 404 context
  — JS sees the real URL every time.
{%- endcomment -%}

{%- comment -%} ── Genuine 404. HIDDEN by default so it can NEVER flash on a static
    page (TC-083): the <head> script reveals the matching static body before paint,
    and the script below reveals THIS only for a real 404. <noscript> reveals it
    too so no-JS still sees something. {%- endcomment -%}
<section class="pm-404" id="pm-404-default" hidden>
  <div class="pm-404__inner">
    <div class="pm-404__code">404</div>
    <h1 class="pm-404__title">Page not found.</h1>
    <p class="pm-404__lead">The link you followed may be broken or the page may have been moved. Use the search bar above or jump back to the catalog.</p>
    <div class="pm-404__actions">
      <a href="{{ routes.root_url }}" class="pm-btn pm-btn--ghost">Back to home</a>
      <a href="{{ routes.all_products_collection_url }}" class="pm-btn pm-btn--primary">Browse catalog
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
{%- comment -%} no-JS: reveal the 404 (static bodies need JS to surface) {%- endcomment -%}
<noscript><style>#pm-404-default{display:block!important}</style></noscript>

{%- comment -%}
  ── All seven static bodies, pre-rendered, hidden ────────────────────
  Each wrapper has data-handle so the JS below can match against the URL.
{%- endcomment -%}
<div id="pm-static-pool" hidden>
  <div data-handle="about">              {%- render 'pm-static-body', handle: 'about',                  fallback: '' -%}</div>
  <div data-handle="brands">             {%- render 'pm-static-body', handle: 'brands',                 fallback: '' -%}</div>
  <div data-handle="contact">            {%- render 'pm-static-body', handle: 'contact',                fallback: '' -%}</div>
  <div data-handle="shipping-returns">   {%- render 'pm-static-body', handle: 'shipping-returns',       fallback: '' -%}</div>
  <div data-handle="site-map">           {%- render 'pm-static-body', handle: 'site-map',               fallback: '' -%}</div>
  <div data-handle="social-responsibility">{%- render 'pm-static-body', handle: 'social-responsibility', fallback: '' -%}</div>
  <div data-handle="order-verification"> {%- render 'pm-static-body', handle: 'order-verification',     fallback: '' -%}</div>
  <div data-handle="compare">            {%- render 'pm-static-body', handle: 'compare',                fallback: '' -%}</div>
  <div data-handle="account">            {%- render 'pm-static-body', handle: 'account',                fallback: '' -%}</div>
</div>

<script>
  (function () {
    var def = document.getElementById('pm-404-default');
    function show404() { if (def) def.removeAttribute('hidden'); } // genuine 404 → reveal it
    var path = window.location.pathname || '';
    var m = path.match(/^\/pages\/([^\/?#]+)/i);
    if (!m) { show404(); return; }
    var handle = m[1].toLowerCase();
    var pool = document.getElementById('pm-static-pool');
    if (!pool) { show404(); return; }
    var match = pool.querySelector('[data-handle="' + handle + '"]');
    if (!match) { show404(); return; }
    // Matched static page → promote it; the 404 placeholder stays hidden + is removed.
    if (def) def.parentNode.removeChild(def);
    pool.removeAttribute('hidden');
    // Move the matched body's children up out of the pool, then drop
    // the pool entirely so its other handles don't render.
    var parent = pool.parentNode;
    while (match.firstChild) parent.insertBefore(match.firstChild, pool);
    parent.removeChild(pool);
    // Fix the document <title> too
    var titles = {
      'about': 'About · Platinum Micro',
      'brands': 'Authorized partner brands · Platinum Micro',
      'contact': 'Contact · Platinum Micro',
      'shipping-returns': 'Shipping & returns · Platinum Micro',
      'site-map': 'Site map · Platinum Micro',
      'social-responsibility': 'Social responsibility · Platinum Micro',
      'order-verification': 'Order verification · Platinum Micro',
      'compare': 'Compare products · Platinum Micro',
      'account': 'My account · Platinum Micro'
    };
    if (titles[handle]) document.title = titles[handle];
    // Re-init dynamic components that look for elements that just appeared
    document.dispatchEvent(new CustomEvent('pm:static-mounted', { detail: { handle: handle } }));
    // Clear the pending flag set by the head script
    if (document.documentElement.dataset.pmStaticPending) {
      delete document.documentElement.dataset.pmStaticPending;
    }
  })();
</script>

{% schema %}
{
  "name": "PM — 404",
  "settings": []
}
{% endschema %}
