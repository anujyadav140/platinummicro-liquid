{%- liquid
  assign card_style = section.settings.card_style | default: 'poster'
  assign columns    = section.settings.columns | default: 6
-%}

{%- comment -%}
  Fallback poster images for the Industries section.
  When a card has no image_picker value set, we look up its title (handleized)
  against this map so the merchant gets sensible defaults out-of-the-box.
  All images already exist on the store's Shopify CDN.
{%- endcomment -%}
{%- assign _cdn_base = 'https://cdn.shopify.com/s/files/1/0715/8841/3523/files/' -%}
{%- assign _fallback_imgs = 'system-integrators:system-integrators.jpg|education:education.png|smb:smb.png|public-sector:public-sector.jpg|healthcare:healthcare.jpg|enterprise:enterprise.jpg' -%}

<section
  class="pm-card-section"
  style="
    --cs-bg:{{ section.settings.bg_color }};
    --cs-pt:{{ section.settings.padding_top }}px;
    --cs-pb:{{ section.settings.padding_bottom }}px;
    --cs-eyebrow:{{ section.settings.eyebrow_color }};
    --cs-title:{{ section.settings.title_color }};
    --cs-subtitle:{{ section.settings.subtitle_color }};
    --cs-title-size:{{ section.settings.title_size_desktop }}px;
    --cs-title-size-m:{{ section.settings.title_size_mobile }}px;
    --cs-subtitle-size:{{ section.settings.subtitle_size }}px;
    --cs-card-radius:{{ section.settings.card_radius }}px;
    --cs-card-aspect:{{ section.settings.card_aspect }};
    --cs-gap:{{ section.settings.gap_desktop }}px;
    --cs-gap-m:{{ section.settings.gap_mobile }}px;
  "
>
  <div class="pm-container">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
      <div class="pm-section-header{% if section.settings.align == 'center' %} pm-section-header--center{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <div class="pm-section-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="pm-section-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="pm-section-subtitle{% if section.settings.align == 'center' %}" style="margin-left:auto;margin-right:auto;{% else -%}"{% endif %}>
            {{ section.settings.subtitle }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        class="pm-card-grid{% if columns <= 3 %} pm-card-grid--3col{% endif %}"
      >
        {%- for block in section.blocks -%}
          {%- if card_style == 'poster' -%}

            {%- comment -%} Resolve image: admin upload wins, else fall back via title handle {%- endcomment -%}
            {%- assign _bg_url = '' -%}
            {%- if block.settings.image != blank -%}
              {%- assign _bg_url = block.settings.image | image_url: width: 800 -%}
            {%- else -%}
              {%- assign _title_key = block.settings.title | handleize -%}
              {%- assign _pairs = _fallback_imgs | split: '|' -%}
              {%- for _p in _pairs -%}
                {%- assign _kv = _p | split: ':' -%}
                {%- if _kv[0] == _title_key -%}
                  {%- assign _bg_url = _cdn_base | append: _kv[1] -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            <li {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a
                  class="pm-poster-card"
                  href="{{ block.settings.link }}"
                  style="
                    {%- if _bg_url != '' -%}
                      background-image: url('{{ _bg_url }}');
                    {%- elsif block.settings.bg_color != blank -%}
                      background-color: {{ block.settings.bg_color }};
                    {%- endif -%}
                  "
                  aria-label="{{ block.settings.title }}"
                >
              {%- else -%}
                <div
                  class="pm-poster-card"
                  style="
                    {%- if _bg_url != '' -%}
                      background-image: url('{{ _bg_url }}');
                    {%- elsif block.settings.bg_color != blank -%}
                      background-color: {{ block.settings.bg_color }};
                    {%- endif -%}
                  "
                >
              {%- endif -%}
                  <div
                    class="pm-poster-card__ribbon"
                    style="
                      {%- if block.settings.ribbon_bg != blank %}background-color:{{ block.settings.ribbon_bg }};{% endif -%}
                      {%- if block.settings.ribbon_text != blank %}color:{{ block.settings.ribbon_text }};{% endif -%}
                    "
                  >
                    {{ block.settings.title }}
                  </div>
              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </li>

          {%- else -%}
            {%- comment -%} Icon tile card {%- endcomment -%}
            <li {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="pm-icon-card" href="{{ block.settings.link }}" style="display:flex;">
              {%- else -%}
                <div class="pm-icon-card">
              {%- endif -%}
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 96 }}"
                    alt="{{ block.settings.title }}"
                    width="48"
                    height="48"
                    style="width:48px;height:48px;object-fit:contain;border-radius:6px;"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="pm-icon-card__icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                  </div>
                {%- endif -%}

                <h3 class="pm-icon-card__title">{{ block.settings.title }}</h3>

                {%- if block.settings.subtitle != blank -%}
                  <p class="pm-icon-card__subtitle">{{ block.settings.subtitle }}</p>
                {%- endif -%}

                {%- if block.settings.link != blank -%}
                  <svg class="pm-icon-card__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M17 7H7M17 7v10"/></svg>
                {%- endif -%}
              {%- if block.settings.link != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PM — Card Section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text",     "id": "eyebrow",  "label": "Eyebrow text",      "default": "WHO WE SERVE" },
    { "type": "text",     "id": "title",    "label": "Section title",     "default": "Industries we serve" },
    { "type": "textarea", "id": "subtitle", "label": "Section subtitle",  "default": "Vertical-specific configurations and contract alignment." },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Cards" },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        { "value": "poster",    "label": "Poster (photo fills card)" },
        { "value": "icon-tile", "label": "Icon tile (white card with icon)" }
      ],
      "default": "poster"
    },
    { "type": "range", "id": "columns",       "label": "Columns on desktop",     "min": 2, "max": 6,  "step": 1, "default": 6 },
    { "type": "range", "id": "card_radius",   "label": "Card border radius",     "min": 0, "max": 24, "step": 1, "unit": "px",  "default": 8 },
    {
      "type": "select",
      "id": "card_aspect",
      "label": "Card aspect ratio (poster)",
      "options": [
        { "value": "2 / 1.3", "label": "Wide (default)" },
        { "value": "1 / 1",   "label": "Square" },
        { "value": "3 / 4",   "label": "Portrait" },
        { "value": "4 / 5",   "label": "Slight portrait" },
        { "value": "16 / 9",  "label": "Cinematic" }
      ],
      "default": "2 / 1.3"
    },

    { "type": "header", "content": "Section spacing" },
    { "type": "color", "id": "bg_color",       "label": "Section background", "default": "#FBFAF7" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",        "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom",     "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "gap_desktop",    "label": "Gap between cards (desktop)", "min": 4, "max": 48, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "gap_mobile",     "label": "Gap between cards (mobile)",  "min": 4, "max": 32, "step": 2, "unit": "px", "default": 12 },

    { "type": "header", "content": "Typography" },
    { "type": "color", "id": "eyebrow_color",      "label": "Eyebrow color",        "default": "#8B7355" },
    { "type": "color", "id": "title_color",        "label": "Title color",          "default": "#101828" },
    { "type": "color", "id": "subtitle_color",     "label": "Subtitle color",       "default": "#667085" },
    { "type": "range", "id": "title_size_desktop", "label": "Title size (desktop)", "min": 18, "max": 56, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "title_size_mobile",  "label": "Title size (mobile)",  "min": 16, "max": 44, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "subtitle_size",      "label": "Subtitle size",        "min": 12, "max": 22, "step": 1, "unit": "px", "default": 15 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "System Integrators"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Card background color (fallback when no image)",
          "default": "#0D2340"
        },
        {
          "type": "color",
          "id": "ribbon_bg",
          "label": "Ribbon badge color (poster style)",
          "default": "#A63D2F"
        },
        {
          "type": "color",
          "id": "ribbon_text",
          "label": "Ribbon text color",
          "default": "#FFFFFF"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PM — Card Section",
      "settings": {
        "eyebrow": "WHO WE SERVE",
        "title": "Industries we serve",
        "subtitle": "Vertical-specific configurations and contract alignment.",
        "card_style": "poster",
        "columns": 6
      },
      "blocks": [
        { "type": "card", "settings": { "title": "System Integrators" } },
        { "type": "card", "settings": { "title": "Education" } },
        { "type": "card", "settings": { "title": "SMB" } },
        { "type": "card", "settings": { "title": "Public Sector" } },
        { "type": "card", "settings": { "title": "Healthcare" } },
        { "type": "card", "settings": { "title": "Enterprise" } }
      ]
    }
  ]
}
{% endschema %}
