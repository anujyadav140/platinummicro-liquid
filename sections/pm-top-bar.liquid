{%- assign top_bar_enabled = section.settings.enabled -%}

{%- if top_bar_enabled -%}

{%- comment -%}
  Promotion blocks
  ----------------
  Admin adds "Promotion" blocks in the theme editor (Customize → PM — Top Bar
  → Add block). Each block is a banner message, optionally tied to a discount
  code created in the Discounts admin and optionally scheduled with start/end
  dates. We build the active promos here, count them, and below either show
  them (rotating if more than one) or fall back to the default trust line.

  Note: the theme can't read the Discounts page directly — the merchant types
  the promo copy + code here. Dates auto-hide a promo outside its window so
  expired sales disappear on their own with no manual edit.
{%- endcomment -%}
{%- assign _now = 'now' | date: '%s' | plus: 0 -%}
{%- assign _promo_count = 0 -%}
{%- capture _promos_html -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'promotion' and block.settings.message != blank -%}
      {%- assign _active = true -%}
      {%- if block.settings.start_date != blank -%}
        {%- assign _start = block.settings.start_date | date: '%s' | plus: 0 -%}
        {%- if _now < _start -%}{%- assign _active = false -%}{%- endif -%}
      {%- endif -%}
      {%- if block.settings.end_date != blank -%}
        {%- comment -%} end date is inclusive — run through end-of-day {%- endcomment -%}
        {%- assign _end = block.settings.end_date | date: '%s' | plus: 86399 -%}
        {%- if _now > _end -%}{%- assign _active = false -%}{%- endif -%}
      {%- endif -%}
      {%- if _active -%}
        {%- assign _promo_count = _promo_count | plus: 1 -%}
        <span class="pm-top-bar__promo" {{ block.shopify_attributes }}>
          {{ block.settings.message }}
          {%- if block.settings.code != blank -%}
            <span class="pm-top-bar__promo-code" title="Use code {{ block.settings.code | escape }} at checkout">{{ block.settings.code }}</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- comment -%}
  Design controls
  ---------------
  These map theme-editor "Design" settings to CSS custom properties on the
  bar root. The CSS in pm-theme.css reads them with var(--ptb-*, fallback),
  so leaving a field blank keeps the original look. Rotation speed is passed
  as a data-* attribute and read by the script below.
{%- endcomment -%}
{%- capture _ptb_style -%}
  {%- if section.settings.bg_color != blank %}--ptb-bg: {{ section.settings.bg_color }};{% endif -%}
  {%- if section.settings.text_color != blank %}--ptb-text: {{ section.settings.text_color }};{% endif -%}
  {%- if section.settings.chip_bg_color != blank %}--ptb-chip-bg: {{ section.settings.chip_bg_color }};{% endif -%}
  {%- if section.settings.chip_text_color != blank %}--ptb-chip-text: {{ section.settings.chip_text_color }};{% endif -%}
  {%- if section.settings.font_size != blank %}--ptb-font: {{ section.settings.font_size }}px;{% endif -%}
  {%- if section.settings.text_align != blank %}--ptb-align: {{ section.settings.text_align }};{% endif -%}
{%- endcapture -%}
{%- assign _ptb_interval = section.settings.rotate_speed | default: 4.5 | times: 1000 | round -%}

<div
  class="pm-top-bar"
  id="pm-top-bar"
  role="banner"
  {%- if _ptb_style != blank %} style="{{ _ptb_style | strip | escape }}"{% endif -%}
>
  <div class="pm-top-bar__inner">
    {%- if _promo_count > 0 -%}
      <div
        class="pm-top-bar__promos"
        data-promo-count="{{ _promo_count }}"
        {%- if _promo_count > 1 %} data-promo-rotate data-promo-interval="{{ _ptb_interval }}"{% endif -%}
      >
        {{ _promos_html }}
      </div>
    {%- else -%}
    <div class="pm-top-bar__trust">
      {%- if section.settings.lead_text != blank -%}
        {{ section.settings.lead_text }}
      {%- else -%}
        <strong>MBE-certified</strong>
        <span class="pm-dot">&middot;</span>
        Authorized HPE &amp; Intel partner
        <span class="pm-dot">&middot;</span>
        {%- comment -%}
          Note: do NOT pipe through `money_without_currency` — that filter assumes
          the input is in cents, so 5000 → "$50.00". We just want the literal number.
        {%- endcomment -%}
        {%- assign _fsm = section.settings.free_ship_min | default: 5000 -%}
        {%- assign _fsm_str = _fsm | round | append: '' -%}
        {%- assign _fsm_len = _fsm_str | size -%}
        {%- if _fsm_len == 4 -%}
          {%- assign _fsm_hd = _fsm_str | slice: 0, 1 -%}
          {%- assign _fsm_tl = _fsm_str | slice: 1, 3 -%}
          {%- assign _fsm_fmt = _fsm_hd | append: ',' | append: _fsm_tl -%}
        {%- elsif _fsm_len == 5 -%}
          {%- assign _fsm_hd = _fsm_str | slice: 0, 2 -%}
          {%- assign _fsm_tl = _fsm_str | slice: 2, 3 -%}
          {%- assign _fsm_fmt = _fsm_hd | append: ',' | append: _fsm_tl -%}
        {%- elsif _fsm_len == 6 -%}
          {%- assign _fsm_hd = _fsm_str | slice: 0, 3 -%}
          {%- assign _fsm_tl = _fsm_str | slice: 3, 3 -%}
          {%- assign _fsm_fmt = _fsm_hd | append: ',' | append: _fsm_tl -%}
        {%- else -%}
          {%- assign _fsm_fmt = _fsm_str -%}
        {%- endif -%}
        Free freight on orders over ${{ _fsm_fmt }}
        <span class="pm-dot">&middot;</span>
        Ships from Southern California
      {%- endif -%}
    </div>
    {%- endif -%}

    <div class="pm-top-bar__right">
      <button
        class="pm-top-bar__dismiss"
        id="pm-top-bar-dismiss"
        type="button"
        aria-label="Dismiss"
        data-pm-top-bar-dismiss
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  // Restore dismissed state from cookie on page load
  if (document.cookie.indexOf('pm-top-bar-dismissed=1') !== -1) {
    var bar = document.getElementById('pm-top-bar');
    if (bar) bar.style.display = 'none';
  }

  // Rotate multiple active promotions, one at a time (~4.5s each).
  (function () {
    var wrap = document.querySelector('[data-promo-rotate]');
    if (!wrap) return;
    var items = wrap.querySelectorAll('.pm-top-bar__promo');
    if (items.length < 2) return;
    // Rotation speed is set in the theme editor (Design → Rotation speed).
    var interval = parseInt(wrap.getAttribute('data-promo-interval'), 10) || 4500;
    var i = 0;
    items.forEach(function (el, idx) { el.style.display = idx === 0 ? '' : 'none'; });
    setInterval(function () {
      items[i].style.display = 'none';
      i = (i + 1) % items.length;
      items[i].style.display = '';
    }, interval);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "PM — Top Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show top bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Promotions"
    },
    {
      "type": "paragraph",
      "content": "Add Promotion blocks below to advertise sales in the bar. Active promotions replace the trust line; if you add more than one, they rotate. Tip: create the matching code in Discounts, then enter it here so shoppers see it."
    },
    {
      "type": "header",
      "content": "Trust line (shown when no promotion is active)"
    },
    {
      "type": "textarea",
      "id": "lead_text",
      "label": "Trust line (HTML supported)",
      "info": "Leave blank to use the default trust signals. Use <strong> for bold text.",
      "placeholder": "<strong>MBE-certified</strong> · Authorized HPE &amp; Intel partner · Free freight on orders over $5,000"
    },
    {
      "type": "number",
      "id": "free_ship_min",
      "label": "Free shipping minimum ($)",
      "default": 5000
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "paragraph",
      "content": "Leave any field blank to keep the default theme look. Colors apply to the whole bar; chip colors apply to the discount-code pill."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "chip_bg_color",
      "label": "Discount chip background"
    },
    {
      "type": "color",
      "id": "chip_text_color",
      "label": "Discount chip text"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Text size",
      "min": 10,
      "max": 16,
      "step": 0.5,
      "unit": "px",
      "default": 11.5
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Promotion alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "rotate_speed",
      "label": "Rotation speed (multiple promos)",
      "min": 2,
      "max": 10,
      "step": 0.5,
      "unit": "s",
      "default": 4.5
    }
  ],
  "blocks": [
    {
      "type": "promotion",
      "name": "Promotion",
      "settings": [
        {
          "type": "text",
          "id": "message",
          "label": "Message",
          "info": "e.g. Save 10% on all HPE servers"
        },
        {
          "type": "text",
          "id": "code",
          "label": "Discount code (optional)",
          "info": "Shown as a highlighted chip. Create the code in Discounts first so it works at checkout."
        },
        {
          "type": "text",
          "id": "start_date",
          "label": "Start date (optional)",
          "info": "Format YYYY-MM-DD. Leave blank to start immediately."
        },
        {
          "type": "text",
          "id": "end_date",
          "label": "End date (optional)",
          "info": "Format YYYY-MM-DD. Promotion auto-hides after this day. Leave blank for no end."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "PM — Top Bar" }
  ]
}
{% endschema %}
