{%- comment -%}
  PM — Customer Login
  1:1 port of the Hydrogen storefront's app/routes/account_.login.tsx
  Two-column layout on a paper background:
    LEFT  – "Open a business account" pitch (paper bg, light card style)
    RIGHT – Returning customer sign-in form (paper bg, light card style)

  NOTE: /account/login and /account/register are hardcoded ON PURPOSE — pm-plp.js
  intercepts clicks on exactly `a[href="/account/login"]` / `a[href="/account/register"]`
  and redirects to the New-Customer-Accounts hosted flow. Swapping to route objects
  would change the href and break that interception, so HardcodedRoutes is disabled here.
{%- endcomment -%}
{% # theme-check-disable HardcodedRoutes %}

{%- assign show_registered = false -%}
{%- if request.path contains '?' -%}
  {%- assign _qs = request.path | split: '?' | last -%}
  {%- if _qs contains 'registered=1' -%}
    {%- assign show_registered = true -%}
  {%- endif -%}
{%- endif -%}

<div class="pm-auth-page">
  <div class="pm-auth-page__inner">

    {%- comment -%} Success banner — shown after registration redirect {%- endcomment -%}
    {%- if show_registered -%}
      <div class="pm-auth-flash pm-auth-flash--ok">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <div>
          <div class="pm-auth-flash__title">Account created!</div>
          <div class="pm-auth-flash__body">Your business account is ready. Sign in below to get started.</div>
        </div>
      </div>
    {%- endif -%}

    <div class="pm-login-layout">

      {%- comment -%} ── LEFT: New customer pitch ──────────────────────────── {%- endcomment -%}
      <section class="pm-login-pane" aria-labelledby="pm-login-new">
        <div class="pm-login-pane__eyebrow">New customer?</div>
        <h2 id="pm-login-new" class="pm-login-pane__title">Open a business<br>account.</h2>

        <p class="pm-login-pane__lead">Open an account and you'll be able to:</p>
        <ul class="pm-login-pane__list">
          <li>Check out faster</li>
          <li>Save multiple shipping addresses</li>
          <li>Access your order history</li>
          <li>Track new orders</li>
          <li>Save items to your lists</li>
        </ul>

        <a href="/account/register" class="pm-btn pm-btn--primary pm-btn--block">
          Create Account
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>

        <p class="pm-auth-fineprint">
          By signing up, you agree to Platinum Micro's
          <a href="/policies/terms-of-service">Terms</a> and
          <a href="/policies/privacy-policy">Privacy Policy</a>.
        </p>
      </section>

      {%- comment -%} ── RIGHT: Sign-in form ───────────────────────────────── {%- endcomment -%}
      <section class="pm-login-pane" aria-labelledby="pm-login-return">
        <div class="pm-login-pane__eyebrow">Returning customer</div>
        <h1 id="pm-login-return" class="pm-login-pane__title">Sign in to your<br>account.</h1>

        {%- form 'customer_login' -%}

          {%- comment -%} Pass returnTo through if present {%- endcomment -%}
          {%- if request.path contains 'return_to' -%}
            <input type="hidden" name="return_to" value="{{ request.path | split: 'return_to=' | last | url_decode }}">
          {%- endif -%}

          {%- if form.errors -%}
            <div class="pm-auth-flash pm-auth-flash--err">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DC2626" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <div>
                <div class="pm-auth-flash__title">Sign in failed</div>
                {%- for error in form.errors -%}
                  <div class="pm-auth-flash__body">{{ form.errors.messages[error] }}</div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <div class="pm-login-fields">
            {%- render 'pm-form-field',
                label:        'Email address',
                name:         'customer[email]',
                type:         'email',
                required:     true,
                placeholder:  'you@company.com',
                autocomplete: 'email',
                value:        form.email,
                error:        form.errors.messages['email']
            -%}
            {%- render 'pm-form-field',
                label:        'Password',
                name:         'customer[password]',
                type:         'password',
                required:     true,
                placeholder:  '••••••••',
                autocomplete: 'current-password',
                error:        form.errors.messages['password']
            -%}
          </div>

          <div class="pm-login-forgot">
            <a href="/account/login#recover">Forgot password?</a>
          </div>

          <button type="submit" class="pm-btn pm-btn--primary pm-btn--block">
            Sign in
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>

        {%- endform -%}

        <p class="pm-auth-fineprint">
          By signing in, you agree to Platinum Micro's
          <a href="/policies/terms-of-service">Terms</a> and
          <a href="/policies/privacy-policy">Privacy Policy</a>.
        </p>

        {%- comment -%} ── Recover password panel (anchor target #recover) ─ {%- endcomment -%}
        <div id="recover-section" class="pm-login-recover" hidden>
          <h3 class="pm-login-recover__title">Reset your password</h3>
          <p class="pm-login-recover__lead">Enter your email and we'll send you a reset link.</p>
          {%- form 'recover_customer_password' -%}
            {%- if form.posted_successfully? -%}
              <div class="pm-auth-flash pm-auth-flash--ok">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <div>
                  <div class="pm-auth-flash__title">Check your inbox</div>
                  <div class="pm-auth-flash__body">We've sent a reset link to that email.</div>
                </div>
              </div>
            {%- else -%}
              {%- render 'pm-form-field',
                  label:        'Email address',
                  name:         'email',
                  type:         'email',
                  required:     true,
                  placeholder:  'you@company.com',
                  autocomplete: 'email',
                  error:        form.errors.messages['email']
              -%}
              <button type="submit" class="pm-btn pm-btn--navy pm-btn--block" style="margin-top:16px;">
                Send reset link
              </button>
            {%- endif -%}
          {%- endform -%}
          <div class="pm-login-recover__back">
            <a href="/account/login">← Back to sign in</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<style>
  /* Local styles for the auth pages — kept here so they ship with the section */
  .pm-auth-page {
    min-height: 60vh;
    background: var(--pm-paper);
    padding: 48px 16px 80px;
  }
  .pm-auth-page__inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .pm-login-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 880px) {
    .pm-login-layout {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }

  .pm-login-pane {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .pm-login-pane__eyebrow {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pm-tan);
  }
  .pm-login-pane__title {
    font-size: 28px;
    font-weight: 800;
    color: var(--pm-ink-900);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
  }
  @media (min-width: 640px) {
    .pm-login-pane__title { font-size: 32px; }
  }
  .pm-login-pane__lead {
    margin: 0;
    font-size: 14px;
    color: var(--pm-ink-700);
  }
  .pm-login-pane__list {
    list-style: disc;
    padding-left: 20px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pm-login-pane__list li {
    font-size: 14px;
    color: var(--pm-ink-700);
    line-height: 1.5;
  }

  .pm-login-fields {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 8px;
  }
  .pm-login-forgot {
    margin: 4px 0 12px;
  }
  .pm-login-forgot a {
    font-size: 13px;
    color: var(--pm-ink-700);
    border-bottom: 1px solid var(--pm-ink-300);
    transition: color 0.15s, border-color 0.15s;
  }
  .pm-login-forgot a:hover {
    color: var(--pm-navy-deep);
    border-bottom-color: var(--pm-navy-deep);
  }

  /* Shared button */
  .pm-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: none;
    cursor: pointer;
    text-decoration: none;
    font-family: var(--pm-font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 14px;
    padding: 13px 24px;
    border-radius: 8px;
    transition: background var(--pm-dur-fast), opacity var(--pm-dur-fast);
  }
  .pm-btn--block { width: 100%; }
  .pm-btn--primary {
    background: var(--pm-terracotta);
    color: #fff;
  }
  .pm-btn--primary:hover {
    background: var(--pm-terracotta-light);
    color: #fff;
  }
  .pm-btn--navy {
    background: var(--pm-navy-deep);
    color: #fff;
  }
  .pm-btn--navy:hover { opacity: 0.9; }

  .pm-auth-fineprint {
    font-size: 12.5px;
    color: var(--pm-ink-500);
    margin: 0;
    line-height: 1.5;
  }
  .pm-auth-fineprint a {
    color: var(--pm-ink-700);
    border-bottom: 1px solid var(--pm-ink-300);
  }
  .pm-auth-fineprint a:hover {
    color: var(--pm-terracotta);
    border-bottom-color: var(--pm-terracotta);
  }

  .pm-auth-flash {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    border-radius: 10px;
    padding: 14px 16px;
    margin-bottom: 24px;
  }
  .pm-auth-flash svg { flex-shrink: 0; margin-top: 1px; }
  .pm-auth-flash__title { font-size: 13px; font-weight: 700; margin-bottom: 2px; }
  .pm-auth-flash__body  { font-size: 13px; line-height: 1.5; }
  .pm-auth-flash--ok {
    background: #F0FDF4;
    border: 1.5px solid #86EFAC;
  }
  .pm-auth-flash--ok .pm-auth-flash__title { color: #15803D; }
  .pm-auth-flash--ok .pm-auth-flash__body  { color: #166534; }
  .pm-auth-flash--err {
    background: #FEF2F2;
    border: 1.5px solid #FCA5A5;
  }
  .pm-auth-flash--err .pm-auth-flash__title { color: #B91C1C; }
  .pm-auth-flash--err .pm-auth-flash__body  { color: #991B1B; }

  .pm-login-recover {
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1.5px solid var(--pm-ink-200);
  }
  .pm-login-recover[hidden] { display: none; }
  .pm-login-recover__title {
    font-size: 18px;
    font-weight: 700;
    color: var(--pm-ink-900);
    margin: 0 0 6px;
  }
  .pm-login-recover__lead {
    font-size: 14px;
    color: var(--pm-ink-500);
    margin: 0 0 20px;
  }
  .pm-login-recover__back {
    text-align: center;
    margin-top: 14px;
  }
  .pm-login-recover__back a {
    font-size: 13px;
    color: var(--pm-ink-500);
    border-bottom: 1px solid var(--pm-ink-300);
  }
</style>

<script>
(function () {
  // Show recover panel if hash is #recover
  function checkHash() {
    var panel = document.getElementById('recover-section');
    if (!panel) return;
    if (window.location.hash === '#recover') {
      panel.removeAttribute('hidden');
    } else {
      panel.setAttribute('hidden', '');
    }
  }
  checkHash();
  window.addEventListener('hashchange', checkHash);
})();
</script>

{% schema %}
{
  "name": "PM — Customer Login",
  "settings": []
}
{% endschema %}
