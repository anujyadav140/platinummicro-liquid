{%- comment -%}
  PM — Collection page (PLP)
  Single section that replaces the older pm-collection-header + pm-product-grid.
  Layout:
    pm-plp__head   — breadcrumb + title + "showing N of M products"
    pm-plp__rail   — pm-facets sidebar (Brand, Price, Availability, etc.)
    pm-plp__main   — toolbar (grid/list, Show-N, Sort) + grid + pagination
{%- endcomment -%}

{%- assign per_page    = section.settings.products_per_page | default: 24 -%}
{%- assign columns_d   = section.settings.columns_desktop   | default: 3  -%}

{%- paginate collection.products by per_page -%}

<section class="pm-plp">
  <div class="pm-container pm-plp__inner">

    {%- comment -%} TOP STRIP — breadcrumb+count on left, toolbar on right (1 row) {%- endcomment -%}
    <header class="pm-plp__head" id="pm-plp-header">
      <div class="pm-plp__head-left">
        <nav class="pm-breadcrumb" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Home
          </a>
          <span class="pm-breadcrumb__sep" aria-hidden="true">›</span>
          <span aria-current="page" class="pm-breadcrumb__current">{{ collection.title }}</span>
        </nav>
        <h1 class="pm-plp__title">{{ collection.title }}</h1>
        {%- if collection.products_count > 0 -%}
          {%- assign _page_size_real = collection.products | size -%}
          {%- assign _start = paginate.current_offset | plus: 1 -%}
          {%- assign _end   = paginate.current_offset | plus: _page_size_real -%}
          <p class="pm-plp__count">Showing <strong>{{ _start }}–{{ _end }}</strong> of <strong>{{ paginate.items }}</strong> products</p>
        {%- elsif collection.description != blank -%}
          <p class="pm-plp__lead">{{ collection.description | strip_html | truncatewords: 30 }}</p>
        {%- endif -%}
      </div>

      <div class="pm-plp__toolbar">
        <div class="pm-plp__view-toggle" role="group" aria-label="View">
          <button type="button" class="pm-plp__view-btn is-active" data-pm-view="grid" aria-pressed="true" aria-label="Grid view">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          </button>
          <button type="button" class="pm-plp__view-btn" data-pm-view="list" aria-pressed="false" aria-label="List view">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </button>
        </div>

        <div class="pm-plp__control">
          <label for="pm-plp-pagesize" class="pm-plp__control-label">Show</label>
          {%- assign _page_sizes = '12,24,36,48' | split: ',' -%}
          {%- comment -%} TC-091: page size is client-side (Shopify can't change page size via URL); pm-pagesize.js paginates virtually. {%- endcomment -%}
          <select id="pm-plp-pagesize" aria-label="Products per page">
            {%- for n in _page_sizes -%}
              {%- assign _n_int = n | times: 1 -%}
              <option value="{{ n }}"{% if per_page == _n_int %} selected{% endif %}>{{ n }}</option>
            {%- endfor -%}
          </select>
        </div>

        {%- assign current_sort = collection.sort_by | default: collection.default_sort_by | default: 'manual' -%}
        {%- render 'pm-sort-menu', current: current_sort, context: 'collection' -%}
      </div>
    </header>

    <div class="pm-plp__body">

      {%- comment -%} LEFT RAIL ─ facets {%- endcomment -%}
      <aside class="pm-plp__rail" aria-label="Filters">
        {%- render 'pm-facets', results: collection -%}
      </aside>

      {%- comment -%} MAIN ─ grid + pagination {%- endcomment -%}
      <div class="pm-plp__main">

        <div id="pm-plp-grid-wrap" class="pm-plp__grid-wrap" data-pm-cols="{{ columns_d }}">
          {%- comment -%} TC-088: GLOBAL in-stock-first. The server double-loop below emits
              available-before-quote per page (no-JS / crawler fallback). The <head> prefetch +
              the fast-path script after the grid stitch the two availability views into the
              global order. Shimmer-skeleton the grid before first paint so the per-page
              (quote-heavy) order never flashes before the global order is ready — no reshuffle.
              No-JS skips this; the 6s failsafe always reveals. {%- endcomment -%}
          <script>
            (function () {
              try {
                var sp = new URLSearchParams(window.location.search).getAll('filter.v.availability');
                var split = sp.length === 0 || (sp.indexOf('1') !== -1 && sp.indexOf('0') !== -1);
                var w = document.currentScript && document.currentScript.parentElement;
                if (split && w) {
                  w.classList.add('is-reordering');
                  setTimeout(function () { w.classList.remove('is-reordering'); }, 6000);
                }
              } catch (e) {}
            })();
          </script>
          {%- if collection.products.size > 0 -%}
            <ul class="pm-plp__grid" data-pm-view-mode="grid" data-pm-total="{{ paginate.items }}" data-pm-server-size="{{ per_page }}">
              {%- comment -%} TC-088 in-stock-first (server-side): emit available
                  products first, then "Available for Quote", preserving the chosen
                  sort within each group. _emitted tracks the global output position
                  so the first row stays eager for LCP regardless of grouping. {%- endcomment -%}
              {%- assign _emitted = 0 -%}
              {%- comment -%} "In stock" = tracked, positive qty (see snippet pm-instock); NOT product.available, which counts untracked / continue-selling items as in-stock. {%- endcomment -%}
              {%- for product in collection.products -%}
                {%- capture _isc -%}{%- render 'pm-instock', product: product -%}{%- endcapture -%}
                {%- if _isc contains 'true' -%}
                  {%- if _emitted < columns_d -%}
                    <li>{%- render 'pm-product-card', product: product, eager: true -%}</li>
                  {%- else -%}
                    <li>{%- render 'pm-product-card', product: product -%}</li>
                  {%- endif -%}
                  {%- assign _emitted = _emitted | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
              {%- for product in collection.products -%}
                {%- capture _isc -%}{%- render 'pm-instock', product: product -%}{%- endcapture -%}
                {%- unless _isc contains 'true' -%}
                  {%- if _emitted < columns_d -%}
                    <li>{%- render 'pm-product-card', product: product, eager: true -%}</li>
                  {%- else -%}
                    <li>{%- render 'pm-product-card', product: product -%}</li>
                  {%- endif -%}
                  {%- assign _emitted = _emitted | plus: 1 -%}
                {%- endunless -%}
              {%- endfor -%}
            </ul>

            {%- comment -%} TC-088 FAST PATH: re-order the grid in-stock-first the INSTANT the
                <head> prefetch lands — running here (right after the grid parses) means it can
                happen before the deferred pm-pagesize.js runs at DOMContentLoaded. Only the
                default first page (page 1, page-size ≤ server page) is fast-pathed; anything
                else (deep page, larger page size, prefetch missing/failed, or pm-pagesize
                already booted) is left to pm-pagesize.js. SECURITY: clones only product-card
                <li> nodes from the same-origin grid-only render (DOMParser does not run
                scripts); no eval, no untrusted innerHTML. {%- endcomment -%}
            <script>
              (function () {
                try {
                  if (window.__pmBooted) return;
                  var st = window.__pmStitch;
                  if (!st || !st.in1) return;
                  var wrap = document.getElementById('pm-plp-grid-wrap');
                  var grid = wrap && wrap.querySelector('.pm-plp__grid');
                  if (!wrap || !grid) return;
                  var up = new URLSearchParams(window.location.search).get('page');
                  if (up && up !== '1') return;
                  var serverSize = parseInt(grid.getAttribute('data-pm-server-size'), 10) || 24;
                  var pageSize = serverSize;
                  try { var sz = parseInt(localStorage.getItem('pm-page-size'), 10); if (sz > 0) pageSize = sz; } catch (e) {}
                  if (pageSize > serverSize) return;
                  var handleOf = function (li) {
                    var h = li.querySelector('[data-product-handle]');
                    if (h) return h.getAttribute('data-product-handle');
                    var a = li.querySelector('a[href*="/products/"]');
                    var m = a && a.getAttribute('href').match(/\/products\/([^/?#]+)/);
                    return m ? m[1] : null;
                  };
                  // Quote cards for page 1 are ALREADY rendered server-side (in the DOM under the
                  // skeleton). So we only wait on the SMALL in-stock fetch, then prepend it and
                  // fill the rest from the existing cards (deduped) — no quote fetch on the
                  // critical path. (pm-pagesize.js still uses the quote view for deeper pages.)
                  var serverCards = Array.prototype.slice.call(grid.children);
                  st.in1.then(function (html) {
                    if (window.__pmBooted || html == null) return;
                    var ig = new DOMParser().parseFromString(html, 'text/html').querySelector('.pm-plp__grid');
                    var inTotal = ig ? (parseInt(ig.getAttribute('data-pm-total'), 10) || 0) : 0;
                    if (inTotal > serverSize) return; // >1 page of in-stock (rare) → let pm-pagesize do the full stitch
                    var insCards = ig ? Array.prototype.slice.call(ig.children) : [];
                    var insH = {}; insCards.forEach(function (li) { var h = handleOf(li); if (h) insH[h] = 1; });
                    var frag = document.createDocumentFragment(), n = 0, i;
                    for (i = 0; i < insCards.length && n < pageSize; i++, n++) frag.appendChild(insCards[i].cloneNode(true));
                    for (i = 0; i < serverCards.length && n < pageSize; i++) {
                      var h = handleOf(serverCards[i]);
                      if (h && insH[h]) continue; // already shown in the in-stock block
                      frag.appendChild(serverCards[i].cloneNode(true)); n++;
                    }
                    if (!frag.childNodes.length) return;
                    if (grid.replaceChildren) { grid.replaceChildren(frag); } else { grid.innerHTML = ''; grid.appendChild(frag); }
                    wrap.classList.remove('is-reordering');
                    wrap.classList.remove('is-loading');
                    window.__pmStitchEarly = true;
                    if (window.PmAddToCart && window.PmAddToCart.syncMaxed) window.PmAddToCart.syncMaxed();
                  });
                } catch (e) {}
              })();
            </script>

            {%- if paginate.pages > 1 -%}
              <nav class="pm-pagination" aria-label="Pagination">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="pm-pagination__nav">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                    Previous
                  </a>
                {%- endif -%}
                <ul class="pm-pagination__pages">
                  {%- for part in paginate.parts -%}
                    <li>
                      {%- if part.is_link -%}
                        <a href="{{ part.url }}">{{ part.title }}</a>
                      {%- elsif part.title == paginate.current_page -%}
                        <span class="is-current" aria-current="page">{{ part.title }}</span>
                      {%- else -%}
                        <span class="is-ellipsis">{{ part.title }}</span>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="pm-pagination__nav">
                    Next
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
                  </a>
                {%- endif -%}
              </nav>
            {%- endif -%}

          {%- else -%}
            <div class="pm-plp__empty">
              <p class="pm-plp__empty-title">No products match these filters.</p>
              <a href="{{ collection.url | default: request.path }}" class="pm-btn pm-btn--primary">Clear filters</a>
            </div>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  // updateQueryStringParameter is referenced by the Show-N <select>
  // (inline onchange). View-toggle + sort handlers are in pm-plp.js.
  function updateQueryStringParameter(uri, key, value) {
    var re = new RegExp("([?&])" + key + "=.*?(&|$)", "i");
    var sep = uri.indexOf('?') !== -1 ? '&' : '?';
    if (uri.match(re)) return uri.replace(re, '$1' + key + '=' + value + '$2');
    return uri + sep + key + '=' + value;
  }
</script>

{%- endpaginate -%}

{% schema %}
{
  "name": "PM — Collection",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
