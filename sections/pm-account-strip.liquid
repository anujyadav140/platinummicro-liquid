{%- comment -%}
  PM — Account Strip
  A slim "signed-in" strip shown under the header to logged-in customers:
  welcome + quick links to account, orders, support phone, messages, and
  returns. Rendered from layout/theme.liquid (after the header). Hidden
  for guests and on the account dashboard (which already shows this).
  Styles: pm-account.css (.pm-acctstrip*).
{%- endcomment -%}
{%- comment -%}
  Visible to signed-in customers. Also rendered inside the theme editor
  (request.design_mode) even with no customer, so merchants can see and
  drag the strip while positioning it. Guests on the live site see nothing.
{%- endcomment -%}
{%- assign _show_strip = false -%}
{%- if section.settings.enabled -%}
  {%- if customer or request.design_mode -%}{%- assign _show_strip = true -%}{%- endif -%}
{%- endif -%}
{%- if _show_strip -%}
  {%- comment -%} Build the New-Customer-Accounts sub-routes off routes.account_url {%- endcomment -%}
  {%- assign _parts = routes.account_url | split: '?' -%}
  {%- assign _abase = _parts | first -%}
  {%- assign _aqs = '' -%}
  {%- if _parts.size > 1 -%}{%- assign _aqs = '?' | append: _parts.last -%}{%- endif -%}
  {%- assign _phone = section.settings.phone | default: '818 505 6853' -%}
  {%- assign _tel = _phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '+' -%}
  {%- assign _messages = section.settings.messages_url | default: '/pages/contact' -%}
  {%- assign _returns = section.settings.returns_url | default: '/pages/shipping-returns' -%}

  <section class="pm-acctstrip" aria-label="Your account shortcuts">
    <div class="pm-container pm-acctstrip__row">

      <div class="pm-acctstrip__card">
        <svg class="pm-acctstrip__ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <div class="pm-acctstrip__body">
          <span class="pm-acctstrip__label">Welcome back, {{ customer.first_name | default: 'there' | escape }}</span>
          {%- comment -%} routes.account_url lands on the Orders tab by default; point at /profile explicitly. {%- endcomment -%}
          <a class="pm-acctstrip__link" href="{{ _abase }}/profile{{ _aqs }}">Go to your account</a>
        </div>
      </div>

      <div class="pm-acctstrip__card">
        <svg class="pm-acctstrip__ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 3v5h5"/><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"/><path d="M12 7v5l3 3"/></svg>
        <div class="pm-acctstrip__body">
          <span class="pm-acctstrip__label">Order History</span>
          <a class="pm-acctstrip__link" href="{{ _abase }}/orders{{ _aqs }}">Go to your orders</a>
        </div>
      </div>

      <div class="pm-acctstrip__card">
        <svg class="pm-acctstrip__ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
        <div class="pm-acctstrip__body">
          <span class="pm-acctstrip__label">My Quotes</span>
          {%- comment -%} Opens the Quotify quote cart (pm-account-strip.js clicks the app's sticky button). {%- endcomment -%}
          <a class="pm-acctstrip__link" href="#" data-pm-open-quote-cart>View your quote cart</a>
        </div>
      </div>

      <div class="pm-acctstrip__card">
        <svg class="pm-acctstrip__ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <div class="pm-acctstrip__body">
          <span class="pm-acctstrip__label">Need help?</span>
          <a class="pm-acctstrip__link" href="tel:{{ _tel }}">Call us: {{ _phone }}</a>
        </div>
      </div>

      <div class="pm-acctstrip__card">
        <svg class="pm-acctstrip__ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>
        <div class="pm-acctstrip__body">
          <span class="pm-acctstrip__label">Drop us a message</span>
          <a class="pm-acctstrip__link" href="{{ _messages }}">Go to your messages</a>
        </div>
      </div>

      <div class="pm-acctstrip__card">
        <svg class="pm-acctstrip__ico" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>
        <div class="pm-acctstrip__body">
          <span class="pm-acctstrip__label">Organise a return</span>
          <a class="pm-acctstrip__link" href="{{ _returns }}">Go to returns</a>
        </div>
      </div>

    </div>
  </section>

  {%- comment -%} "My Quotes" opens Quotify's quote cart by triggering its sticky button. {%- endcomment -%}
  <script>
    (function () {
      if (window.__pmQuoteCartBound) return;
      window.__pmQuoteCartBound = true;
      document.addEventListener('click', function (e) {
        var t = e.target.closest('[data-pm-open-quote-cart]');
        if (!t) return;
        e.preventDefault();
        var q = document.querySelector('.quotify-sticky-cart-btn, [class*="quotify-sticky-cart"], [class*="quotify-quote-cart-btn"]');
        if (q) { q.click(); }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "PM — Account Strip",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show strip to signed-in customers", "default": true },
    { "type": "text", "id": "phone", "label": "Support phone", "default": "818 505 6853" },
    { "type": "url", "id": "messages_url", "label": "Messages link", "info": "Defaults to /pages/contact" },
    { "type": "url", "id": "returns_url", "label": "Returns link", "info": "Defaults to /pages/shipping-returns" }
  ],
  "presets": [
    { "name": "PM — Account Strip" }
  ]
}
{% endschema %}
