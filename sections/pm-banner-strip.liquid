{%- comment -%}
  PM — Banner Strip
  Slim full-width text strip (typically "Free freight…" line above the
  header). Now exposes padding, font size, alignment, and link color
  to the admin via CSS custom properties on the root.
{%- endcomment -%}
{%- if section.settings.text != blank -%}
  <div
    class="pm-banner-strip pm-banner-strip--align-{{ section.settings.text_align | default: 'center' }}"
    style="
      --bs-bg:{{ section.settings.bg_color }};
      --bs-text:{{ section.settings.text_color }};
      --bs-link:{{ section.settings.link_color }};
      --bs-pt:{{ section.settings.padding_top }}px;
      --bs-pb:{{ section.settings.padding_bottom }}px;
      --bs-size:{{ section.settings.font_size }}px;
    "
  >
    <div class="pm-banner-strip__inner">
      {{ section.settings.text }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "PM — Banner Strip",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "richtext", "id": "text", "label": "Strip text (HTML supported)", "default": "<p>Free freight on orders over $5,000. Quotes valid 14 days.</p>" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_color",   "label": "Background color", "default": "#F4EFE8" },
    { "type": "color", "id": "text_color", "label": "Text color",       "default": "#344054" },
    { "type": "color", "id": "link_color", "label": "Link color",       "default": "#A63D2F" },

    { "type": "header", "content": "Spacing + size" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "font_size",      "label": "Font size",      "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 }
  ],
  "presets": [
    {
      "name": "PM — Banner Strip",
      "settings": {
        "text": "<p>Free freight on orders over $5,000. Quotes valid 14 days.</p>"
      }
    }
  ]
}
{% endschema %}
