{%- comment -%}
  PM — Customer Register
  Centered card layout, business registration form.
  Styling lives in .pm-auth-* classes in pm-auth-misc.css.
  Inline onfocus/onblur on selects removed — replaced by :focus CSS.

  NOTE: /account/login is hardcoded ON PURPOSE — pm-plp.js intercepts clicks on
  exactly `a[href="/account/login"]` to redirect to the New-Customer-Accounts hosted
  flow. A route object would change the href and break that, so HardcodedRoutes is off here.
{%- endcomment -%}
{% # theme-check-disable HardcodedRoutes %}

<div class="pm-auth pm-auth--wide">
  <div class="pm-auth__inner pm-auth__inner--wide">

    <header class="pm-auth__head pm-auth__head--lg">
      <div class="pm-auth__eyebrow">Create account</div>
      <h1 class="pm-auth__title pm-auth__title--lg">Open a business account.</h1>
      <p class="pm-auth__lead pm-auth__lead--lg">For system integrators, IT teams, education, healthcare, and public-sector buyers. Trade credit available with approved application.</p>
    </header>

    <div class="pm-auth__card pm-auth__card--lg">

      {%- form 'create_customer' -%}

        {%- if form.errors -%}
          <div class="pm-auth__alert pm-auth__alert--error" role="alert">
            <svg class="pm-auth__alert-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div>
              <div class="pm-auth__alert-title">Please fix the following:</div>
              {%- for error in form.errors -%}
                <div class="pm-auth__alert-msg">{{ form.errors.messages[error] }}</div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} ── Account credentials ───────────────────────── {%- endcomment -%}
        <div class="pm-auth__section">
          <div class="pm-auth__section-head">Account credentials</div>
          <div class="pm-reg-grid">
            {%- render 'pm-form-field',
                label:        'Email address',
                name:         'customer[email]',
                type:         'email',
                required:     true,
                placeholder:  'you@company.com',
                autocomplete: 'email',
                error:        form.errors.messages['email']
            -%}
            {%- render 'pm-form-field',
                label:        'Phone number',
                name:         'customer[phone]',
                type:         'tel',
                placeholder:  '+1 (555) 000-0000',
                autocomplete: 'tel',
                error:        form.errors.messages['phone']
            -%}
            {%- render 'pm-form-field',
                label:        'Password',
                name:         'customer[password]',
                type:         'password',
                required:     true,
                placeholder:  'Min. 8 characters',
                autocomplete: 'new-password',
                hint:         'At least 8 characters',
                error:        form.errors.messages['password']
            -%}
            {%- render 'pm-form-field',
                label:        'Confirm password',
                name:         'customer[password_confirmation]',
                type:         'password',
                required:     true,
                placeholder:  '••••••••',
                autocomplete: 'new-password',
                error:        form.errors.messages['password_confirmation']
            -%}
          </div>
        </div>

        {%- comment -%} ── Personal info ─────────────────────────────── {%- endcomment -%}
        <div class="pm-auth__section">
          <div class="pm-auth__section-head">Your information</div>
          <div class="pm-reg-grid">
            {%- render 'pm-form-field',
                label:        'First name',
                name:         'customer[first_name]',
                type:         'text',
                required:     true,
                placeholder:  'Jane',
                autocomplete: 'given-name',
                error:        form.errors.messages['first_name']
            -%}
            {%- render 'pm-form-field',
                label:        'Last name',
                name:         'customer[last_name]',
                type:         'text',
                required:     true,
                placeholder:  'Smith',
                autocomplete: 'family-name',
                error:        form.errors.messages['last_name']
            -%}
          </div>
        </div>

        {%- comment -%} ── Business details (packed into note) ───────── {%- endcomment -%}
        <div class="pm-auth__section">
          <div class="pm-auth__section-head">Business details</div>
          <div class="pm-auth__stack">
            {%- render 'pm-form-field',
                label:        'Company / Organization',
                name:         'customer[note][company]',
                type:         'text',
                required:     true,
                placeholder:  'Acme Corp',
                autocomplete: 'organization'
            -%}
            {%- render 'pm-form-field',
                label:        'Job title',
                name:         'customer[note][job_title]',
                type:         'text',
                placeholder:  'IT Director'
            -%}
          </div>
        </div>

        {%- comment -%} ── Billing address ───────────────────────────── {%- endcomment -%}
        <div class="pm-auth__section">
          <div class="pm-auth__section-head">Billing address</div>
          <div class="pm-auth__stack">
            {%- render 'pm-form-field',
                label:        'Address line 1',
                name:         'customer[note][address1]',
                type:         'text',
                placeholder:  '123 Main St',
                autocomplete: 'address-line1'
            -%}
            {%- render 'pm-form-field',
                label:        'Address line 2',
                name:         'customer[note][address2]',
                type:         'text',
                placeholder:  'Suite 400',
                autocomplete: 'address-line2'
            -%}
            <div class="pm-reg-grid">
              {%- render 'pm-form-field',
                  label:        'City',
                  name:         'customer[note][city]',
                  type:         'text',
                  placeholder:  'Los Angeles',
                  autocomplete: 'address-level2'
              -%}
              {%- render 'pm-form-field',
                  label:        'ZIP / Postal code',
                  name:         'customer[note][zip]',
                  type:         'text',
                  placeholder:  '90001',
                  autocomplete: 'postal-code'
              -%}
            </div>
            <div class="pm-reg-grid">
              <div class="pm-auth__field-group">
                <label class="pm-auth__field-label" for="pm-reg-country">Country</label>
                <select
                  id="pm-reg-country"
                  name="customer[note][country]"
                  autocomplete="country-name"
                  class="pm-auth__select"
                >
                  <option value="">Select country…</option>
                  <option value="United States" selected>United States</option>
                  <option value="Canada">Canada</option>
                  <option value="United Kingdom">United Kingdom</option>
                  <option value="Australia">Australia</option>
                  <option value="Germany">Germany</option>
                  <option value="France">France</option>
                  <option value="Japan">Japan</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div class="pm-auth__field-group">
                <label class="pm-auth__field-label" for="pm-reg-state">State / Province</label>
                <select
                  id="pm-reg-state"
                  name="customer[note][state]"
                  autocomplete="address-level1"
                  class="pm-auth__select"
                >
                  <option value="">Select state…</option>
                  <option>Alabama</option><option>Alaska</option><option>Arizona</option><option>Arkansas</option>
                  <option>California</option><option>Colorado</option><option>Connecticut</option><option>Delaware</option>
                  <option>Florida</option><option>Georgia</option><option>Hawaii</option><option>Idaho</option>
                  <option>Illinois</option><option>Indiana</option><option>Iowa</option><option>Kansas</option>
                  <option>Kentucky</option><option>Louisiana</option><option>Maine</option><option>Maryland</option>
                  <option>Massachusetts</option><option>Michigan</option><option>Minnesota</option><option>Mississippi</option>
                  <option>Missouri</option><option>Montana</option><option>Nebraska</option><option>Nevada</option>
                  <option>New Hampshire</option><option>New Jersey</option><option>New Mexico</option><option>New York</option>
                  <option>North Carolina</option><option>North Dakota</option><option>Ohio</option><option>Oklahoma</option>
                  <option>Oregon</option><option>Pennsylvania</option><option>Rhode Island</option><option>South Carolina</option>
                  <option>South Dakota</option><option>Tennessee</option><option>Texas</option><option>Utah</option>
                  <option>Vermont</option><option>Virginia</option><option>Washington</option><option>West Virginia</option>
                  <option>Wisconsin</option><option>Wyoming</option>
                  <option>District of Columbia</option>
                </select>
              </div>
            </div>
          </div>
        </div>

        {%- comment -%} ── Consent checkboxes ────────────────────────── {%- endcomment -%}
        <div class="pm-auth__checks">
          <label class="pm-auth__check-row">
            <input
              type="checkbox"
              name="customer[accepts_marketing]"
              value="1"
              class="pm-auth__check"
            >
            <span class="pm-auth__check-text">
              Send me occasional product announcements, clearance alerts, and industry news.
            </span>
          </label>
          <label class="pm-auth__check-row">
            <input
              type="checkbox"
              name="customer[note][terms_accepted]"
              value="1"
              required
              class="pm-auth__check"
            >
            <span class="pm-auth__check-text">
              I agree to the <a href="/policies/terms-of-service" class="pm-auth__inline-link" target="_blank">Terms of Service</a> and <a href="/policies/privacy-policy" class="pm-auth__inline-link" target="_blank">Privacy Policy</a>. <span class="pm-auth__req">*</span>
            </span>
          </label>
        </div>

        <button type="submit" class="pm-auth__submit pm-auth__submit--terracotta">
          Create business account
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>

        <p class="pm-auth__small">
          After submitting, you'll receive an email to set your final password via Shopify's secure portal.
        </p>

      {%- endform -%}

      <div class="pm-auth__footer-block">
        <span class="pm-auth__footer-text pm-auth__footer-text--lg">Already have an account?</span>
        <a href="/account/login" class="pm-auth__sign-in-link pm-auth__sign-in-link--lg">Sign in →</a>
      </div>

    </div>
  </div>
</div>

<style>
.pm-reg-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
@media (min-width: 540px) {
  .pm-reg-grid {
    grid-template-columns: 1fr 1fr;
  }
}
</style>

{% schema %}
{
  "name": "PM — Customer Register",
  "settings": []
}
{% endschema %}
