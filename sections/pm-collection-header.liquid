<div style="background:var(--pm-navy-deep);color:white;padding:32px 0;">
  <div class="pm-container">
    <h1 style="font-size:28px;font-weight:700;line-height:1.2;color:white;">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p style="margin-top:8px;font-size:15px;color:rgba(255,255,255,0.75);max-width:600px;">{{ collection.description | strip_html | truncatewords: 30 }}</p>
    {%- endif -%}
    <div style="margin-top:8px;font-size:13px;color:rgba(255,255,255,0.5);">{{ collection.products_count }} products</div>
  </div>
</div>

{% schema %}
{
  "name": "PM — Collection Header",
  "settings": []
}
{% endschema %}
