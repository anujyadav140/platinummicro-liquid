<section
  class="pm-about-banner"
  style="{%- if section.settings.bg_color != blank %}background-color:{{ section.settings.bg_color }};{% endif -%}"
>
  <div class="pm-about-banner__inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="pm-about-banner__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <p class="pm-about-banner__body">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PM — About Banner",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "About Platinum Micro"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "For two decades, Platinum Micro has distributed enterprise IT from Southern California to system integrators, public-sector buyers, and healthcare networks worldwide. Forty-plus manufacturer partnerships, real lead times, named account managers — sourced direct, with trade credit available on approved application."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#071525"
    }
  ],
  "presets": [
    {
      "name": "PM — About Banner",
      "settings": {
        "eyebrow": "About Platinum Micro",
        "body": "For two decades, Platinum Micro has distributed enterprise IT from Southern California to system integrators, public-sector buyers, and healthcare networks worldwide. Forty-plus manufacturer partnerships, real lead times, named account managers — sourced direct, with trade credit available on approved application."
      }
    }
  ]
}
{% endschema %}
