{%- comment -%}
  PM — Generic page template.
  Used for any /pages/<handle> URL. The content comes from the Shopify
  admin (Pages → Add page). The merchant only needs to create the page —
  this template handles the layout.
{%- endcomment -%}

<section class="pm-page">
  <div class="pm-page__inner">
    <header class="pm-page__head">
      <div class="pm-page__eyebrow">Platinum Micro</div>
      <h1 class="pm-page__title">{{ page.title }}</h1>
    </header>

    <article class="pm-page__content rte">
      {{ page.content }}
    </article>
  </div>
</section>

<style>
  .pm-page { background: var(--pm-paper); padding: 56px 16px 80px; min-height: 50vh; }
  .pm-page__inner { max-width: 820px; margin: 0 auto; }
  .pm-page__head { margin-bottom: 28px; }
  .pm-page__eyebrow {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pm-tan);
    margin-bottom: 10px;
  }
  .pm-page__title {
    margin: 0;
    font-size: 32px;
    font-weight: 800;
    color: var(--pm-ink-900);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  @media (min-width: 640px) { .pm-page__title { font-size: 40px; } }
  .pm-page__content {
    background: #fff;
    border: 1px solid var(--pm-ink-200);
    border-radius: 12px;
    padding: 36px 32px;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--pm-ink-700);
    box-shadow: 0 1px 2px rgba(7, 21, 37, 0.04);
  }
  .pm-page__content h2,
  .pm-page__content h3 {
    color: var(--pm-ink-900);
    margin: 28px 0 12px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .pm-page__content h2 { font-size: 22px; }
  .pm-page__content h3 { font-size: 18px; }
  .pm-page__content p { margin: 0 0 14px; }
  .pm-page__content a {
    color: var(--pm-terracotta);
    border-bottom: 1px solid currentColor;
  }
  .pm-page__content ul, .pm-page__content ol {
    margin: 0 0 16px 22px;
    padding: 0;
  }
  .pm-page__content li { margin-bottom: 6px; list-style: disc; }
  .pm-page__content ol li { list-style: decimal; }
  .pm-page__content img { border-radius: 8px; margin: 16px 0; }
  .pm-page__content table {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0;
  }
  .pm-page__content table th,
  .pm-page__content table td {
    border: 1px solid var(--pm-ink-200);
    padding: 10px 12px;
    text-align: left;
    font-size: 14px;
  }
  .pm-page__content table th { background: var(--pm-ink-100); font-weight: 600; color: var(--pm-ink-900); }
</style>

{% schema %}
{
  "name": "PM — Page",
  "settings": []
}
{% endschema %}
