{%- comment -%}
  PM — Hero Banner
  Full design layer driven by CSS custom properties on the section root.
  Existing instances get sane fallbacks so nothing visually changes
  until an admin touches a setting.
{%- endcomment -%}

{%- comment -%}
  Default hero image (Hydrogen reference). Used when no admin upload.
{%- endcomment -%}
{%- assign _default_hero_url = 'https://cdn.shopify.com/s/files/1/0715/8841/3523/files/179ff61d-240c-4db2-92fa-1da73152b6a0.jpg?v=1779228048' -%}

{%- assign _hero_bg_url = '' -%}
{%- if section.settings.background_image != blank -%}
  {%- assign _hero_bg_url = section.settings.background_image | image_url: width: 2400 -%}
{%- else -%}
  {%- assign _hero_bg_url = _default_hero_url -%}
{%- endif -%}

{%- assign _overlay_pct = section.settings.overlay_opacity | default: 100 -%}
{%- assign _overlay_alpha = _overlay_pct | divided_by: 100.0 -%}

{%- comment -%}
  Preload the LCP background image so the browser discovers it early.
  The CSS background below uses this exact URL, which is always set
  (admin upload or default), so it's safe to emit unconditionally here.
{%- endcomment -%}
{%- if _hero_bg_url != blank -%}
  <link rel="preload" as="image" fetchpriority="high" href="{{ _hero_bg_url }}">
{%- endif -%}

<section
  class="pm-hero pm-hero--cover pm-hero--align-{{ section.settings.content_align | default: 'left' }}"
  style="
    {%- if section.settings.bg_color != blank %}--hb-bg:{{ section.settings.bg_color }};{% endif -%}
    {%- if section.settings.padding_top != blank %}--hb-pt:{{ section.settings.padding_top }}px;{% endif -%}
    {%- if section.settings.padding_bottom != blank %}--hb-pb:{{ section.settings.padding_bottom }}px;{% endif -%}
    {%- if section.settings.height_px != blank %}--hb-min-h:{{ section.settings.height_px }}px;{% endif -%}
    {%- if section.settings.height_px_mobile != blank %}--hb-min-h-m:{{ section.settings.height_px_mobile }}px;{% endif -%}
    {%- if section.settings.eyebrow_color != blank %}--hb-eyebrow:{{ section.settings.eyebrow_color }};{% endif -%}
    {%- if section.settings.headline_color != blank %}--hb-headline:{{ section.settings.headline_color }};{% endif -%}
    {%- if section.settings.body_color != blank %}--hb-body:{{ section.settings.body_color }};{% endif -%}
    {%- if section.settings.eyebrow_size != blank %}--hb-eyebrow-size:{{ section.settings.eyebrow_size }}px;{% endif -%}
    {%- if section.settings.headline_size_desktop != blank %}--hb-headline-size:{{ section.settings.headline_size_desktop }}px;{% endif -%}
    {%- if section.settings.headline_size_tablet != blank %}--hb-headline-size-t:{{ section.settings.headline_size_tablet }}px;{% endif -%}
    {%- if section.settings.headline_size_mobile != blank %}--hb-headline-size-m:{{ section.settings.headline_size_mobile }}px;{% endif -%}
    {%- if section.settings.body_size != blank %}--hb-body-size:{{ section.settings.body_size }}px;{% endif -%}
    {%- if section.settings.content_max_width != blank %}--hb-content-max:{{ section.settings.content_max_width }}px;{% endif -%}
    {%- if section.settings.accent_color != blank %}--hb-cta-bg:{{ section.settings.accent_color }};{% endif -%}
    {%- if section.settings.cta_text_color != blank %}--hb-cta-text:{{ section.settings.cta_text_color }};{% endif -%}
    {%- if section.settings.overlay_color != blank %}--hb-overlay-color:{{ section.settings.overlay_color }};{% endif -%}
    --hb-overlay-alpha:{{ _overlay_alpha }};
  "
>
  <div
    class="pm-hero__bg"
    style="background-image:url('{{ _hero_bg_url }}');background-position:{{ section.settings.bg_position | default: 'center' }};"
    aria-hidden="true"
  ></div>

  {%- if section.settings.show_overlay -%}
    <div class="pm-hero__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="pm-hero__body">
    {%- if section.settings.eyebrow != blank -%}
      <div class="pm-hero__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}

    {%- if section.settings.headline != blank -%}
      <h1 class="pm-hero__headline">{{ section.settings.headline }}</h1>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="pm-hero__body-text">{{ section.settings.body }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_href != blank -%}
      <a class="pm-hero__cta" href="{{ section.settings.cta_href }}">
        {{ section.settings.cta_label }}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PM — Hero Banner",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text",     "id": "eyebrow",   "label": "Eyebrow",       "default": "PLATINUM MICRO" },
    { "type": "text",     "id": "headline",  "label": "Headline",      "default": "Go with Platinum Micro for a Platinum Experience." },
    { "type": "textarea", "id": "body",      "label": "Body text",     "default": "Two decades of servers, storage, and networking for system integrators and public sector buyers." },
    { "type": "text",     "id": "cta_label", "label": "CTA label",     "default": "Browse Catalog" },
    { "type": "url",      "id": "cta_href",  "label": "CTA link",      "default": "/collections/all" },

    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "background_image", "label": "Background image" },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Image focus point",
      "options": [
        { "value": "center",       "label": "Center" },
        { "value": "top",          "label": "Top" },
        { "value": "bottom",       "label": "Bottom" },
        { "value": "left center",  "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "color", "id": "bg_color", "label": "Fallback background color", "default": "#0D2340" },

    { "type": "header", "content": "Overlay" },
    { "type": "checkbox", "id": "show_overlay",    "label": "Show gradient overlay", "default": true },
    { "type": "color",    "id": "overlay_color",   "label": "Overlay color",          "default": "#071525" },
    { "type": "range",    "id": "overlay_opacity", "label": "Overlay strength %",    "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top",    "label": "Padding top",    "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },

    { "type": "header", "content": "Size" },
    { "type": "range", "id": "height_px",        "label": "Banner height (desktop)", "min": 280, "max": 800, "step": 20, "unit": "px", "default": 480 },
    { "type": "range", "id": "height_px_mobile", "label": "Banner height (mobile)",  "min": 240, "max": 600, "step": 20, "unit": "px", "default": 420 },
    { "type": "range", "id": "content_max_width","label": "Content max width",       "min": 320, "max": 1200, "step": 20, "unit": "px", "default": 680 },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Typography" },
    { "type": "color", "id": "eyebrow_color",  "label": "Eyebrow color",  "default": "#C04E3E" },
    { "type": "color", "id": "headline_color", "label": "Headline color", "default": "#FFFFFF" },
    { "type": "color", "id": "body_color",     "label": "Body color",     "default": "#D2D7DE" },
    { "type": "range", "id": "eyebrow_size",          "label": "Eyebrow size",          "min": 9, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "headline_size_desktop", "label": "Headline size (desktop)", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "headline_size_tablet",  "label": "Headline size (tablet)",  "min": 24, "max": 56, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "headline_size_mobile",  "label": "Headline size (mobile)",  "min": 20, "max": 44, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "body_size",             "label": "Body size",             "min": 12, "max": 24, "step": 1, "unit": "px", "default": 17 },

    { "type": "header", "content": "CTA button" },
    { "type": "color", "id": "accent_color",   "label": "Button color",      "default": "#A63D2F" },
    { "type": "color", "id": "cta_text_color", "label": "Button text color", "default": "#FFFFFF" }
  ],
  "presets": [
    {
      "name": "PM — Hero Banner",
      "settings": {
        "eyebrow":   "PLATINUM MICRO",
        "headline":  "Go with Platinum Micro for a Platinum Experience.",
        "body":      "Two decades of servers, storage, and networking for system integrators and public sector buyers.",
        "cta_label": "Browse Catalog",
        "cta_href":  "/collections/all",
        "height_px": 480
      }
    }
  ]
}
{% endschema %}
