<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_brand_primary | default: '#0D2340' }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- endif -%}

  <title>
    {%- comment -%}
      On the homepage Shopify defaults page_title to the bare shop name when no
      admin SEO title is set. Swap that default for a descriptive title; an
      admin-set page_title (anything other than the bare shop name) is honored.
    {%- endcomment -%}
    {%- if request.page_type == 'index' and page_title == shop.name -%}
      {{ shop.name }} &mdash; Enterprise IT Distributor | Servers, Storage &amp; Networking
    {%- else -%}
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    {%- endif -%}
  </title>

  {%- comment -%}
    Meta description. page_description is only filled from a saved SEO field, so
    home / collection / search / content pages emit nothing. Fall back to the
    collection description on collections and a shop-level default on
    index/content; search pages get none. Only output when non-blank.
  {%- endcomment -%}
  {%- assign pm_meta_description = page_description -%}
  {%- if pm_meta_description == blank -%}
    {%- if request.page_type == 'collection' -%}
      {%- if collection.description != blank -%}
        {%- assign pm_meta_description = collection.description | strip_html | truncate: 160 -%}
      {%- else -%}
        {%- assign pm_meta_description = 'Shop ' | append: collection.title | append: ' at ' | append: shop.name | append: ' — volume pricing and fast quotes for business and public-sector buyers.' -%}
      {%- endif -%}
    {%- elsif request.page_type == 'index' or request.page_type == 'page' -%}
      {%- assign pm_meta_description = shop.name | append: ' is your enterprise IT distributor for servers, storage, networking, and components from leading brands. Volume pricing and quotes for business and public-sector buyers.' -%}
    {%- endif -%}
  {%- endif -%}
  {%- if pm_meta_description != blank %}
    <meta name="description" content="{{ pm_meta_description | escape }}">
  {%- endif -%}

  {%- comment -%} Internal search result pages are thin/duplicate — keep them out of the index. {%- endcomment -%}
  {%- if request.page_type == 'search' -%}
    <meta name="robots" content="noindex,follow">
  {%- endif -%}

  {%- comment -%} Identify signed-in customers to Tidio (skip the pre-chat form). Must precede the app embed. {%- endcomment -%}
  {%- render 'pm-tidio-identify' -%}

  {{ content_for_header }}

  {%- comment -%} SEO: canonical, Open Graph, Twitter, JSON-LD structured data {%- endcomment -%}
  {%- render 'pm-meta-tags' -%}

  {%- comment -%} Shopify front-end routes exposed to our JS (predictive search, etc.) {%- endcomment -%}
  <script>
    window.routes = window.routes || {};
    window.routes.predictive_search_url = {{ routes.predictive_search_url | json }};
    window.routes.search_url = {{ routes.search_url | json }};
  </script>

  {%- comment -%}
    PM theme CSS layer. Split by domain so teams can own a slice without
    touching a 6k-line monolith. ORDER MATTERS — it mirrors the original
    single-file cascade, so keep tokens → base first and don't reshuffle.
    See README → "CSS architecture".
  {%- endcomment -%}
  {{ 'pm-tokens.css'        | asset_url | stylesheet_tag }}
  {{ 'pm-base.css'          | asset_url | stylesheet_tag }}
  {{ 'pm-header.css'        | asset_url | stylesheet_tag }}
  {{ 'pm-home-sections.css' | asset_url | stylesheet_tag }}
  {{ 'pm-footer.css'        | asset_url | stylesheet_tag }}
  {{ 'pm-overlays.css'      | asset_url | stylesheet_tag }}
  {{ 'pm-collection.css'    | asset_url | stylesheet_tag }}
  {{ 'pm-account.css'       | asset_url | stylesheet_tag }}
  {%- if template.name == 'product' -%}{{ 'pm-product.css' | asset_url | stylesheet_tag }}{%- endif -%}
  {{ 'pm-compare.css'       | asset_url | stylesheet_tag }}
  {{ 'pm-lists.css'         | asset_url | stylesheet_tag }}
  {{ 'pm-auth-misc.css'     | asset_url | stylesheet_tag }}
  {%- if template.name == 'blog' or template.name == 'article' -%}{{ 'pm-blog.css' | asset_url | stylesheet_tag }}{%- endif -%}

  {%- comment -%}
    Collection 404 → search redirect. Runs in <head> BEFORE the body
    paints, so when someone clicks a mega-menu link that goes to a
    collection the merchant hasn't created yet, we silently rewrite to a
    targeted product-only search — no flash of 404 content.
  {%- endcomment -%}
  {%- if template.name == '404' -%}
    <script>
      (function () {
        var p = window.location.pathname || '';
        // /collections/<missing> → product search with the handle as a tag.
        var mc = p.match(/^\/collections\/([^\/?#]+)/i);
        if (mc) {
          var h = mc[1];
          if (h && h !== 'all') {
            var terms = h.replace(/-/g, ' ').trim();
            if (terms) {
              document.documentElement.dataset.pmRedirecting = '1';
              var tagValue = terms.toUpperCase();
              var qs = 'q=' + encodeURIComponent('tag:"' + tagValue + '"') + '&type=product';
              window.location.replace('/search?' + qs);
              return;
            }
          }
        }
        // /pages/sign-in and /pages/register were standalone pages in
        // earlier iterations — now retired in favour of redirecting
        // directly to Shopify's hosted auth (Hachiman-pattern).
        if (/^\/pages\/(sign-in|register)(?:[\/?#]|$)/i.test(p)) {
          document.documentElement.dataset.pmRedirecting = '1';
          window.location.replace('/customer_authentication/login?return_to=%2F');
          return;
        }
        // /pages/<known> → pm-404.liquid renders the static body inside a
        // hidden pool (the 404 page is globally cached, so request.path can't be
        // trusted server-side; we resolve the handle client-side). Reveal the
        // matching body via CSS injected RIGHT NOW — in <head>, before the body
        // paints — so neither the "404" placeholder nor a blank gap flashes
        // (TC-083). The body-end script then promotes it + fixes the <title>.
        var spm = p.match(/^\/pages\/(about|brands|contact|shipping-returns|site-map|social-responsibility|order-verification|compare|account)(?:[\/?#]|$)/i);
        if (spm) {
          document.documentElement.dataset.pmStaticPending = '1';
          var sh = spm[1].toLowerCase();
          var st = document.createElement('style');
          st.textContent = '#pm-404-default{display:none!important}'
            + '#pm-static-pool{display:block!important}'
            + '#pm-static-pool>[data-handle]{display:none!important}'
            + '#pm-static-pool>[data-handle="' + sh + '"]{display:block!important}';
          (document.head || document.documentElement).appendChild(st);
        }
      })();
    </script>
    <style>
      html[data-pm-redirecting] body { visibility: hidden; }
      html[data-pm-static-pending] #pm-404-default { display: none !important; }
    </style>
  {%- endif -%}

  {%- if template.name == 'collection' -%}
    {%- comment -%}
      TC-088 PERF: kick off the two grid-only availability fetches from the <head> — the
      earliest possible point — so the in-stock-first data is ready by the time the grid
      paints. The inline fast-path after the grid (pm-collection.liquid) re-orders the instant
      this lands, before the deferred pm-pagesize.js runs.
      SECURITY: these are same-origin GET requests to the store's own collection URLs (the
      grid-only `view=grid` render). The response is parsed with DOMParser (which does NOT
      execute scripts) and only product-card <li> nodes are cloned into the page — no eval, no
      innerHTML of untrusted text, no user data sent anywhere, no cross-origin requests.
    {%- endcomment -%}
    <script>
      (function () {
        try {
          var loc = window.location;
          var sp = new URLSearchParams(loc.search).getAll('filter.v.availability');
          var split = sp.length === 0 || (sp.indexOf('1') !== -1 && sp.indexOf('0') !== -1);
          if (!split) return;
          var bu = new URL(loc.href); bu.searchParams.delete('page');
          var bq = bu.searchParams.toString();
          var base = bu.pathname + (bq ? '?' + bq : '');
          var gv = function (v) {
            var u = new URL(loc.href);
            u.searchParams.delete('page');
            u.searchParams.delete('filter.v.availability');
            u.searchParams.append('filter.v.availability', v);
            u.searchParams.set('view', 'grid');
            u.searchParams.set('page', '1');
            return u.pathname + '?' + u.searchParams.toString();
          };
          // priority:high → the browser fetches these ahead of the page's images/below-fold
          // resources, so the in-stock-first data lands before DOMContentLoaded (lets the
          // fast-path re-order early instead of deferring to pm-pagesize.js). Ignored by
          // browsers that don't support Fetch Priority — harmless.
          var opt = { headers: { 'X-Requested-With': 'XMLHttpRequest' }, priority: 'high' };
          window.__pmStitch = {
            base: base,
            in1: fetch(gv('1'), opt).then(function (r) { return r.ok ? r.text() : null; }).catch(function () { return null; }),
            out1: fetch(gv('0'), opt).then(function (r) { return r.ok ? r.text() : null; }).catch(function () { return null; })
          };
        } catch (e) {}
      })();
    </script>
  {%- endif -%}

  {%- if template.name == 'search' -%}
    {%- comment -%}
      Brand navigation → real brand collection (SEO). An EXACT brand-name search
      (typed "Intel", or the q=tag:"INTEL" form emitted by brand logos / cached
      headers / the 404 net / banner CTAs) resolves to /collections/<brand>
      instead of a /search?q=… URL. Only exact, whole-string brand matches are
      mapped — multi-word queries like "intel cooler" stay as normal search —
      and only brands whose collection actually exists, so there's no
      /collections ⇄ /search redirect loop.
    {%- endcomment -%}
    <script>
      (function () {
        try {
          var q = (new URLSearchParams(window.location.search).get('q') || '').trim().toLowerCase();
          var map = {
            'intel': '/collections/intel',                 'tag:"intel"': '/collections/intel',
            'amd': '/collections/amd',                     'tag:"amd"': '/collections/amd',
            'samsung': '/collections/samsung',             'tag:"samsung"': '/collections/samsung',
            'seagate': '/collections/seagate',             'tag:"seagate"': '/collections/seagate',
            'wd': '/collections/wd', 'western digital': '/collections/wd', 'tag:"wd"': '/collections/wd',
            'hpe': '/collections/hewlett-packard-enterprise',
            'hewlett packard enterprise': '/collections/hewlett-packard-enterprise',
            'tag:"hewlett packard enterprise"': '/collections/hewlett-packard-enterprise'
          };
          if (map[q]) { document.documentElement.dataset.pmRedirecting = '1'; window.location.replace(map[q]); }
        } catch (e) {}
      })();
    </script>
    <style>html[data-pm-redirecting] body { visibility: hidden; }</style>
  {%- endif -%}
</head>

{%- comment -%}
  Unread-message signifier source of truth. Count the customer's THREAD entries
  authored by the team (from != 'You') — the same custom.thread metafield the
  Message Center renders. pm-account-menu.js compares this total to a per-device
  localStorage "read" marker to decide whether to light the account badge.
{%- endcomment -%}
{%- assign _pm_teamcount = 0 -%}
{%- if customer -%}
  {%- assign _pm_thread = customer.metafields.custom.thread.value -%}
  {%- if _pm_thread -%}{%- for _m in _pm_thread -%}{%- unless _m.from == 'You' -%}{%- assign _pm_teamcount = _pm_teamcount | plus: 1 -%}{%- endunless -%}{%- endfor -%}{%- endif -%}
{%- endif -%}
<body class="pm-body" data-pm-customer="{{ customer.id | default: '' }}" data-pm-customer-name="{{ customer.first_name | default: '' | escape }}" data-pm-msg-teamcount="{{ _pm_teamcount }}">

  {%- comment -%}
    Skip-to-main link — first focusable element on every page so keyboard
    users can bypass the header + top-bar + mega-menu chrome on every
    navigation. Visually hidden until focused; CSS in pm-theme.css.
  {%- endcomment -%}
  <a href="#MainContent" class="pm-skip-link">Skip to main content</a>

  {%- comment -%}
    Top bars are a section GROUP so the editor can add / remove / reorder as
    many bars as you want (each PM — Top Bar stacks under the previous one).
    Managed in Customize → "Top bars". Defined in sections/top-bars.json.
  {%- endcomment -%}
  {%- sections 'top-bars' -%}

  {%- section 'pm-header' -%}

  {%- comment -%}
    The signed-in shortcuts strip (PM — Account Strip) is now a normal
    template section so merchants can drag it to any position in the theme
    editor. On the homepage it defaults to just below the hero. Add it to
    other templates via Customize → Add section → "PM — Account Strip".
  {%- endcomment -%}
  <main id="MainContent" class="pm-main" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- section 'pm-footer' -%}

  {%- comment -%} Mobile nav overlay (driven by pm-header.js) {%- endcomment -%}
  <div class="pm-mobile-nav" id="pm-mobile-nav" aria-hidden="true">
    <div class="pm-mobile-nav__backdrop" id="pm-mobile-backdrop"></div>
    <nav class="pm-mobile-nav__panel" role="dialog" aria-modal="true" aria-label="Mobile navigation">
      <div class="pm-mobile-nav__head">
        {%- if settings.logo != blank -%}
          {%- assign _lh = 32 -%}
          {%- assign _lw = _lh | times: settings.logo.width | divided_by: settings.logo.height | default: 120 -%}
          <img src="{{ settings.logo | image_url: width: 160 }}" alt="{{ shop.name }}" width="{{ _lw }}" height="{{ _lh }}" style="height:32px;width:auto;" loading="eager">
        {%- else -%}
          <span style="font-weight:700;font-size:16px;color:var(--pm-ink-900);">{{ shop.name }}</span>
        {%- endif -%}
        <button class="pm-mobile-nav__close" id="pm-mobile-close" aria-label="Close menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="pm-mobile-nav__links">
        {%- comment -%} TC-153: Quick order at the top of the drawer, above the category pages. [data-qo-open] opens the same modal (event-delegated in pm-quick-order.js). {%- endcomment -%}
        <button type="button" class="pm-mobile-nav__link pm-mobile-nav__qo" data-qo-open aria-haspopup="dialog">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          Quick order
        </button>

        {%- for link in linklists.main-menu.links -%}
          {%- assign _mkey = link.title | handleize -%}
          {%- comment -%} Temporarily hidden — remove the next line to restore Blog in the mobile drawer. {%- endcomment -%}
          {%- if _mkey == 'blog' -%}{%- continue -%}{%- endif -%}
          <a class="pm-mobile-nav__link" href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}

        {%- comment -%}
          TC-153: Account as an inline accordion (replaces <shopify-account>,
          whose popup floated awkwardly inside the drawer). New-Customer-Accounts
          sub-routes are built off routes.account_url — same pattern as
          pm-account-strip / pm-static-body. Native <details> = no JS.
        {%- endcomment -%}
        {%- if customer -%}
          {%- assign _parts = routes.account_url | split: '?' -%}
          {%- assign _abase = _parts | first -%}
          {%- assign _aqs = '' -%}
          {%- if _parts.size > 1 -%}{%- assign _aqs = '?' | append: _parts.last -%}{%- endif -%}
          <details class="pm-mobile-acct">
            <summary class="pm-mobile-nav__link pm-mobile-acct__summary">
              <span class="pm-mobile-acct__avatar" aria-hidden="true">{{ customer.first_name | default: 'A' | slice: 0 | upcase }}<span class="pm-amenu__badge" data-msg-badge hidden></span></span>
              <span class="pm-mobile-acct__name">Hi, {{ customer.first_name | default: 'Account' | escape }}</span>
              <svg class="pm-mobile-acct__chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="pm-mobile-acct__panel">
              <a class="pm-mobile-acct__sub" href="{{ _abase }}/profile{{ _aqs }}">Profile</a>
              <a class="pm-mobile-acct__sub" href="{{ _abase }}/orders{{ _aqs }}">Orders</a>
              <a class="pm-mobile-acct__sub" href="/pages/lists">Lists</a>
              <a class="pm-mobile-acct__sub pm-mobile-acct__sub--msg" href="/pages/messages" data-msg-link>Messages <span class="pm-amenu__linkbadge" data-msg-linkbadge hidden></span></a>
              <a class="pm-mobile-acct__sub" href="{{ routes.account_logout_url }}" rel="nofollow">Sign out</a>
            </div>
          </details>
        {%- else -%}
          <a class="pm-mobile-nav__link pm-mobile-nav__account" href="{{ routes.storefront_login_url }}">Sign in</a>
        {%- endif -%}

        {%- comment -%}
          Cart count must match the header badge, which folds local "quote"
          items (localStorage) on top of the Shopify line count. Use the same
          [data-cart-badge] hook so pm-cart-drawer.js keeps every badge live;
          the count sits on the right of the row and hides when the cart is empty.
        {%- endcomment -%}
        <button type="button" class="pm-mobile-nav__link pm-mobile-nav__cart" data-cart-open>
          <span>Cart</span>
          <span class="pm-mobile-nav__cart-count" data-cart-badge data-cart-shopify-lines="{{ cart.items.size }}" {% if cart.items.size == 0 %}hidden{% endif %}>{{ cart.items.size }}</span>
        </button>
      </div>
    </nav>
  </div>

  {%- comment -%} Quick Order modal + cart drawer + compare bar (global) {%- endcomment -%}
  {%- render 'pm-quick-order' -%}
  {%- render 'pm-cart-drawer' -%}
  {%- render 'pm-compare-bar' -%}

  {%- comment -%} Deferred so they don't block the parser (theme-check: ParserBlockingScript) {%- endcomment -%}
  {%- comment -%} Shared focus-trap helper — load first so window.PmFocusTrap exists before any dialog opens {%- endcomment -%}
  <script src="{{ 'pm-focus-trap.js'      | asset_url }}" defer></script>
  <script src="{{ 'pm-header.js'          | asset_url }}" defer></script>
  <script src="{{ 'pm-account-menu.js'    | asset_url }}" defer></script>
  <script src="{{ 'pm-predictive-search.js' | asset_url }}" defer></script>
  <script src="{{ 'pm-quick-order.js'     | asset_url }}" defer></script>
  <script src="{{ 'pm-cart-drawer.js'     | asset_url }}" defer></script>
  {%- comment -%} PLP-only JS — gated to the templates that render a faceted toolbar. pm-plp.js stays global (it also hosts the post-auth welcome toast). {%- endcomment -%}
  {%- if template.name == 'collection' or template.name == 'search' -%}<script src="{{ 'pm-facets.js' | asset_url }}" defer></script>{%- endif -%}
  <script src="{{ 'pm-plp.js'             | asset_url }}" defer></script>
  {%- if template.name == 'collection' -%}<script src="{{ 'pm-pagesize.js' | asset_url }}" defer></script>{%- endif -%}
  <script src="{{ 'pm-add-to-cart.js'     | asset_url }}" defer></script>
  {%- comment -%} Reverts the bundle discount if a customer splits a migrated BC bundle in the cart {%- endcomment -%}
  <script src="{{ 'pm-bundle-guard.js'    | asset_url }}" defer></script>
  <script src="{{ 'pm-add-to-list.js'     | asset_url }}" defer></script>
  <script src="{{ 'pm-quote.js'           | asset_url }}" defer></script>
  <script src="{{ 'pm-recently-viewed.js' | asset_url }}" defer></script>
  {%- if template.name == 'product' -%}<script src="{{ 'pm-pdp-pdf.js' | asset_url }}" defer></script>{%- endif -%}
  {%- if template.name == 'product' -%}<script src="{{ 'pm-recommendations.js' | asset_url }}" defer></script>{%- endif -%}
  {%- comment -%}
    Lists dashboard JS loads on /pages/lists whether admin picked the
    custom `lists` template OR the default `page` template — gating on
    page.handle catches both.
  {%- endcomment -%}
  {%- if template == 'page.lists' or page.handle == 'lists' -%}
    <script src="{{ 'pm-lists-page.js' | asset_url }}" defer></script>
  {%- endif -%}
  <script src="{{ 'pm-compare.js'     | asset_url }}" defer></script>
  <script src="{{ 'pm-auth-anchor.js' | asset_url }}" defer></script>
</body>
</html>
